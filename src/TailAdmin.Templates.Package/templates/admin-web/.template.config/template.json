{
  "$schema": "http://json.schemastore.org/template",
  "author": "Internal",
  "classifications": [ "Web", "Admin", "TailAdmin" ],
  "identity": "TailAdmin.Templates.AdminWeb",
  "name": "TailAdmin 通用后台模板",
  "shortName": "tailadmin-admin",
  "sourceName": "TailAdminHost",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "theme": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "als",
      "replaces": "__THEME__",
      "description": "品牌主题名，需与 RCL 的 brand.json 一致"
    },
    "auth": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "cookie", "description": "生成 Cookie 登录与登出示例" },
        { "choice": "none", "description": "不生成鉴权代码" }
      ],
      "defaultValue": "cookie",
      "description": "鉴权方式"
    },
    "sample": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "是否生成示例列表页"
    },
    "authCookie": {
      "type": "computed",
      "value": "(auth == \"cookie\")"
    },
    "sampleEnabled": {
      "type": "computed",
      "value": "(sample)"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!authCookie)",
          "exclude": [
            "Areas/Admin/Controllers/AccountController.cs",
            "Areas/Admin/Views/Account/**",
            "Infrastructure/TemplateCurrentAdmin.cs"
          ]
        },
        {
          "condition": "(!sampleEnabled)",
          "exclude": [
            "Areas/Admin/Controllers/GoodsController.cs",
            "Areas/Admin/Views/Goods/**"
          ]
        }
      ]
    }
  ]
}
