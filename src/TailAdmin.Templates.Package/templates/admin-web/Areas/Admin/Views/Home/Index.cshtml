<div class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4">
    @await Component.InvokeAsync("StatCard", new { title = "模板版本", value = "v1.0.0", icon = "chart", variant = "primary", hint = "TailAdmin.Templates.Rcl" })
    @await Component.InvokeAsync("StatCard", new { title = "主題", value = "daisyUI", icon = "tag", variant = "success", hint = "明暗雙主題" })
    @await Component.InvokeAsync("StatCard", new { title = "交互", value = "Alpine", icon = "settings", variant = "info", hint = "服務端渲染 + 局部交互" })
    @await Component.InvokeAsync("StatCard", new { title = "佈局", value = "RCL", icon = "dashboard", variant = "warning", hint = "隨包分發，可覆蓋" })
</div>

<div class="ta-card ta-card-pad mt-4">
    <h2 class="text-sm font-semibold">開始使用</h2>
    <ul class="mt-2 space-y-1 text-sm leading-relaxed text-base-content/70">
        <li>· 頁面只需聲明 <code class="rounded bg-base-200 px-1">Layout = "~/Views/Shared/_TailAdminLayout.cshtml"</code></li>
        <li>· 菜單在 <code class="rounded bg-base-200 px-1">appsettings.json</code> 的 <code class="rounded bg-base-200 px-1">AdminUi:Menu</code> 配置，按權限自動過濾</li>
        <li>· 換品牌：修改 RCL 源碼倉庫的 <code class="rounded bg-base-200 px-1">frontend/theme/brand.json</code> 後重建 <code class="rounded bg-base-200 px-1">tailadmin.css</code></li>
        <li>· 組件用法見 RCL 倉庫的 <code class="rounded bg-base-200 px-1">docs/組件使用說明.md</code></li>
    </ul>
</div>
