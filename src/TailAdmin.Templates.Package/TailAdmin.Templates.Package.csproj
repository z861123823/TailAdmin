<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>TailAdmin.Templates</PackageId>
    <Title>TailAdmin 通用后台模板</Title>
    <Description>一条命令生成 TailAdmin 通用后台骨架（RCL + daisyUI 主题 + Alpine 组件）。</Description>
    <Authors>Internal</Authors>
    <TargetFramework>net8.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <EnableDefaultItems>false</EnableDefaultItems>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TemplateSourceRoot Condition="'$(TemplateSourceRoot)' == ''">templates</TemplateSourceRoot>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(TemplateSourceRoot)\**\*" PackagePath="content" />
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
