@model AdminUiOptions
@inject ICurrentAdmin CurrentAdmin
@{
    var displayName = CurrentAdmin.DisplayName ?? CurrentAdmin.UserName ?? "管理員";
    var userName = CurrentAdmin.UserName ?? "admin";
    var initial = string.IsNullOrWhiteSpace(Model.SiteName) ? "TA" : Model.SiteName.Substring(0, 1);
}
<header x-data="{ isApplicationMenuOpen: false }"
        x-on:keydown.window="if (($event.metaKey || $event.ctrlKey) && $event.key.toLowerCase() === 'k') { $event.preventDefault(); $refs.searchInput && $refs.searchInput.focus(); }"
        class="sticky top-0 z-50 flex w-full shrink-0 border-gray-200 bg-white xl:border-b dark:border-gray-800 dark:bg-gray-900">
    <div class="flex grow flex-col items-center justify-between xl:flex-row xl:px-6">
        <div class="flex w-full items-center justify-between gap-2 border-b border-gray-200 px-3 py-3 sm:gap-4 xl:justify-normal xl:border-b-0 xl:px-0 xl:py-4 dark:border-gray-800">
            <button type="button"
                    x-on:click.stop="sidebarToggle = !sidebarToggle"
                    aria-label="切換側邊欄"
                    class="group/button relative inline-flex size-10 shrink-0 items-center justify-center rounded-[10px] border border-gray-300 bg-transparent text-gray-500 shadow-theme-xs transition-all select-none hover:bg-gray-50 hover:text-gray-800 focus-visible:ring-3 focus-visible:ring-gray-300/50 focus-visible:outline-hidden active:translate-y-px lg:size-11 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-gray-700/50 dark:hover:text-white">
                <svg x-show="sidebarToggle && window.innerWidth < 1280" class="size-6" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 6L6 18M6 6l12 12" />
                </svg>
                <svg x-show="!sidebarToggle || window.innerWidth >= 1280" class="size-auto! rtl:-scale-x-100" width="16" height="12" viewBox="0 0 16 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M0.583252 1C0.583252 0.585788 0.919038 0.25 1.33325 0.25H14.6666C15.0808 0.25 15.4166 0.585786 15.4166 1C15.4166 1.41421 15.0808 1.75 14.6666 1.75L1.33325 1.75C0.919038 1.75 0.583252 1.41422 0.583252 1ZM0.583252 11C0.583252 10.5858 0.919038 10.25 1.33325 10.25L14.6666 10.25C15.0808 10.25 15.4166 10.5858 15.4166 11C15.4166 11.4142 15.0808 11.75 14.6666 11.75L1.33325 11.75C0.919038 11.75 0.583252 11.4142 0.583252 11ZM1.33325 5.25C0.919038 5.25 0.583252 5.58579 0.583252 6C0.583252 6.41421 0.919038 6.75 1.33325 6.75L7.99992 6.75C8.41413 6.75 8.74992 6.41421 8.74992 6C8.74992 5.58579 8.41413 5.25 7.99992 5.25L1.33325 5.25Z" fill="currentColor" />
                </svg>
            </button>

            <a href="/" class="flex items-center gap-2 xl:hidden">
                <span class="flex size-8 items-center justify-center rounded-lg bg-brand-500 text-xs font-bold text-white">@initial</span>
                <span class="text-lg font-semibold text-gray-800 dark:text-white/90">@Model.SiteName</span>
            </a>

            <button type="button"
                    x-on:click="isApplicationMenuOpen = !isApplicationMenuOpen"
                    aria-label="切換應用菜單"
                    class="inline-flex size-10 shrink-0 items-center justify-center rounded-[10px] border-none bg-transparent text-gray-700 transition-all select-none hover:bg-gray-50 hover:text-gray-800 focus-visible:ring-3 focus-visible:ring-gray-300/50 focus-visible:outline-hidden xl:hidden dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700/50 dark:hover:text-white">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="1" />
                    <circle cx="19" cy="12" r="1" />
                    <circle cx="5" cy="12" r="1" />
                </svg>
            </button>

            @if (Model.EnableSearch && !string.IsNullOrWhiteSpace(Model.SearchUrl))
            {
                <div class="hidden xl:block">
                    <form method="get" action="@Model.SearchUrl">
                        <div class="xl:w-107.5">
                            <div data-slot="input-group" role="group"
                                 class="group/input-group relative flex h-11 w-full min-w-0 items-center rounded-[10px] border border-gray-200 bg-transparent shadow-theme-xs outline-hidden transition-colors has-[[data-slot=input-group-control]:focus]:border-brand-300 has-[[data-slot=input-group-control]:focus]:ring-3 has-[[data-slot=input-group-control]:focus]:ring-brand-500/20 dark:border-gray-800 dark:bg-white/3 dark:has-[[data-slot=input-group-control]:focus]:border-brand-500/40">
                                <div role="group" data-slot="input-group-addon" data-align="inline-start"
                                     class="flex h-auto cursor-text items-center justify-center gap-2 py-1.5 ps-3.5 text-sm font-medium text-gray-500 select-none dark:text-gray-400">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none" class="size-5 text-gray-500 dark:text-gray-400">
                                        <path d="M14.382 14.383l3.325 3.326m-1.249-8.334a7.082 7.082 0 01-7.083 7.081 7.082 7.082 0 110-14.163 7.082 7.082 0 017.083 7.082z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </div>
                                <input x-ref="searchInput" data-slot="input-group-control" type="search" name="keyword"
                                       placeholder="搜索或輸入命令..."
                                       aria-label="全局搜索"
                                       class="h-full flex-1 rounded-none border-0 bg-transparent px-2 text-sm text-gray-800 shadow-none ring-0 outline-hidden placeholder:text-gray-400 focus:border-transparent focus:ring-0 focus:outline-hidden focus-visible:border-transparent focus-visible:ring-0 dark:text-white/90 dark:placeholder:text-white/30" />
                                <div role="group" data-slot="input-group-addon" data-align="inline-end"
                                     class="flex h-auto items-center justify-center gap-2 py-1.5 pe-3.5 text-sm font-medium text-gray-500 select-none dark:text-gray-400">
                                    <span data-slot="badge" class="inline-flex h-5.5 w-fit shrink-0 items-center justify-center gap-0.5 rounded-lg border border-gray-200 bg-gray-50 px-1.75 py-[4.5px] text-xs font-medium tracking-[-0.2px] whitespace-nowrap text-gray-500 shadow-none select-none dark:border-gray-800 dark:bg-white/3 dark:text-gray-400">
                                        <span>⌘</span><span>K</span>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            }
        </div>

        <div class="w-full items-center justify-between gap-4 px-5 py-4 shadow-theme-md xl:flex xl:justify-end xl:px-0 xl:shadow-none"
             :class="isApplicationMenuOpen ? 'flex' : 'hidden'">
            <div class="flex items-center gap-2 2xsm:gap-3">
                <button type="button"
                        x-on:click.prevent="darkMode = !darkMode"
                        class="relative inline-flex size-11 shrink-0 items-center justify-center rounded-[10px] border border-gray-300 bg-transparent text-gray-700 shadow-theme-xs transition-all select-none hover:bg-gray-50 hover:text-gray-800 focus-visible:ring-3 focus-visible:ring-gray-300/50 focus-visible:outline-hidden active:translate-y-px dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700/50 dark:hover:text-white"
                        aria-label="切換明暗主題">
                    <svg x-cloak x-show="darkMode" class="size-auto!" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5" />
                        <path d="M12 2v2m0 16v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M2 12h2m16 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                    <svg x-cloak x-show="!darkMode" class="size-auto!" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M6.247 6.668a6.668 6.668 0 0011.207 4.885A7.708 7.708 0 118.03 2.129a6.645 6.645 0 00-1.783 4.54z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>

                <div class="relative" x-data="{ open: false }" x-on:click.outside="open = false" x-on:keydown.escape.window="open = false">
                    <button type="button"
                            x-on:click="open = !open"
                            class="relative inline-flex size-11 shrink-0 items-center justify-center rounded-[10px] border border-gray-300 bg-transparent text-gray-700 shadow-theme-xs transition-all select-none hover:bg-gray-50 hover:text-gray-800 focus-visible:ring-3 focus-visible:ring-gray-300/50 focus-visible:outline-hidden active:translate-y-px dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700/50 dark:hover:text-white"
                            aria-label="通知">
                        <partial name="_Icon" model="@("bell")" />
                        <span class="absolute -top-1 -right-1 flex size-4 items-center justify-center rounded-full bg-red-500 text-[10px] font-medium text-white">1</span>
                    </button>
                    <div x-cloak x-show="open" x-transition
                         class="absolute right-0 z-50 mt-3 w-72 rounded-2xl border border-gray-200 bg-white p-4 shadow-theme-lg dark:border-gray-800 dark:bg-[#1E2635]">
                        <p class="text-sm font-semibold text-gray-800 dark:text-white/90">通知</p>
                        <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">暫無新的系統通知。</p>
                    </div>
                </div>
            </div>

            <div class="relative" x-data="{ open: false }" x-on:click.outside="open = false" x-on:keydown.escape.window="open = false">
                <button type="button" x-on:click="open = !open"
                        class="dropdown-toggle flex items-center text-gray-700 dark:text-gray-400"
                        aria-label="用戶菜單">
                    <span class="me-3 flex size-11 overflow-hidden rounded-lg bg-gray-100 dark:bg-white/5">
                        <img src="~/_content/TailAdmin.Templates.Rcl/images/user/owner.png" alt="User" class="size-11 object-cover" />
                    </span>
                    <span class="me-1 hidden text-sm font-medium sm:block">@displayName</span>
                    <svg class="size-5 text-gray-500 transition-transform duration-200 dark:text-gray-400"
                         :class="open ? 'rotate-180' : 'rotate-0'"
                         width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M4.792 7.396L10 12.604l5.208-5.208" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>

                <div x-cloak x-show="open" x-transition
                     class="absolute right-0 z-50 mt-3 flex w-65 flex-col gap-1 rounded-2xl border border-gray-200 bg-white p-3 shadow-theme-lg dark:border-gray-800 dark:bg-[#1E2635]">
                    <div class="px-3 py-2">
                        <span class="block text-sm font-medium text-gray-700 dark:text-gray-400">@displayName</span>
                        <span class="mt-0.5 block text-xs text-gray-500 dark:text-gray-400">@userName</span>
                    </div>

                    <div class="-mx-3 my-1.5 h-px bg-gray-100 dark:bg-gray-700"></div>

                    @if (CurrentAdmin.IsAuthenticated)
                    {
                        <form method="post" action="@Model.LogoutPath">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="group/dropdown-menu-item relative flex w-full cursor-pointer items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-red-500 outline-hidden transition-colors duration-200 select-none hover:bg-red-50 hover:text-red-600 dark:text-red-400 dark:hover:bg-red-500/10 dark:hover:text-red-400">
                                <partial name="_Icon" model="@("logout")" />
                                <span>退出登錄</span>
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</header>
