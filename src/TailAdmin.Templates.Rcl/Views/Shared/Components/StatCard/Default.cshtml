@model StatCardViewModel
@{
    var iconClass = Model.Variant switch
    {
        "success" => "bg-success/10 text-success",
        "warning" => "bg-warning/10 text-warning",
        "info" => "bg-info/10 text-info",
        _ => "bg-primary/10 text-primary"
    };
}
<div class="ta-card ta-card-pad flex items-start justify-between gap-3">
    <div class="min-w-0">
        <p class="text-sm text-base-content/60">@Model.Title</p>
        <p class="mt-1 truncate text-2xl font-semibold tracking-tight">@Model.Value</p>
        @if (!string.IsNullOrWhiteSpace(Model.Hint))
        {
            <p class="mt-1 text-xs text-base-content/50">@Model.Hint</p>
        }
    </div>
    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-btn @iconClass">
        <partial name="_Icon" model="@Model.Icon" />
    </span>
</div>
