@model StatCardViewModel
@{
    var iconClass = Model.Variant switch
    {
        "success" => "bg-green-50 text-green-600 dark:bg-green-500/15 dark:text-green-500",
        "warning" => "bg-amber-50 text-amber-600 dark:bg-amber-500/15 dark:text-amber-500",
        "info" => "bg-blue-50 text-blue-600 dark:bg-blue-500/15 dark:text-blue-500",
        _ => "bg-brand-50 text-brand-500 dark:bg-brand-500/15 dark:text-brand-400"
    };
}
<div class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
    <span class="flex size-12 items-center justify-center rounded-xl @iconClass">
        <partial name="_Icon" model="@Model.Icon" />
    </span>
    <p class="mt-5 mb-2 text-theme-sm text-gray-500 dark:text-gray-400">@Model.Title</p>
    <h4 class="text-title-sm font-bold text-gray-800 dark:text-white/90">@Model.Value</h4>
    @if (!string.IsNullOrWhiteSpace(Model.Hint))
    {
        <p class="mt-2 text-theme-xs text-gray-500 dark:text-gray-400">@Model.Hint</p>
    }
</div>
