@model AdminUiOptions
@{
    var initial = string.IsNullOrWhiteSpace(Model.SiteName) ? "TA" : Model.SiteName.Substring(0, 1);
    var firstMenu = Model.Menu.Items.FirstOrDefault();
    var homeUrl = firstMenu?.Url;
    if (string.IsNullOrWhiteSpace(homeUrl) && firstMenu is not null)
    {
        homeUrl = Url.Action(firstMenu.Action ?? "Index", firstMenu.Controller, new { area = firstMenu.Area });
    }
    homeUrl = string.IsNullOrWhiteSpace(homeUrl) ? "/" : homeUrl;
}
<a class="sr-only" href="#main-content">跳到主要内容</a>

<div x-cloak x-show="sidebarToggle"
     class="fixed inset-0 z-99 bg-gray-900/50 backdrop-blur-xs xl:hidden"
     aria-hidden="true"
     x-on:click="sidebarToggle = false"
     x-transition.opacity></div>

<aside x-cloak
       :class="sidebarToggle ? 'translate-x-0 xl:w-22.5' : '-translate-x-full rtl:translate-x-full'"
       class="sidebar fixed top-0 left-0 z-9999 flex h-screen w-72.5 flex-col border-r border-gray-200 bg-white px-5 transition-all duration-300 xl:static xl:translate-x-0 rtl:right-0 rtl:left-auto rtl:border-r-0 rtl:border-l dark:border-gray-800 dark:bg-black"
       x-on:click.outside="if (window.innerWidth < 1280) sidebarToggle = false"
       aria-label="侧边导航">

    <div :class="sidebarToggle ? 'xl:justify-center' : 'justify-between'" class="sidebar-header flex items-center gap-2 pt-5 pb-8">
        <a href="@homeUrl" class="flex items-center gap-2.5">
            <span class="sr-only">@Model.SiteName</span>
            @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
            {
                <img class="logo h-10 w-37.5 object-contain" src="@Model.LogoUrl" alt="@Model.SiteName" />
            }
            else
            {
                <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-brand-500 text-sm font-bold text-white">@initial</span>
                <span class="logo text-xl font-semibold text-gray-800 dark:text-white/90" :class="sidebarToggle ? 'xl:hidden' : ''">@Model.SiteName</span>
            }
        </a>
    </div>

    <div class="no-scrollbar flex flex-1 flex-col overflow-y-auto duration-300 ease-linear">
        <nav aria-label="侧边导航">
            <div>
                <h3 class="mb-4 text-xs leading-5 text-gray-400 uppercase">
                    <span class="menu-group-title" :class="sidebarToggle ? 'xl:hidden' : ''">MENU</span>
                    <svg :class="sidebarToggle ? 'xl:block hidden' : 'hidden'"
                         class="menu-group-icon mx-auto fill-current"
                         width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd" clip-rule="evenodd"
                              d="M5.99915 10.2451C6.96564 10.2451 7.74915 11.0286 7.74915 11.9951V12.0051C7.74915 12.9716 6.96564 13.7551 5.99915 13.7551C5.03265 13.7551 4.24915 12.9716 4.24915 12.0051V11.9951C4.24915 11.0286 5.03265 10.2451 5.99915 10.2451ZM17.9991 10.2451C18.9656 10.2451 19.7491 11.0286 19.7491 11.9951V12.0051C19.7491 12.9716 18.9656 13.7551 17.9991 13.7551C17.0326 13.7551 16.2491 12.9716 16.2491 12.0051V11.9951C16.2491 11.0286 17.0326 10.2451 17.9991 10.2451ZM13.7491 11.9951C13.7491 11.0286 12.9656 10.2451 11.9991 10.2451C11.0326 10.2451 10.2491 11.0286 10.2491 11.9951V12.0051C10.2491 12.9716 11.0326 13.7551 11.9991 13.7551C12.9656 13.7551 13.7491 12.9716 13.7491 12.0051V11.9951Z"
                              fill="currentColor" />
                    </svg>
                </h3>
                @await Component.InvokeAsync("AdminMenu")
            </div>
        </nav>
    </div>

    <div :class="sidebarToggle ? 'xl:hidden' : ''" class="pt-1 pb-4">
        <div class="rounded-2xl bg-gray-50 p-4 dark:bg-white/3">
            <p class="text-sm font-medium text-gray-800 dark:text-white/90">通用後台模板</p>
            <p class="mt-1 text-xs leading-5 text-gray-500 dark:text-gray-400">TailAdmin 官方界面基線 · v1.1.9</p>
        </div>
    </div>
</aside>
