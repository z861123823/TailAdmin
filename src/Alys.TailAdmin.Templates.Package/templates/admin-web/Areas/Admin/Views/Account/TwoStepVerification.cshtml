@{
    Layout = "~/Views/Shared/_AlysAdminAuthLayout.cshtml";
}
<div class="text-center">
    <span class="mx-auto flex size-14 items-center justify-center rounded-2xl bg-brand-50 text-brand-500 dark:bg-brand-500/15 dark:text-brand-400">
        <partial name="_Icon" model="@("check")" />
    </span>
    <h1 class="mt-4 text-title-sm font-semibold text-gray-800 sm:text-title-md dark:text-white/90">兩步驗證</h1>
    <p class="mt-2 text-theme-sm text-gray-500 dark:text-gray-400">
        請輸入驗證器 App 顯示的 6 位驗證碼。
    </p>
</div>

<form class="mt-7" onsubmit="event.preventDefault(); window.location.href='/Admin'">
    <label for="otp" class="mb-2 block text-center text-theme-sm font-medium text-gray-700 dark:text-gray-400">驗證碼</label>
    <input id="otp" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="000000"
           class="h-14 w-full rounded-lg border border-gray-300 bg-transparent text-center text-2xl font-semibold tracking-[0.5em] text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-300 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/20 dark:focus:border-brand-800" />
    <button type="submit"
            class="mt-5 flex w-full items-center justify-center rounded-lg bg-brand-500 px-4 py-3 text-theme-sm font-medium text-white shadow-theme-xs transition-colors hover:bg-brand-600">
        驗證並繼續
    </button>
</form>

<p class="mt-5 text-center text-theme-sm text-gray-500 dark:text-gray-400">
    沒收到驗證碼？
    <button type="button" class="font-medium text-brand-500 hover:text-brand-600 dark:text-brand-400"
            onclick="Ta.toast.success('驗證碼已重新發送（演示）')">重新發送</button>
</p>
<p class="mt-2 text-center text-theme-sm text-gray-500 dark:text-gray-400">
    <a asp-area="Admin" asp-controller="Account" asp-action="Login" class="font-medium text-brand-500 hover:text-brand-600 dark:text-brand-400">返回登入</a>
</p>
