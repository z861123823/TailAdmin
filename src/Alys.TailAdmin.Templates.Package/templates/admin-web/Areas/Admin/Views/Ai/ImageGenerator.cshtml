@{
    const string labelClass = "mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400";
    const string inputClass = "h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-theme-sm text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800";
    const string cardClass = "rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]";
    var styles = new[] { "寫實", "插畫", "3D 渲染", "扁平" };
    var ratios = new[] { "1:1", "4:3", "16:9", "9:16" };
}
<div class="grid grid-cols-1 gap-4 md:gap-6 xl:grid-cols-12">
    <section class="@cardClass xl:col-span-5" x-data="{ style: '寫實', ratio: '1:1' }">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">生成設定</h3>
        <div class="mt-4 space-y-4">
            <div>
                <label class="@labelClass" for="image-prompt">提示詞</label>
                <textarea id="image-prompt" rows="5"
                          class="w-full rounded-lg border border-gray-300 bg-transparent px-4 py-3 text-theme-sm text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800"
                          placeholder="例如：極簡風格的護膚品主圖，柔和自然光，淺米色背景"></textarea>
            </div>
            <div>
                <span class="@labelClass">風格</span>
                <div class="flex flex-wrap gap-2">
                    @foreach (var item in styles)
                    {
                        <button type="button" class="rounded-lg border px-3 py-2 text-theme-xs font-medium transition-colors"
                                x-bind:class="style === '@item' ? 'border-brand-300 bg-brand-50 text-brand-600 dark:border-brand-800 dark:bg-brand-500/15 dark:text-brand-400' : 'border-gray-300 text-gray-600 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-white/5'"
                                x-on:click="style = '@item'">@item</button>
                    }
                </div>
            </div>
            <div>
                <span class="@labelClass">比例</span>
                <div class="flex flex-wrap gap-2">
                    @foreach (var item in ratios)
                    {
                        <button type="button" class="rounded-lg border px-3 py-2 text-theme-xs font-medium transition-colors"
                                x-bind:class="ratio === '@item' ? 'border-brand-300 bg-brand-50 text-brand-600 dark:border-brand-800 dark:bg-brand-500/15 dark:text-brand-400' : 'border-gray-300 text-gray-600 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-white/5'"
                                x-on:click="ratio = '@item'">@item</button>
                    }
                </div>
            </div>
            <div>
                <label class="@labelClass" for="image-count">生成數量</label>
                <select id="image-count" class="@inputClass">
                    <option>1 張</option>
                    <option selected>4 張</option>
                    <option>8 張</option>
                </select>
            </div>
            <button type="button"
                    class="flex w-full items-center justify-center gap-2 rounded-lg bg-brand-500 px-4 py-3 text-theme-sm font-medium text-white shadow-theme-xs hover:bg-brand-600"
                    onclick="Ta.toast.success('已提交生成任務（演示）')">
                <partial name="_Icon" model="@("image")" />
                開始生成
            </button>
        </div>
    </section>

    <section class="@cardClass xl:col-span-7">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">生成結果</h3>
        <div class="mt-4 grid grid-cols-2 gap-3 md:gap-4">
            <div class="group relative overflow-hidden rounded-xl bg-gradient-to-br from-brand-100 via-brand-50 to-white dark:from-brand-500/20 dark:via-brand-500/10 dark:to-transparent">
                <div class="flex aspect-square items-end p-3">
                    <span class="rounded-full bg-white/80 px-2.5 py-1 text-theme-xs font-medium text-gray-700 backdrop-blur dark:bg-black/40 dark:text-gray-200">主圖 · 1</span>
                </div>
            </div>
            <div class="group relative overflow-hidden rounded-xl bg-gradient-to-br from-amber-100 via-orange-50 to-white dark:from-amber-500/20 dark:via-amber-500/10 dark:to-transparent">
                <div class="flex aspect-square items-end p-3">
                    <span class="rounded-full bg-white/80 px-2.5 py-1 text-theme-xs font-medium text-gray-700 backdrop-blur dark:bg-black/40 dark:text-gray-200">主圖 · 2</span>
                </div>
            </div>
            <div class="group relative overflow-hidden rounded-xl bg-gradient-to-br from-green-100 via-emerald-50 to-white dark:from-green-500/20 dark:via-green-500/10 dark:to-transparent">
                <div class="flex aspect-square items-end p-3">
                    <span class="rounded-full bg-white/80 px-2.5 py-1 text-theme-xs font-medium text-gray-700 backdrop-blur dark:bg-black/40 dark:text-gray-200">主圖 · 3</span>
                </div>
            </div>
            <div class="group relative overflow-hidden rounded-xl bg-gradient-to-br from-gray-100 via-gray-50 to-white dark:from-white/10 dark:via-white/5 dark:to-transparent">
                <div class="flex aspect-square items-end p-3">
                    <span class="rounded-full bg-white/80 px-2.5 py-1 text-theme-xs font-medium text-gray-700 backdrop-blur dark:bg-black/40 dark:text-gray-200">主圖 · 4</span>
                </div>
            </div>
        </div>
        <div class="mt-4 flex flex-wrap justify-end gap-2">
            <button type="button" class="rounded-lg border border-gray-300 px-3 py-2 text-theme-xs font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-white/5"
                    onclick="Ta.toast.success('已全部下載（演示）')">全部下載</button>
            <button type="button" class="rounded-lg bg-brand-500 px-3 py-2 text-theme-xs font-medium text-white hover:bg-brand-600"
                    onclick="Ta.toast.info('已加入素材庫（演示）')">加入素材庫</button>
        </div>
    </section>
</div>
