@{
    const string labelClass = "mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400";
    const string inputClass = "h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-theme-sm text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800";
    const string hintClass = "mt-1.5 text-theme-xs text-gray-500 dark:text-gray-400";
}
<div class="grid grid-cols-1 gap-4 md:gap-6 xl:grid-cols-2">
    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">文字輸入</h3>
        <div class="mt-4 space-y-4">
            <div>
                <label class="@labelClass" for="demo-text">姓名</label>
                <input id="demo-text" type="text" class="@inputClass" placeholder="請輸入姓名" />
            </div>
            <div>
                <label class="@labelClass" for="demo-email">郵箱</label>
                <input id="demo-email" type="email" class="@inputClass" placeholder="you@example.com" />
                <p class="@hintClass">我們不會向第三方分享你的郵箱。</p>
            </div>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div>
                    <label class="@labelClass" for="demo-password">密碼</label>
                    <input id="demo-password" type="password" class="@inputClass" placeholder="至少 6 位字元" />
                </div>
                <div>
                    <label class="@labelClass" for="demo-number">數量</label>
                    <input id="demo-number" type="number" class="@inputClass" value="10" min="1" />
                </div>
            </div>
            <div>
                <label class="@labelClass" for="demo-disabled">禁用狀態</label>
                <input id="demo-disabled" type="text" class="@inputClass cursor-not-allowed opacity-60" value="不可編輯" disabled />
            </div>
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">下拉與日期</h3>
        <div class="mt-4 space-y-4">
            <div>
                <label class="@labelClass" for="demo-select">所屬分類</label>
                <select id="demo-select" class="@inputClass">
                    <option value="">請選擇分類</option>
                    <option value="1">數碼</option>
                    <option value="2">服飾</option>
                    <option value="3">家居</option>
                </select>
            </div>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div>
                    <label class="@labelClass" for="demo-date">日期</label>
                    <input id="demo-date" type="date" class="@inputClass" />
                </div>
                <div>
                    <label class="@labelClass" for="demo-time">時間</label>
                    <input id="demo-time" type="time" class="@inputClass" />
                </div>
            </div>
            <div>
                <label class="@labelClass" for="demo-file">附件</label>
                <input id="demo-file" type="file"
                       class="block w-full cursor-pointer rounded-lg border border-gray-300 bg-transparent text-theme-sm text-gray-500 shadow-theme-xs file:mr-4 file:border-0 file:bg-gray-50 file:px-4 file:py-2.5 file:text-theme-sm file:font-medium file:text-gray-700 hover:file:bg-gray-100 dark:border-gray-700 dark:text-gray-400 dark:file:bg-white/5 dark:file:text-gray-300" />
                <p class="@hintClass">支援 PNG、JPG，單檔不超過 5MB。</p>
            </div>
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">文字域</h3>
        <div class="mt-4">
            <label class="@labelClass" for="demo-textarea">備註</label>
            <textarea id="demo-textarea" rows="5"
                      class="w-full rounded-lg border border-gray-300 bg-transparent px-4 py-3 text-theme-sm text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800"
                      placeholder="請輸入備註內容"></textarea>
            <p class="@hintClass">最多 500 字。</p>
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">複選框與單選框</h3>
        <div class="mt-4 space-y-4">
            <label class="flex items-center gap-3 text-theme-sm text-gray-700 dark:text-gray-300">
                <input type="checkbox" checked
                       class="size-4 rounded border-gray-300 text-brand-500 focus:ring-3 focus:ring-brand-500/20 dark:border-gray-700 dark:bg-gray-900" />
                接收訂單通知
            </label>
            <label class="flex items-center gap-3 text-theme-sm text-gray-700 dark:text-gray-300">
                <input type="checkbox"
                       class="size-4 rounded border-gray-300 text-brand-500 focus:ring-3 focus:ring-brand-500/20 dark:border-gray-700 dark:bg-gray-900" />
                接收行銷郵件
            </label>
            <div class="border-t border-gray-100 pt-4 dark:border-gray-800">
                <p class="@labelClass">配送方式</p>
                <div class="flex flex-wrap items-center gap-5">
                    <label class="flex items-center gap-2 text-theme-sm text-gray-700 dark:text-gray-300">
                        <input type="radio" name="demo-shipping" checked
                               class="size-4 border-gray-300 text-brand-500 focus:ring-3 focus:ring-brand-500/20 dark:border-gray-700 dark:bg-gray-900" />
                        標準配送
                    </label>
                    <label class="flex items-center gap-2 text-theme-sm text-gray-700 dark:text-gray-300">
                        <input type="radio" name="demo-shipping"
                               class="size-4 border-gray-300 text-brand-500 focus:ring-3 focus:ring-brand-500/20 dark:border-gray-700 dark:bg-gray-900" />
                        次日達
                    </label>
                </div>
            </div>
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 xl:col-span-2 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">開關</h3>
        <div class="mt-4 flex flex-wrap items-center gap-8">
            <label class="inline-flex cursor-pointer items-center gap-3">
                <input type="checkbox" class="peer sr-only" checked />
                <span class="relative h-6 w-11 rounded-full bg-gray-200 transition-colors after:absolute after:top-0.5 after:left-0.5 after:size-5 after:rounded-full after:bg-white after:transition-transform after:content-[''] peer-checked:bg-brand-500 peer-checked:after:translate-x-5 dark:bg-gray-700"></span>
                <span class="text-theme-sm text-gray-700 dark:text-gray-300">啟用通知</span>
            </label>
            <label class="inline-flex cursor-pointer items-center gap-3">
                <input type="checkbox" class="peer sr-only" />
                <span class="relative h-6 w-11 rounded-full bg-gray-200 transition-colors after:absolute after:top-0.5 after:left-0.5 after:size-5 after:rounded-full after:bg-white after:transition-transform after:content-[''] peer-checked:bg-brand-500 peer-checked:after:translate-x-5 dark:bg-gray-700"></span>
                <span class="text-theme-sm text-gray-700 dark:text-gray-300">自動續訂</span>
            </label>
            <label class="inline-flex cursor-not-allowed items-center gap-3 opacity-50">
                <input type="checkbox" class="peer sr-only" disabled />
                <span class="relative h-6 w-11 rounded-full bg-gray-200 transition-colors after:absolute after:top-0.5 after:left-0.5 after:size-5 after:rounded-full after:bg-white after:transition-transform after:content-[''] peer-checked:bg-brand-500 peer-checked:after:translate-x-5 dark:bg-gray-700"></span>
                <span class="text-theme-sm text-gray-700 dark:text-gray-300">禁用狀態</span>
            </label>
        </div>
    </section>
</div>

<div class="mt-4 grid grid-cols-1 gap-4 md:mt-6 md:gap-6 xl:grid-cols-2">
    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">進階輸入</h3>
        <div class="mt-4 space-y-4">
            <div>
                <label class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400" for="input-icon">帶圖標</label>
                <div class="relative">
                    <span class="pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 text-gray-400 dark:text-gray-500">
                        <partial name="_Icon" model="@("search")" />
                    </span>
                    <input id="input-icon" type="text" placeholder="搜索訂單或客戶"
                           class="h-11 w-full rounded-lg border border-gray-300 bg-transparent pr-4 pl-11 text-theme-sm text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800" />
                </div>
            </div>
            <div x-data="{ show: false }">
                <label class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400" for="input-password">密碼（可切換顯示）</label>
                <div class="relative">
                    <input id="input-password" x-bind:type="show ? 'text' : 'password'" value="Alys@2026" autocomplete="off"
                           class="h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 pr-12 text-theme-sm text-gray-800 shadow-theme-xs transition-colors focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:focus:border-brand-800" />
                    <button type="button" class="absolute top-1/2 right-2 -translate-y-1/2 rounded px-2 py-1 text-theme-xs font-medium text-brand-500 hover:bg-brand-50 dark:text-brand-400 dark:hover:bg-brand-500/10"
                            x-on:click="show = !show" x-text="show ? '隱藏' : '顯示'" aria-label="切換密碼顯示"></button>
                </div>
            </div>
            <div>
                <label class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400" for="input-error">錯誤狀態</label>
                <input id="input-error" type="email" value="manager@@"
                       class="h-11 w-full rounded-lg border border-red-300 bg-transparent px-4 py-2.5 text-theme-sm text-gray-800 shadow-theme-xs focus:border-red-400 focus:ring-3 focus:ring-red-500/20 focus:outline-hidden dark:border-red-500/50 dark:bg-gray-900 dark:text-white/90" />
                <p class="mt-1.5 text-theme-xs text-red-600 dark:text-red-400">請輸入完整的郵箱地址。</p>
            </div>
            <div>
                <label class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400" for="input-success">成功狀態</label>
                <input id="input-success" type="text" value="SKU-1042"
                       class="h-11 w-full rounded-lg border border-green-300 bg-transparent px-4 py-2.5 text-theme-sm text-gray-800 shadow-theme-xs focus:border-green-400 focus:ring-3 focus:ring-green-500/20 focus:outline-hidden dark:border-green-500/50 dark:bg-gray-900 dark:text-white/90" />
                <p class="mt-1.5 text-theme-xs text-green-600 dark:text-green-400">SKU 可使用。</p>
            </div>
            <div>
                <label class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400" for="input-disabled">禁用狀態</label>
                <input id="input-disabled" type="text" value="不可編輯" disabled
                       class="h-11 w-full cursor-not-allowed rounded-lg border border-gray-200 bg-gray-50 px-4 py-2.5 text-theme-sm text-gray-400 dark:border-gray-800 dark:bg-gray-900/60 dark:text-gray-600" />
            </div>
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">選項與組合</h3>
        <div class="mt-4 space-y-5">
            <div>
                <span class="mb-2 block text-theme-sm font-medium text-gray-700 dark:text-gray-400">方案選擇（卡片式單選）</span>
                <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
                    <label class="cursor-pointer rounded-xl border border-gray-200 p-4 transition-colors hover:border-brand-300 dark:border-gray-700">
                        <input type="radio" name="plan-card" class="peer sr-only" />
                        <span class="block text-theme-sm font-medium text-gray-800 peer-checked:text-brand-600 dark:text-gray-300">基礎版</span>
                        <span class="mt-1 block text-theme-xs text-gray-500 dark:text-gray-400">$99 / 月</span>
                        <span class="mt-2 block size-4 rounded-full border border-gray-300 peer-checked:border-4 peer-checked:border-brand-500 dark:border-gray-600"></span>
                    </label>
                    <label class="cursor-pointer rounded-xl border border-gray-200 p-4 transition-colors hover:border-brand-300 dark:border-gray-700">
                        <input type="radio" name="plan-card" class="peer sr-only" checked />
                        <span class="block text-theme-sm font-medium text-gray-800 peer-checked:text-brand-600 dark:text-gray-300">專業版</span>
                        <span class="mt-1 block text-theme-xs text-gray-500 dark:text-gray-400">$299 / 月</span>
                        <span class="mt-2 block size-4 rounded-full border border-gray-300 peer-checked:border-4 peer-checked:border-brand-500 dark:border-gray-600"></span>
                    </label>
                    <label class="cursor-pointer rounded-xl border border-gray-200 p-4 transition-colors hover:border-brand-300 dark:border-gray-700">
                        <input type="radio" name="plan-card" class="peer sr-only" />
                        <span class="block text-theme-sm font-medium text-gray-800 peer-checked:text-brand-600 dark:text-gray-300">企業版</span>
                        <span class="mt-1 block text-theme-xs text-gray-500 dark:text-gray-400">$999 / 月</span>
                        <span class="mt-2 block size-4 rounded-full border border-gray-300 peer-checked:border-4 peer-checked:border-brand-500 dark:border-gray-600"></span>
                    </label>
                </div>
            </div>
            <div>
                <span class="mb-2 block text-theme-sm font-medium text-gray-700 dark:text-gray-400">通知渠道（多選）</span>
                <div class="space-y-2">
                    <label class="flex items-center gap-2 text-theme-sm text-gray-700 dark:text-gray-300">
                        <input type="checkbox" class="size-4 rounded border-gray-300 text-brand-500 focus:ring-3 focus:ring-brand-500/20 dark:border-gray-700 dark:bg-gray-900" checked />
                        站內通知
                    </label>
                    <label class="flex items-center gap-2 text-theme-sm text-gray-700 dark:text-gray-300">
                        <input type="checkbox" class="size-4 rounded border-gray-300 text-brand-500 focus:ring-3 focus:ring-brand-500/20 dark:border-gray-700 dark:bg-gray-900" checked />
                        電子郵件
                    </label>
                    <label class="flex items-center gap-2 text-theme-sm text-gray-700 dark:text-gray-300">
                        <input type="checkbox" class="size-4 rounded border-gray-300 text-brand-500 focus:ring-3 focus:ring-brand-500/20 dark:border-gray-700 dark:bg-gray-900" />
                        SMS 簡訊
                    </label>
                </div>
            </div>
            <div>
                <span class="mb-2 block text-theme-sm font-medium text-gray-700 dark:text-gray-400">尺寸對比</span>
                <div class="flex flex-wrap items-center gap-3">
                    <input type="text" placeholder="小尺寸" class="h-9 w-32 rounded-lg border border-gray-300 bg-transparent px-3 text-theme-xs text-gray-800 focus:border-brand-300 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
                    <input type="text" placeholder="預設尺寸" class="h-11 w-40 rounded-lg border border-gray-300 bg-transparent px-4 text-theme-sm text-gray-800 focus:border-brand-300 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
                    <input type="text" placeholder="大尺寸" class="h-12 w-48 rounded-xl border border-gray-300 bg-transparent px-4 text-theme-sm text-gray-800 focus:border-brand-300 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
                </div>
            </div>
        </div>
    </section>
</div>
