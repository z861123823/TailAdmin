@model string
<div class="grid grid-cols-1 gap-4 sm:grid-cols-3 md:gap-6">
    <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
        <p class="text-theme-sm text-gray-500 dark:text-gray-400">今日訂單</p>
        <p class="mt-2 text-2xl font-semibold text-gray-800 dark:text-white/90">128</p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
        <p class="text-theme-sm text-gray-500 dark:text-gray-400">銷售額</p>
        <p class="mt-2 text-2xl font-semibold text-gray-800 dark:text-white/90">$12,480</p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
        <p class="text-theme-sm text-gray-500 dark:text-gray-400">待處理工單</p>
        <p class="mt-2 text-2xl font-semibold text-gray-800 dark:text-white/90">6</p>
    </div>
</div>

<div class="mt-4 rounded-2xl border border-gray-200 bg-white p-5 md:mt-6 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
    <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">佈局說明</h3>
    <p class="mt-2 text-theme-sm leading-6 text-gray-600 dark:text-gray-400">@Model</p>
    <p class="mt-2 text-theme-sm leading-6 text-gray-500 dark:text-gray-400">
        佈局由 <code class="rounded bg-gray-100 px-1.5 py-0.5 text-theme-xs dark:bg-white/10">_AlysAdminLayout</code> 的 ViewData 開關控制，僅影響當前頁面，不改變全域設定。
    </p>
</div>
