@{
    var table = new TaTableModel
    {
        Id = "ecommerceProducts",
        Url = Url.Action("List", "Goods", new { area = "Admin" }) ?? string.Empty,
        RowKey = "Id",
        PageSize = 10,
        EmptyText = "暫無商品",
        FixedSelectable = true,
        Columns = new List<TaColumnModel>
        {
            new() { Key = "GoodsName", Label = "商品名稱", Fixed = "left", Width = 200 },
            new() { Key = "TypeName", Label = "分類", Sortable = false },
            new() { Key = "Price", Label = "價格", Type = "money", Align = "right" },
            new() { Key = "SalesVolume", Label = "銷量", Type = "number", Align = "right" },
            new() { Key = "IsHot", Label = "熱銷", Type = "bool", Align = "center", Sortable = false },
            new() { Key = "AddTime", Label = "上架時間", Type = "date" }
        },
        Actions = new List<TaActionModel>
        {
            new() { Label = "查看", Event = "view", Variant = "primary" },
            new() { Label = "編輯", Event = "edit", Variant = "ghost" },
            new() { Label = "刪除", Event = "delete", Variant = "error" }
        },
        OnAction = "view: function(row){ Ta.toast.info('查看：' + row.GoodsName); }, edit: function(row){ Ta.toast.info('編輯：' + row.GoodsName); }, delete: function(row){ Ta.confirm({ title: '刪除確認', text: '確定刪除 ' + row.GoodsName + '？', confirmText: '刪除', danger: true }).then(function(ok){ if (ok) Ta.toast.success('已刪除（演示）'); }); }"
    };
    var toolbar = new TableToolbarModel
    {
        TableId = "ecommerceProducts",
        Description = "支援關鍵字查詢、分頁與固定列",
        Placeholder = "搜索商品名稱"
    };
    var categories = new[]
    {
        new { Name = "數碼", Count = 428, Share = 34, Tone = "bg-brand-500" },
        new { Name = "服飾", Count = 356, Share = 29, Tone = "bg-green-500" },
        new { Name = "家居", Count = 242, Share = 19, Tone = "bg-amber-500" },
        new { Name = "美妝", Count = 148, Share = 12, Tone = "bg-red-500" },
        new { Name = "其他", Count = 74, Share = 6, Tone = "bg-gray-400" }
    };
}
@section PageActions {
    <a asp-area="Admin" asp-controller="Ecommerce" asp-action="AddProduct"
       class="inline-flex items-center justify-center gap-2 rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white shadow-theme-xs transition-colors hover:bg-brand-600">
        <partial name="_Icon" model="@("plus")" />
        新增商品
    </a>
}

<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4 md:gap-6">
    <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="flex items-start justify-between">
            <p class="text-theme-sm text-gray-500 dark:text-gray-400">全部商品</p>
            <span class="flex size-9 items-center justify-center rounded-lg bg-brand-50 text-brand-500 dark:bg-brand-500/15 dark:text-brand-400">
                <partial name="_Icon" model="@("goods")" />
            </span>
        </div>
        <p class="mt-2 text-2xl font-semibold text-gray-800 dark:text-white/90">1,248</p>
        <p class="mt-1 text-theme-xs text-green-600 dark:text-green-400">↑ 36 本週新增</p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="flex items-start justify-between">
            <p class="text-theme-sm text-gray-500 dark:text-gray-400">在售</p>
            <span class="flex size-9 items-center justify-center rounded-lg bg-green-50 text-green-600 dark:bg-green-500/15 dark:text-green-400">
                <partial name="_Icon" model="@("check")" />
            </span>
        </div>
        <p class="mt-2 text-2xl font-semibold text-gray-800 dark:text-white/90">986</p>
        <p class="mt-1 text-theme-xs text-gray-500 dark:text-gray-400">佔全部 79%</p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="flex items-start justify-between">
            <p class="text-theme-sm text-gray-500 dark:text-gray-400">缺貨</p>
            <span class="flex size-9 items-center justify-center rounded-lg bg-amber-50 text-amber-600 dark:bg-amber-500/15 dark:text-amber-400">
                <partial name="_Icon" model="@("alert")" />
            </span>
        </div>
        <p class="mt-2 text-2xl font-semibold text-amber-600 dark:text-amber-400">42</p>
        <p class="mt-1 text-theme-xs text-amber-600 dark:text-amber-400">需盡快補貨</p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="flex items-start justify-between">
            <p class="text-theme-sm text-gray-500 dark:text-gray-400">今日新增</p>
            <span class="flex size-9 items-center justify-center rounded-lg bg-blue-50 text-blue-600 dark:bg-blue-500/15 dark:text-blue-400">
                <partial name="_Icon" model="@("plus")" />
            </span>
        </div>
        <p class="mt-2 text-2xl font-semibold text-gray-800 dark:text-white/90">18</p>
        <p class="mt-1 text-theme-xs text-gray-500 dark:text-gray-400">較昨日 +4</p>
    </div>
</div>

<div class="mt-4 grid grid-cols-1 gap-4 md:mt-6 md:gap-6 xl:grid-cols-12">
    <div class="space-y-4 md:space-y-6 xl:col-span-9">
        <partial name="_TableToolbar" model="toolbar" />
        <partial name="_TaTable" model="table" />
    </div>

    <aside class="space-y-4 md:space-y-6 xl:col-span-3">
        <section class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
            <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">分類分佈</h3>
            <div class="mt-4 space-y-3.5">
                @foreach (var category in categories)
                {
                    <div>
                        <div class="flex items-center justify-between text-theme-sm">
                            <span class="text-gray-700 dark:text-gray-300">@category.Name</span>
                            <span class="text-gray-500 dark:text-gray-400">@category.Count</span>
                        </div>
                        <div class="mt-1.5 h-2 rounded-full bg-gray-100 dark:bg-white/10">
                            <div class="h-2 rounded-full @category.Tone" style="width:@(category.Share)%"></div>
                        </div>
                    </div>
                }
            </div>
        </section>

        <section class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
            <div class="flex items-center justify-between">
                <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">庫存提醒</h3>
                <span class="rounded-full bg-red-50 px-2 py-0.5 text-theme-xs font-medium text-red-600 dark:bg-red-500/15 dark:text-red-400">3</span>
            </div>
            <ul class="mt-3 divide-y divide-gray-100 text-theme-sm dark:divide-gray-800">
                <li class="flex items-center justify-between gap-3 py-2.5">
                    <span class="text-gray-700 dark:text-gray-300">無線藍牙耳機</span>
                    <span class="text-theme-xs text-red-600 dark:text-red-400">剩 6 件</span>
                </li>
                <li class="flex items-center justify-between gap-3 py-2.5">
                    <span class="text-gray-700 dark:text-gray-300">便攜充電器</span>
                    <span class="text-theme-xs text-red-600 dark:text-red-400">剩 9 件</span>
                </li>
                <li class="flex items-center justify-between gap-3 py-2.5">
                    <span class="text-gray-700 dark:text-gray-300">棉麻抱枕套</span>
                    <span class="text-theme-xs text-amber-600 dark:text-amber-400">剩 14 件</span>
                </li>
            </ul>
        </section>
    </aside>
</div>
