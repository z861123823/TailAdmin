@{
    const string cardClass = "rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]";
    var planBadge = new TaBadgeModel { Text = "目前方案", Variant = "primary", Dot = true };
    var invoices = new[]
    {
        new { No = "INV-2026-011", Date = "2026-11-01", Amount = "$49.00", Variant = "success", Status = "已支付" },
        new { No = "INV-2026-010", Date = "2026-10-01", Amount = "$49.00", Variant = "success", Status = "已支付" },
        new { No = "INV-2026-009", Date = "2026-09-01", Amount = "$49.00", Variant = "success", Status = "已支付" }
    };
}
<div class="grid grid-cols-1 gap-4 md:gap-6 xl:grid-cols-12">
    <div class="space-y-4 md:space-y-6 xl:col-span-8">
        <section class="@cardClass">
            <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                    <div class="flex items-center gap-2">
                        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">專業版</h3>
                        <partial name="_TaBadge" model="planBadge" />
                    </div>
                    <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">包含全部後台模組、無限商品與優先技術支援。</p>
                </div>
                <p class="text-2xl font-semibold text-gray-800 dark:text-white/90">$49<span class="text-theme-sm font-normal text-gray-500 dark:text-gray-400"> / 月</span></p>
            </div>
            <dl class="mt-5 grid grid-cols-1 gap-3 border-t border-gray-100 pt-4 text-theme-sm sm:grid-cols-3 dark:border-gray-800">
                <div>
                    <dt class="text-gray-500 dark:text-gray-400">下次扣款</dt>
                    <dd class="mt-0.5 font-medium text-gray-800 dark:text-gray-300">2026-12-01</dd>
                </div>
                <div>
                    <dt class="text-gray-500 dark:text-gray-400">計費週期</dt>
                    <dd class="mt-0.5 font-medium text-gray-800 dark:text-gray-300">每月</dd>
                </div>
                <div>
                    <dt class="text-gray-500 dark:text-gray-400">席位</dt>
                    <dd class="mt-0.5 font-medium text-gray-800 dark:text-gray-300">10 個</dd>
                </div>
            </dl>
            <div class="mt-5 flex flex-wrap gap-3">
                <button type="button" class="inline-flex items-center justify-center rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white shadow-theme-xs transition-colors hover:bg-brand-600"
                        onclick="Ta.toast.info('變更方案（演示）')">變更方案</button>
                <button type="button" class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-theme-sm font-medium text-gray-700 shadow-theme-xs transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400"
                        onclick="Ta.toast.info('已取消訂閱（演示）')">取消訂閱</button>
            </div>
        </section>

        <section class="@cardClass">
            <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">付款方式</h3>
            <div class="mt-4 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-gray-100 p-4 dark:border-gray-800">
                <div class="flex items-center gap-3">
                    <span class="flex size-11 items-center justify-center rounded-lg bg-brand-50 text-brand-600 dark:bg-brand-500/15 dark:text-brand-400">VISA</span>
                    <div>
                        <p class="text-theme-sm font-medium text-gray-800 dark:text-white/90">•••• •••• •••• 4242</p>
                        <p class="text-theme-xs text-gray-500 dark:text-gray-400">有效期限 08/28</p>
                    </div>
                </div>
                <button type="button" class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-theme-xs font-medium text-gray-700 shadow-theme-xs hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400"
                        onclick="Ta.toast.info('更新付款方式（演示）')">更新</button>
            </div>
        </section>

        <section class="overflow-hidden rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
            <div class="flex items-center justify-between border-b border-gray-100 px-5 py-4 md:px-6 dark:border-gray-800">
                <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">最近帳單</h3>
                <a asp-area="Admin" asp-controller="Ecommerce" asp-action="Invoices"
                   class="text-theme-sm font-medium text-brand-500 hover:text-brand-600 dark:text-brand-400">查看全部</a>
            </div>
            <div class="max-w-full overflow-x-auto custom-scrollbar">
                <table class="min-w-full">
                    <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                        @foreach (var item in invoices)
                        {
                            var badge = new TaBadgeModel { Text = item.Status, Variant = item.Variant, Dot = true };
                            <tr>
                                <td class="px-5 py-4 text-theme-sm font-medium whitespace-nowrap text-gray-800 dark:text-white/90">@item.No</td>
                                <td class="px-5 py-4 text-theme-sm whitespace-nowrap text-gray-500 dark:text-gray-400">@item.Date</td>
                                <td class="px-5 py-4 text-theme-sm whitespace-nowrap text-gray-800 dark:text-gray-300">@item.Amount</td>
                                <td class="px-5 py-4"><partial name="_TaBadge" model="badge" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <aside class="space-y-4 md:space-y-6 xl:col-span-4">
        <section class="@cardClass">
            <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">帳單地址</h3>
            <p class="mt-3 text-theme-sm leading-6 text-gray-600 dark:text-gray-400">
                陳小明<br />
                台北市信義區信義路五段 7 號<br />
                110 台灣
            </p>
            <button type="button" class="mt-4 inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-theme-sm font-medium text-gray-700 shadow-theme-xs transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400"
                    onclick="Ta.toast.info('編輯地址（演示）')">編輯地址</button>
        </section>

        <section class="@cardClass">
            <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">用量</h3>
            <div class="mt-3 space-y-3 text-theme-sm">
                <div>
                    <div class="flex items-center justify-between text-gray-600 dark:text-gray-400">
                        <span>商品數</span><span>680 / 1000</span>
                    </div>
                    <div class="mt-1.5 h-2 rounded-full bg-gray-100 dark:bg-white/10">
                        <div class="h-2 rounded-full bg-brand-500" style="width:68%"></div>
                    </div>
                </div>
                <div>
                    <div class="flex items-center justify-between text-gray-600 dark:text-gray-400">
                        <span>API 呼叫</span><span>42%</span>
                    </div>
                    <div class="mt-1.5 h-2 rounded-full bg-gray-100 dark:bg-white/10">
                        <div class="h-2 rounded-full bg-green-500" style="width:42%"></div>
                    </div>
                </div>
            </div>
        </section>
    </aside>
</div>
