@{
    var invoiceNo = (string)(ViewData["InvoiceNo"] ?? "INV-2026-0042");
    var items = new[]
    {
        new { Name = "無線藍牙耳機 Pro", Sku = "SKU-1042", Qty = 20, Price = "$89.00", Amount = "$1,780.00" },
        new { Name = "便攜充電器 10000mAh", Sku = "SKU-1088", Qty = 30, Price = "$36.00", Amount = "$1,080.00" },
        new { Name = "棉麻抱枕套（灰）", Sku = "SKU-2031", Qty = 40, Price = "$12.50", Amount = "$500.00" },
        new { Name = "香氛蠟燭禮盒", Sku = "SKU-3105", Qty = 15, Price = "$24.00", Amount = "$360.00" }
    };
}
<div class="mx-auto w-full max-w-4xl">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h2 class="text-xl font-semibold text-gray-800 dark:text-white/90">@invoiceNo</h2>
            <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">開票日期 2026-11-21 · 到期日 2026-12-05</p>
        </div>
        <div class="flex flex-wrap gap-2">
            <a asp-area="Admin" asp-controller="Ecommerce" asp-action="Invoices"
               class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-theme-sm font-medium text-gray-700 shadow-theme-xs hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400">
                <partial name="_Icon" model="@("chevron-left")" />
                返回列表
            </a>
            <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-theme-sm font-medium text-gray-700 shadow-theme-xs hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400"
                    onclick="Ta.toast.info('已發送郵件（演示）')">
                <partial name="_Icon" model="@("mail")" />
                發送
            </button>
            <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-theme-sm font-medium text-gray-700 shadow-theme-xs hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400"
                    onclick="window.print()">
                <partial name="_Icon" model="@("upload")" />
                列印 / PDF
            </button>
        </div>
    </div>

    <article class="mt-4 rounded-2xl border border-gray-200 bg-white p-6 md:p-8 dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="flex flex-wrap items-start justify-between gap-6">
            <div>
                <div class="flex items-center gap-2">
                    <span class="flex size-10 items-center justify-center rounded-xl bg-brand-500 text-theme-sm font-bold text-white">A</span>
                    <div>
                        <p class="text-base font-semibold text-gray-800 dark:text-white/90">商城運營中心</p>
                        <p class="text-theme-xs text-gray-500 dark:text-gray-400">台北市信義區松高路 88 號</p>
                    </div>
                </div>
                <p class="mt-3 text-theme-xs text-gray-500 dark:text-gray-400">統編 12345678 · service@@example.com</p>
            </div>
            <div class="text-right">
                <p class="text-lg font-semibold text-gray-800 dark:text-white/90">發票</p>
                <p class="mt-1 text-theme-sm text-gray-600 dark:text-gray-400">@invoiceNo</p>
                <span class="mt-2 inline-flex rounded-full bg-green-50 px-2.5 py-1 text-theme-xs font-medium text-green-600 dark:bg-green-500/15 dark:text-green-400">已付款</span>
            </div>
        </div>

        <div class="mt-6 grid grid-cols-1 gap-4 border-t border-gray-100 pt-5 sm:grid-cols-2 dark:border-gray-800">
            <div>
                <p class="text-theme-xs font-medium text-gray-500 dark:text-gray-400">帳單寄送</p>
                <p class="mt-1 text-theme-sm font-medium text-gray-800 dark:text-white/90">宏遠科技股份有限公司</p>
                <p class="text-theme-sm text-gray-600 dark:text-gray-400">林經理 · +886 2 2345 6789</p>
                <p class="text-theme-sm text-gray-600 dark:text-gray-400">台北市松山區南京東路三段 100 號 12 樓</p>
            </div>
            <div class="sm:text-right">
                <dl class="space-y-1 text-theme-sm">
                    <div class="flex justify-between gap-4 sm:justify-end">
                        <dt class="text-gray-500 dark:text-gray-400">開票日期</dt>
                        <dd class="font-medium text-gray-800 dark:text-gray-300">2026-11-21</dd>
                    </div>
                    <div class="flex justify-between gap-4 sm:justify-end">
                        <dt class="text-gray-500 dark:text-gray-400">到期日</dt>
                        <dd class="font-medium text-gray-800 dark:text-gray-300">2026-12-05</dd>
                    </div>
                    <div class="flex justify-between gap-4 sm:justify-end">
                        <dt class="text-gray-500 dark:text-gray-400">付款方式</dt>
                        <dd class="font-medium text-gray-800 dark:text-gray-300">銀行轉帳</dd>
                    </div>
                </dl>
            </div>
        </div>

        <div class="mt-6 overflow-x-auto custom-scrollbar">
            <table class="min-w-full">
                <thead class="border-y border-gray-100 dark:border-gray-800">
                    <tr>
                        <th class="py-3 pr-4 text-start text-theme-xs font-medium text-gray-500 dark:text-gray-400">商品</th>
                        <th class="px-4 py-3 text-start text-theme-xs font-medium text-gray-500 dark:text-gray-400">SKU</th>
                        <th class="px-4 py-3 text-end text-theme-xs font-medium text-gray-500 dark:text-gray-400">數量</th>
                        <th class="px-4 py-3 text-end text-theme-xs font-medium text-gray-500 dark:text-gray-400">單價</th>
                        <th class="py-3 pl-4 text-end text-theme-xs font-medium text-gray-500 dark:text-gray-400">金額</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                    @foreach (var item in items)
                    {
                        <tr>
                            <td class="py-3 pr-4 text-theme-sm whitespace-nowrap font-medium text-gray-800 dark:text-gray-300">@item.Name</td>
                            <td class="px-4 py-3 text-theme-sm whitespace-nowrap text-gray-500 dark:text-gray-400">@item.Sku</td>
                            <td class="px-4 py-3 text-end text-theme-sm text-gray-600 dark:text-gray-400">@item.Qty</td>
                            <td class="px-4 py-3 text-end text-theme-sm text-gray-600 dark:text-gray-400">@item.Price</td>
                            <td class="py-3 pl-4 text-end text-theme-sm whitespace-nowrap text-gray-800 dark:text-gray-300">@item.Amount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-5 flex justify-end">
            <dl class="w-full max-w-xs space-y-2 text-theme-sm">
                <div class="flex justify-between gap-4">
                    <dt class="text-gray-500 dark:text-gray-400">小計</dt>
                    <dd class="font-medium text-gray-800 dark:text-gray-300">$3,720.00</dd>
                </div>
                <div class="flex justify-between gap-4">
                    <dt class="text-gray-500 dark:text-gray-400">稅額（5%）</dt>
                    <dd class="font-medium text-gray-800 dark:text-gray-300">$186.00</dd>
                </div>
                <div class="flex justify-between gap-4">
                    <dt class="text-gray-500 dark:text-gray-400">運費</dt>
                    <dd class="font-medium text-gray-800 dark:text-gray-300">$0.00</dd>
                </div>
                <div class="flex justify-between gap-4 border-t border-gray-100 pt-2 dark:border-gray-800">
                    <dt class="text-base font-semibold text-gray-800 dark:text-white/90">應付總額</dt>
                    <dd class="text-base font-semibold text-brand-600 dark:text-brand-400">$3,906.00</dd>
                </div>
            </dl>
        </div>

        <div class="mt-6 rounded-xl bg-gray-50 p-4 text-theme-xs leading-5 text-gray-500 dark:bg-white/5 dark:text-gray-400">
            付款資訊：銀行代碼 012 · 帳號 1234-5678-9012 · 戶名「商城運營中心」。請於到期日前完成付款，並在備註欄填寫發票編號。
        </div>
    </article>
</div>
