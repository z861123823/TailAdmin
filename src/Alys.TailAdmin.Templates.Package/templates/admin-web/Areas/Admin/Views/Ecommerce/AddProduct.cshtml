@{
    const string labelClass = "mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400";
    const string inputClass = "h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-theme-sm text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800";
    const string cardClass = "rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]";
}
<form class="grid grid-cols-12 gap-4 md:gap-6"
      x-data="{ status: 'now', variants: [ { name: '黑色 / 標準版', price: '89.00', stock: 120 }, { name: '白色 / 標準版', price: '89.00', stock: 86 } ] }"
      onsubmit="event.preventDefault(); Ta.toast.success('商品已發佈（演示）')">
    <div class="col-span-12 space-y-4 md:space-y-6 xl:col-span-8">
        <section class="@cardClass">
            <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">基本資訊</h3>
            <div class="mt-4 space-y-4">
                <div>
                    <label class="@labelClass" for="product-name">商品名稱</label>
                    <input id="product-name" type="text" class="@inputClass" placeholder="例如：無線藍牙耳機 Pro" />
                </div>
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
                    <div>
                        <label class="@labelClass" for="product-category">分類</label>
                        <select id="product-category" class="@inputClass">
                            <option value="">請選擇分類</option>
                            <option>數碼</option>
                            <option>服飾</option>
                            <option>家居</option>
                            <option>美妝</option>
                        </select>
                    </div>
                    <div>
                        <label class="@labelClass" for="product-brand">品牌</label>
                        <input id="product-brand" type="text" class="@inputClass" placeholder="例如：Alys" />
                    </div>
                    <div>
                        <label class="@labelClass" for="product-sku">主 SKU</label>
                        <input id="product-sku" type="text" class="@inputClass" placeholder="SKU-0001" />
                    </div>
                </div>
                <div>
                    <label class="@labelClass" for="product-desc">商品描述</label>
                    <textarea id="product-desc" rows="5"
                              class="w-full rounded-lg border border-gray-300 bg-transparent px-4 py-3 text-theme-sm text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800"
                              placeholder="簡要描述商品賣點與規格"></textarea>
                </div>
            </div>
        </section>

        <section class="@cardClass">
            <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">價格與庫存</h3>
            <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
                <div>
                    <label class="@labelClass" for="product-price">售價</label>
                    <input id="product-price" type="number" min="0" step="0.01" class="@inputClass" placeholder="0.00" />
                </div>
                <div>
                    <label class="@labelClass" for="product-compare">原價</label>
                    <input id="product-compare" type="number" min="0" step="0.01" class="@inputClass" placeholder="0.00" />
                </div>
                <div>
                    <label class="@labelClass" for="product-cost">成本</label>
                    <input id="product-cost" type="number" min="0" step="0.01" class="@inputClass" placeholder="0.00" />
                </div>
                <div>
                    <label class="@labelClass" for="product-stock">總庫存</label>
                    <input id="product-stock" type="number" min="0" class="@inputClass" placeholder="0" />
                </div>
            </div>
            <p class="mt-3 text-theme-xs text-gray-500 dark:text-gray-400">總庫存由下方規格庫存自動彙總；修改規格後請同步更新。</p>
        </section>

        <section class="@cardClass">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <div>
                    <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">商品規格</h3>
                    <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">每個規格對應獨立售價與庫存</p>
                </div>
                <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-3 py-2 text-theme-xs font-medium text-gray-700 shadow-theme-xs hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400"
                        x-on:click="variants.push({ name: '', price: '', stock: 0 })">
                    <partial name="_Icon" model="@("plus")" />
                    新增規格
                </button>
            </div>
            <div class="mt-4 overflow-x-auto custom-scrollbar">
                <table class="min-w-full">
                    <thead class="border-y border-gray-100 dark:border-gray-800">
                        <tr>
                            <th class="py-3 pr-4 text-start text-theme-xs font-medium text-gray-500 dark:text-gray-400">規格名稱</th>
                            <th class="px-4 py-3 text-start text-theme-xs font-medium text-gray-500 dark:text-gray-400">售價</th>
                            <th class="px-4 py-3 text-start text-theme-xs font-medium text-gray-500 dark:text-gray-400">庫存</th>
                            <th class="py-3 pl-4 text-end text-theme-xs font-medium text-gray-500 dark:text-gray-400">操作</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                        <template x-for="(v, vi) in variants" :key="vi">
                            <tr>
                                <td class="py-3 pr-4">
                                    <input type="text" x-model="v.name" placeholder="例如：黑色 / 標準版"
                                           class="h-10 w-full rounded-lg border border-gray-300 bg-transparent px-3 text-theme-sm text-gray-800 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
                                </td>
                                <td class="px-4 py-3">
                                    <input type="number" x-model="v.price" min="0" step="0.01"
                                           class="h-10 w-28 rounded-lg border border-gray-300 bg-transparent px-3 text-theme-sm text-gray-800 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
                                </td>
                                <td class="px-4 py-3">
                                    <input type="number" x-model.number="v.stock" min="0"
                                           class="h-10 w-24 rounded-lg border border-gray-300 bg-transparent px-3 text-theme-sm text-gray-800 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
                                </td>
                                <td class="py-3 pl-4 text-end">
                                    <button type="button" class="rounded-lg border border-red-200 px-3 py-1.5 text-theme-xs font-medium text-red-600 hover:bg-red-50 dark:border-red-500/30 dark:text-red-400 dark:hover:bg-red-500/10"
                                            x-on:click="variants.splice(vi, 1)">移除</button>
                                </td>
                            </tr>
                        </template>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="@cardClass">
            <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">搜尋引擎優化</h3>
            <div class="mt-4 space-y-4">
                <div>
                    <label class="@labelClass" for="product-slug">URL 代稱</label>
                    <input id="product-slug" type="text" class="@inputClass" placeholder="wireless-earbuds-pro" />
                </div>
                <div>
                    <label class="@labelClass" for="product-meta-title">Meta 標題</label>
                    <input id="product-meta-title" type="text" class="@inputClass" placeholder="無線藍牙耳機 Pro｜主動降噪 · 36 小時續航" />
                </div>
                <div>
                    <label class="@labelClass" for="product-meta-desc">Meta 描述</label>
                    <textarea id="product-meta-desc" rows="3"
                              class="w-full rounded-lg border border-gray-300 bg-transparent px-4 py-3 text-theme-sm text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800"
                              placeholder="用 80 字內說明商品特色與適用場景"></textarea>
                </div>
            </div>
        </section>
    </div>

    <div class="col-span-12 space-y-4 md:space-y-6 xl:col-span-4">
        <section class="@cardClass">
            <div class="flex items-center justify-between">
                <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">商品圖片</h3>
                <span class="text-theme-xs text-gray-500 dark:text-gray-400">3 / 6</span>
            </div>
            <div class="mt-4 grid grid-cols-3 gap-2">
                <div class="group relative aspect-square overflow-hidden rounded-lg bg-gradient-to-br from-brand-100 to-brand-50 dark:from-brand-500/25 dark:to-brand-500/5">
                    <span class="absolute bottom-1 left-1 rounded bg-white/80 px-1.5 py-0.5 text-[10px] font-medium text-gray-700 dark:bg-black/40 dark:text-gray-200">主圖</span>
                </div>
                <div class="group relative aspect-square overflow-hidden rounded-lg bg-gradient-to-br from-gray-100 to-gray-50 dark:from-white/10 dark:to-white/5">
                    <span class="absolute bottom-1 left-1 rounded bg-white/80 px-1.5 py-0.5 text-[10px] font-medium text-gray-700 dark:bg-black/40 dark:text-gray-200">側面</span>
                </div>
                <div class="group relative aspect-square overflow-hidden rounded-lg bg-gradient-to-br from-amber-100 to-amber-50 dark:from-amber-500/20 dark:to-amber-500/5">
                    <span class="absolute bottom-1 left-1 rounded bg-white/80 px-1.5 py-0.5 text-[10px] font-medium text-gray-700 dark:bg-black/40 dark:text-gray-200">細節</span>
                </div>
            </div>
            <label class="mt-3 flex cursor-pointer flex-col items-center justify-center gap-2 rounded-xl border border-dashed border-gray-300 px-4 py-6 text-center transition-colors hover:border-brand-300 hover:bg-brand-50/40 dark:border-gray-700 dark:hover:border-brand-800 dark:hover:bg-brand-500/5">
                <span class="flex size-10 items-center justify-center rounded-full bg-gray-100 text-gray-400 dark:bg-white/5 dark:text-gray-500">
                    <partial name="_Icon" model="@("upload")" />
                </span>
                <span class="text-theme-sm font-medium text-gray-700 dark:text-gray-300">點擊或拖拽上傳</span>
                <span class="text-theme-xs text-gray-500 dark:text-gray-400">PNG / JPG，單檔 5MB 以內</span>
                <input type="file" class="sr-only" accept="image/*" multiple />
            </label>
        </section>

        <section class="@cardClass">
            <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">發佈設定</h3>
            <div class="mt-4 space-y-4">
                <div>
                    <label class="@labelClass" for="product-status">狀態</label>
                    <select id="product-status" class="@inputClass" x-model="status">
                        <option value="now">立即上架</option>
                        <option value="draft">草稿</option>
                        <option value="scheduled">定時上架</option>
                    </select>
                </div>
                <div x-show="status === 'scheduled'" x-cloak>
                    <label class="@labelClass" for="product-publish-at">上架時間</label>
                    <input id="product-publish-at" type="datetime-local" class="@inputClass" />
                </div>
                <div>
                    <label class="@labelClass" for="product-tags">標籤</label>
                    <input id="product-tags" type="text" class="@inputClass" placeholder="降噪, 長續航, 新品" />
                </div>
                <label class="flex items-center justify-between gap-3 text-theme-sm text-gray-700 dark:text-gray-300">
                    首頁推薦
                    <input type="checkbox" class="peer sr-only" checked />
                    <span class="relative h-6 w-11 rounded-full bg-gray-200 transition-colors after:absolute after:top-0.5 after:left-0.5 after:size-5 after:rounded-full after:bg-white after:transition-transform after:content-[''] peer-checked:bg-brand-500 peer-checked:after:translate-x-5 dark:bg-gray-700"></span>
                </label>
                <label class="flex items-center justify-between gap-3 text-theme-sm text-gray-700 dark:text-gray-300">
                    允許評論
                    <input type="checkbox" class="peer sr-only" checked />
                    <span class="relative h-6 w-11 rounded-full bg-gray-200 transition-colors after:absolute after:top-0.5 after:left-0.5 after:size-5 after:rounded-full after:bg-white after:transition-transform after:content-[''] peer-checked:bg-brand-500 peer-checked:after:translate-x-5 dark:bg-gray-700"></span>
                </label>
            </div>
        </section>

        <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
            <a asp-area="Admin" asp-controller="Ecommerce" asp-action="Products"
               class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-theme-sm font-medium text-gray-700 shadow-theme-xs transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400">取消</a>
            <button type="button"
                    class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-theme-sm font-medium text-gray-700 shadow-theme-xs transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400"
                    onclick="Ta.toast.success('已存為草稿（演示）')">存草稿</button>
            <button type="submit"
                    class="inline-flex items-center justify-center gap-2 rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white shadow-theme-xs transition-colors hover:bg-brand-600">
                <partial name="_Icon" model="@("check")" />
                發佈商品
            </button>
        </div>
    </div>
</form>
