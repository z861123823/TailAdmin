@{
    var invoices = new[]
    {
        new { No = "INV-2026-0042", Customer = "宏遠科技", Date = "2026-11-21", Due = "2026-12-05", Amount = "$4,820.00", Status = "已付款", Key = "paid", Variant = "success" },
        new { No = "INV-2026-0041", Customer = "星海貿易", Date = "2026-11-18", Due = "2026-12-02", Amount = "$2,360.00", Status = "待付款", Key = "pending", Variant = "warning" },
        new { No = "INV-2026-0040", Customer = "光點設計", Date = "2026-11-15", Due = "2026-11-29", Amount = "$1,280.00", Status = "待付款", Key = "pending", Variant = "warning" },
        new { No = "INV-2026-0039", Customer = "南灣餐飲", Date = "2026-11-12", Due = "2026-11-26", Amount = "$980.00", Status = "已付款", Key = "paid", Variant = "success" },
        new { No = "INV-2026-0038", Customer = "遠景物流", Date = "2026-11-08", Due = "2026-11-22", Amount = "$6,420.00", Status = "逾期", Key = "overdue", Variant = "danger" },
        new { No = "INV-2026-0037", Customer = "宏遠科技", Date = "2026-11-01", Due = "2026-11-15", Amount = "$4,820.00", Status = "已付款", Key = "paid", Variant = "success" },
        new { No = "INV-2026-0036", Customer = "新光零售", Date = "2026-10-28", Due = "2026-11-11", Amount = "$3,140.00", Status = "已付款", Key = "paid", Variant = "success" },
        new { No = "INV-2026-0035", Customer = "青禾文創", Date = "2026-10-24", Due = "2026-11-07", Amount = "$1,760.00", Status = "逾期", Key = "overdue", Variant = "danger" }
    };
}
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4 md:gap-6">
    <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
        <p class="text-theme-sm text-gray-500 dark:text-gray-400">已開票金額</p>
        <p class="mt-2 text-2xl font-semibold text-gray-800 dark:text-white/90">$48,200</p>
        <p class="mt-1 text-theme-xs text-green-600 dark:text-green-400">↑ 6.2% 較上月</p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
        <p class="text-theme-sm text-gray-500 dark:text-gray-400">待付款</p>
        <p class="mt-2 text-2xl font-semibold text-amber-600 dark:text-amber-400">6</p>
        <p class="mt-1 text-theme-xs text-gray-500 dark:text-gray-400">合計 $12,860</p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
        <p class="text-theme-sm text-gray-500 dark:text-gray-400">逾期</p>
        <p class="mt-2 text-2xl font-semibold text-red-600 dark:text-red-400">2</p>
        <p class="mt-1 text-theme-xs text-red-600 dark:text-red-400">需催收</p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
        <p class="text-theme-sm text-gray-500 dark:text-gray-400">本月新增</p>
        <p class="mt-2 text-2xl font-semibold text-gray-800 dark:text-white/90">12</p>
        <p class="mt-1 text-theme-xs text-gray-500 dark:text-gray-400">較上月 +3</p>
    </div>
</div>

<div class="mt-4 flex flex-wrap items-center justify-between gap-3 md:mt-6">
    <div class="flex flex-wrap items-center gap-2">
        <input type="text" placeholder="搜索發票編號或客戶"
               class="h-10 w-56 rounded-lg border border-gray-300 bg-transparent px-3 py-2 text-theme-sm text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800" />
        <select class="h-10 rounded-lg border border-gray-300 bg-transparent px-3 py-2 text-theme-sm text-gray-700 shadow-theme-xs focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-gray-300">
            <option>全部狀態</option>
            <option>已付款</option>
            <option>待付款</option>
            <option>逾期</option>
        </select>
    </div>
    <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-theme-sm font-medium text-gray-700 shadow-theme-xs hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400"
            onclick="Ta.toast.info('匯出發票（演示）')">
        <partial name="_Icon" model="@("upload")" />
        匯出
    </button>
</div>

<section class="mt-4 overflow-hidden rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
    <div class="max-w-full overflow-x-auto custom-scrollbar">
        <table class="min-w-full">
            <thead class="border-b border-gray-100 dark:border-gray-800">
                <tr>
                    <th class="px-5 py-3 text-start text-theme-xs font-medium whitespace-nowrap text-gray-500 dark:text-gray-400">發票編號</th>
                    <th class="px-5 py-3 text-start text-theme-xs font-medium whitespace-nowrap text-gray-500 dark:text-gray-400">客戶</th>
                    <th class="px-5 py-3 text-start text-theme-xs font-medium whitespace-nowrap text-gray-500 dark:text-gray-400">開票日期</th>
                    <th class="px-5 py-3 text-start text-theme-xs font-medium whitespace-nowrap text-gray-500 dark:text-gray-400">到期日</th>
                    <th class="px-5 py-3 text-end text-theme-xs font-medium whitespace-nowrap text-gray-500 dark:text-gray-400">金額</th>
                    <th class="px-5 py-3 text-start text-theme-xs font-medium whitespace-nowrap text-gray-500 dark:text-gray-400">狀態</th>
                    <th class="px-5 py-3 text-end text-theme-xs font-medium whitespace-nowrap text-gray-500 dark:text-gray-400">操作</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                @foreach (var invoice in invoices)
                {
                    var badge = new TaBadgeModel { Text = invoice.Status, Variant = invoice.Variant, Dot = true };
                    <tr class="transition-colors hover:bg-gray-50 dark:hover:bg-white/[0.02]">
                        <td class="px-5 py-4 text-theme-sm font-medium whitespace-nowrap text-gray-800 dark:text-white/90">@invoice.No</td>
                        <td class="px-5 py-4 text-theme-sm whitespace-nowrap text-gray-600 dark:text-gray-400">@invoice.Customer</td>
                        <td class="px-5 py-4 text-theme-sm whitespace-nowrap text-gray-500 dark:text-gray-400">@invoice.Date</td>
                        <td class="px-5 py-4 text-theme-sm whitespace-nowrap text-gray-500 dark:text-gray-400">@invoice.Due</td>
                        <td class="px-5 py-4 text-right text-theme-sm whitespace-nowrap text-gray-800 dark:text-gray-300">@invoice.Amount</td>
                        <td class="px-5 py-4"><partial name="_TaBadge" model="badge" /></td>
                        <td class="px-5 py-4">
                            <div class="flex justify-end gap-2">
                                <a asp-area="Admin" asp-controller="Ecommerce" asp-action="InvoiceDetail" asp-route-id="@invoice.No"
                                   class="rounded-lg border border-gray-300 px-3 py-1.5 text-theme-xs font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-white/5">查看</a>
                                <button type="button" class="rounded-lg border border-gray-300 px-3 py-1.5 text-theme-xs font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-white/5"
                                        onclick="Ta.toast.success('已下載 PDF（演示）')">下載</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-gray-100 px-5 py-4 dark:border-gray-800">
        <p class="text-theme-xs text-gray-500 dark:text-gray-400">共 8 張發票</p>
        <div class="flex items-center gap-1">
            <button type="button" class="rounded-lg border border-gray-300 px-3 py-1.5 text-theme-xs text-gray-500 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400" disabled>上一頁</button>
            <span class="rounded-lg bg-brand-500 px-3 py-1.5 text-theme-xs font-medium text-white">1</span>
            <button type="button" class="rounded-lg border border-gray-300 px-3 py-1.5 text-theme-xs text-gray-600 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400">下一頁</button>
        </div>
    </div>
</section>
