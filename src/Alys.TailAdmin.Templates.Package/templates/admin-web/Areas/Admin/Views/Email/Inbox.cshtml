<div class="grid grid-cols-1 gap-4 md:gap-6 xl:grid-cols-12"
     x-data="{
        active: 0,
        folder: 'inbox',
        reply: '',
        mails: [
            { from: '陳小明', initials: '陳', subject: '關於 11 月促銷活動的排期確認', preview: '想跟你確認一下雙十一活動的素材上線時間…', time: '10:24', unread: true, starred: true, tag: '工作', tagClass: 'bg-brand-50 text-brand-600 dark:bg-brand-500/15 dark:text-brand-400',
              body: ['你好，', '想跟你確認一下雙十一活動的素材上線時間。目前主視覺、商品長圖與短視頻都已準備完成，計劃在 11 月 5 日統一上線。', '如果排期沒有問題，我會安排設計同學在 11 月 3 日前完成最後一輪校對。請確認是否可以按此時間推進。', '謝謝！'],
              attachments: ['活動排期.xlsx', '主視覺.jpg'] },
            { from: '林小姐', initials: '林', subject: '商品圖片規格更新通知', preview: '新版主圖需要 1200×1200，請協助替換…', time: '09:12', unread: true, starred: false, tag: '通知', tagClass: 'bg-amber-50 text-amber-600 dark:bg-amber-500/15 dark:text-amber-400',
              body: ['新版主圖需要 1200×1200，請協助替換目前 800×800 的商品圖。', '本次更新涉及 36 個 SKU，建議使用批次上傳工具處理。'],
              attachments: ['規格說明.pdf'] },
            { from: '系統通知', initials: '系', subject: '本週營運週報已生成', preview: '本週銷售額環比增長 8.6%，退貨率下降…', time: '昨天', unread: false, starred: true, tag: '報告', tagClass: 'bg-green-50 text-green-600 dark:bg-green-500/15 dark:text-green-400',
              body: ['本週銷售額環比增長 8.6%，退貨率下降 1.2 個百分點，客單價保持穩定。', '詳細報表可在「圖表」模組查看。'],
              attachments: ['週報-11W3.pdf'] },
            { from: '王先生', initials: '王', subject: '供應商合約續簽事宜', preview: '合約將於下月到期，請安排時間溝通…', time: '昨天', unread: false, starred: false, tag: '工作', tagClass: 'bg-brand-50 text-brand-600 dark:bg-brand-500/15 dark:text-brand-400',
              body: ['合約將於下月到期，請安排時間溝通續簽條款，主要涉及帳期與返點比例。'],
              attachments: [] },
            { from: '客服中心', initials: '客', subject: '高優先級工單提醒', preview: '有 3 張高優先級工單等待處理…', time: '週一', unread: false, starred: false, tag: '提醒', tagClass: 'bg-red-50 text-red-600 dark:bg-red-500/15 dark:text-red-400',
              body: ['有 3 張高優先級工單等待處理，請前往「客服 → 支援工單」查看。'],
              attachments: [] }
        ]
     }">
    <aside class="hidden rounded-2xl border border-gray-200 bg-white p-3 xl:col-span-2 xl:block dark:border-gray-800 dark:bg-white/[0.03]">
        <button type="button" class="flex w-full items-center justify-center gap-2 rounded-lg bg-brand-500 px-3 py-2.5 text-theme-sm font-medium text-white shadow-theme-xs hover:bg-brand-600"
                onclick="Ta.toast.info('寫信（演示）')">
            <partial name="_Icon" model="@("plus")" />
            寫信
        </button>
        <nav class="mt-3 space-y-1">
            <button type="button" class="flex w-full items-center justify-between rounded-lg px-3 py-2 text-theme-sm font-medium transition-colors"
                    x-bind:class="folder === 'inbox' ? 'bg-brand-50 text-brand-600 dark:bg-brand-500/15 dark:text-brand-400' : 'text-gray-600 hover:bg-gray-50 dark:text-gray-400 dark:hover:bg-white/5'"
                    x-on:click="folder = 'inbox'">
                <span class="inline-flex items-center gap-2"><partial name="_Icon" model="@("mail")" />收件箱</span>
                <span class="text-theme-xs">5</span>
            </button>
            <button type="button" class="flex w-full items-center justify-between rounded-lg px-3 py-2 text-theme-sm font-medium transition-colors"
                    x-bind:class="folder === 'starred' ? 'bg-brand-50 text-brand-600 dark:bg-brand-500/15 dark:text-brand-400' : 'text-gray-600 hover:bg-gray-50 dark:text-gray-400 dark:hover:bg-white/5'"
                    x-on:click="folder = 'starred'">
                <span class="inline-flex items-center gap-2"><partial name="_Icon" model="@("check")" />已加星</span>
                <span class="text-theme-xs">2</span>
            </button>
            <button type="button" class="flex w-full items-center justify-between rounded-lg px-3 py-2 text-theme-sm font-medium text-gray-600 hover:bg-gray-50 dark:text-gray-400 dark:hover:bg-white/5" onclick="Ta.toast.info('草稿（演示）')">
                <span class="inline-flex items-center gap-2"><partial name="_Icon" model="@("pencil")" />草稿</span>
                <span class="text-theme-xs">2</span>
            </button>
            <button type="button" class="flex w-full items-center justify-between rounded-lg px-3 py-2 text-theme-sm font-medium text-gray-600 hover:bg-gray-50 dark:text-gray-400 dark:hover:bg-white/5" onclick="Ta.toast.info('已發送（演示）')">
                <span class="inline-flex items-center gap-2"><partial name="_Icon" model="@("upload")" />已發送</span>
            </button>
            <button type="button" class="flex w-full items-center justify-between rounded-lg px-3 py-2 text-theme-sm font-medium text-gray-600 hover:bg-gray-50 dark:text-gray-400 dark:hover:bg-white/5" onclick="Ta.toast.info('垃圾郵件（演示）')">
                <span class="inline-flex items-center gap-2"><partial name="_Icon" model="@("trash")" />垃圾郵件</span>
                <span class="text-theme-xs">18</span>
            </button>
        </nav>
    </aside>

    <section class="overflow-hidden rounded-2xl border border-gray-200 bg-white xl:col-span-4 dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="border-b border-gray-100 p-4 dark:border-gray-800">
            <div class="flex items-center gap-2">
                <input type="text" placeholder="搜索郵件"
                       class="h-10 w-full rounded-lg border border-gray-300 bg-transparent px-3 py-2 text-theme-sm text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800" />
                <button type="button" class="inline-flex size-10 shrink-0 items-center justify-center rounded-lg border border-gray-300 text-gray-500 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-white/5" aria-label="重新整理"
                        onclick="Ta.toast.success('已重新整理（演示）')">
                    <partial name="_Icon" model="@("refresh")" />
                </button>
            </div>
        </div>
        <ul class="divide-y divide-gray-100 dark:divide-gray-800">
            <template x-for="(m, index) in mails" :key="index">
                <li x-show="folder === 'inbox' || m.starred">
                    <button type="button" class="flex w-full items-start gap-3 px-4 py-3.5 text-left transition-colors hover:bg-gray-50 dark:hover:bg-white/[0.02]"
                            x-bind:class="active === index ? 'bg-brand-50/60 dark:bg-brand-500/5' : ''"
                            x-on:click="active = index; m.unread = false">
                        <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-brand-50 text-theme-sm font-semibold text-brand-600 dark:bg-brand-500/15 dark:text-brand-400" x-text="m.initials"></span>
                        <span class="min-w-0 flex-1">
                            <span class="flex items-center justify-between gap-2">
                                <span class="truncate text-theme-sm" x-bind:class="m.unread ? 'font-semibold text-gray-800 dark:text-white/90' : 'font-medium text-gray-700 dark:text-gray-300'" x-text="m.from"></span>
                                <span class="shrink-0 text-theme-xs text-gray-400 dark:text-gray-500" x-text="m.time"></span>
                            </span>
                            <span class="mt-0.5 block truncate text-theme-sm" x-bind:class="m.unread ? 'font-medium text-gray-800 dark:text-white/90' : 'text-gray-600 dark:text-gray-400'" x-text="m.subject"></span>
                            <span class="mt-0.5 block truncate text-theme-xs text-gray-500 dark:text-gray-400" x-text="m.preview"></span>
                            <span class="mt-1.5 flex items-center gap-2">
                                <span class="rounded-full px-2 py-0.5 text-[10px] font-medium" x-bind:class="m.tagClass" x-text="m.tag"></span>
                                <span class="text-[10px] text-gray-400" x-show="m.attachments.length > 0" x-text="m.attachments.length + ' 個附件'"></span>
                            </span>
                        </span>
                        <span class="flex flex-col items-center gap-2">
                            <span class="text-theme-xs" x-bind:class="m.starred ? 'text-amber-400' : 'text-gray-300 dark:text-gray-600'"
                                  x-on:click.stop="m.starred = !m.starred" x-text="m.starred ? '★' : '☆'"></span>
                            <span class="size-2 rounded-full bg-brand-500" x-show="m.unread"></span>
                        </span>
                    </button>
                </li>
            </template>
        </ul>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white xl:col-span-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="flex flex-wrap items-start justify-between gap-3 border-b border-gray-100 px-5 py-4 dark:border-gray-800">
            <div class="min-w-0">
                <h3 class="truncate text-base font-semibold text-gray-800 dark:text-white/90" x-text="mails[active].subject"></h3>
                <p class="mt-1 text-theme-xs text-gray-500 dark:text-gray-400">
                    <span x-text="mails[active].from"></span> · <span x-text="mails[active].time"></span>
                </p>
            </div>
            <div class="flex shrink-0 gap-2">
                <button type="button" class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-theme-xs font-medium text-gray-700 shadow-theme-xs hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400" onclick="Ta.toast.info('回覆（演示）')">回覆</button>
                <button type="button" class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-theme-xs font-medium text-gray-700 shadow-theme-xs hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400" onclick="Ta.toast.info('轉發（演示）')">轉發</button>
                <button type="button" class="rounded-lg border border-red-200 px-3 py-2 text-theme-xs font-medium text-red-600 hover:bg-red-50 dark:border-red-500/30 dark:text-red-400 dark:hover:bg-red-500/10"
                        onclick="Ta.confirm({ title: '刪除郵件', text: '確定將此郵件移到垃圾郵件？', confirmText: '刪除', danger: true }).then(function(ok){ if (ok) Ta.toast.success('已刪除（演示）'); })">刪除</button>
            </div>
        </div>

        <div class="space-y-3 px-5 py-5 text-theme-sm leading-6 text-gray-600 md:px-6 dark:text-gray-400">
            <template x-for="(p, pi) in mails[active].body" :key="pi">
                <p x-text="p"></p>
            </template>
            <div class="flex flex-wrap gap-2 pt-2" x-show="mails[active].attachments.length > 0">
                <template x-for="(a, ai) in mails[active].attachments" :key="ai">
                    <span class="inline-flex items-center gap-2 rounded-lg border border-gray-200 px-3 py-2 text-theme-xs text-gray-700 dark:border-gray-700 dark:text-gray-300">
                        <partial name="_Icon" model="@("upload")" />
                        <span x-text="a"></span>
                    </span>
                </template>
            </div>
        </div>

        <div class="border-t border-gray-100 px-5 py-4 dark:border-gray-800">
            <textarea rows="3" x-model="reply" placeholder="回覆這封郵件…"
                      class="w-full rounded-xl border border-gray-300 bg-transparent px-4 py-3 text-theme-sm text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800"></textarea>
            <div class="mt-3 flex items-center justify-between">
                <button type="button" class="inline-flex items-center gap-2 text-theme-xs text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300"
                        onclick="Ta.toast.info('附加檔案（演示）')">
                    <partial name="_Icon" model="@("upload")" />
                    附加檔案
                </button>
                <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white shadow-theme-xs hover:bg-brand-600 disabled:opacity-50"
                        x-bind:disabled="!reply.trim()"
                        x-on:click="Ta.toast.success('回覆已發送（演示）'); reply = ''">發送</button>
            </div>
        </div>
    </section>
</div>
