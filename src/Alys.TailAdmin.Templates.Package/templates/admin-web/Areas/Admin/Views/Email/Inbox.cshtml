@{
    var mails = new[]
    {
        new { Id = 1, From = "陳小明", Initials = "陳", Subject = "關於 11 月促銷活動的排期確認", Preview = "想跟你確認一下雙十一活動的素材上線時間…", Time = "10:24", Unread = true },
        new { Id = 2, From = "林小姐", Initials = "林", Subject = "商品圖片規格更新通知", Preview = "新版主圖需要 1200×1200，請協助替換…", Time = "09:12", Unread = true },
        new { Id = 3, From = "系統通知", Initials = "系", Subject = "本週營運週報已生成", Preview = "本週銷售額環比增長 8.6%，退貨率下降…", Time = "昨天", Unread = false },
        new { Id = 4, From = "王先生", Initials = "王", Subject = "供應商合約續簽事宜", Preview = "合約將於下月到期，請安排時間溝通…", Time = "昨天", Unread = false },
        new { Id = 5, From = "客服中心", Initials = "客", Subject = "高優先級工單提醒", Preview = "有 3 張高優先級工單等待處理…", Time = "週一", Unread = false }
    };
}
<div x-data="{ active: 1 }" class="grid grid-cols-1 gap-4 md:gap-6 xl:grid-cols-12">
    <section class="overflow-hidden rounded-2xl border border-gray-200 bg-white xl:col-span-5 dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="flex items-center justify-between border-b border-gray-100 px-5 py-4 dark:border-gray-800">
            <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">收件箱</h3>
            <button type="button" class="inline-flex items-center gap-2 rounded-lg bg-brand-500 px-3 py-2 text-theme-xs font-medium text-white shadow-theme-xs hover:bg-brand-600"
                    onclick="Ta.toast.info('寫信（演示）')">
                <partial name="_Icon" model="@("plus")" />
                寫信
            </button>
        </div>
        <ul class="divide-y divide-gray-100 dark:divide-gray-800">
            @foreach (var mail in mails)
            {
                var avatar = new TaAvatarModel { Initials = mail.Initials, Size = "md" };
                <li>
                    <button type="button" class="flex w-full items-start gap-3 px-5 py-4 text-left transition-colors hover:bg-gray-50 dark:hover:bg-white/[0.02]"
                            x-bind:class="active === @mail.Id ? 'bg-brand-50/60 dark:bg-brand-500/5' : ''"
                            x-on:click="active = @mail.Id">
                        <partial name="_TaAvatar" model="avatar" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center justify-between gap-2">
                                <span class="truncate text-theme-sm @(mail.Unread ? "font-semibold text-gray-800 dark:text-white/90" : "font-medium text-gray-700 dark:text-gray-300")">@mail.From</span>
                                <span class="shrink-0 text-theme-xs text-gray-400 dark:text-gray-500">@mail.Time</span>
                            </div>
                            <p class="mt-0.5 truncate text-theme-sm @(mail.Unread ? "font-medium text-gray-800 dark:text-white/90" : "text-gray-600 dark:text-gray-400")">@mail.Subject</p>
                            <p class="mt-0.5 truncate text-theme-xs text-gray-500 dark:text-gray-400">@mail.Preview</p>
                        </div>
                        @if (mail.Unread)
                        {
                            <span class="mt-1.5 size-2 shrink-0 rounded-full bg-brand-500"></span>
                        }
                    </button>
                </li>
            }
        </ul>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white xl:col-span-7 dark:border-gray-800 dark:bg-white/[0.03]">
        <div x-show="active === 1">
            <div class="flex flex-wrap items-start justify-between gap-3 border-b border-gray-100 px-5 py-4 md:px-6 dark:border-gray-800">
                <div>
                    <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">關於 11 月促銷活動的排期確認</h3>
                    <p class="mt-1 text-theme-xs text-gray-500 dark:text-gray-400">陳小明 · 2026-11-23 10:24</p>
                </div>
                <div class="flex gap-2">
                    <button type="button" class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-theme-xs font-medium text-gray-700 shadow-theme-xs hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400" onclick="Ta.toast.info('回覆（演示）')">回覆</button>
                    <button type="button" class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-theme-xs font-medium text-gray-700 shadow-theme-xs hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400" onclick="Ta.toast.info('轉發（演示）')">轉發</button>
                </div>
            </div>
            <div class="space-y-3 px-5 py-5 text-theme-sm leading-6 text-gray-600 md:px-6 dark:text-gray-400">
                <p>你好，</p>
                <p>想跟你確認一下雙十一活動的素材上線時間。目前主視覺、商品長圖與短視頻都已準備完成，計劃在 11 月 5 日統一上線。</p>
                <p>如果排期沒有問題，我會安排設計同學在 11 月 3 日前完成最後一輪校對。請確認是否可以按此時間推進。</p>
                <p>謝謝！</p>
            </div>
        </div>
        <div x-show="active === 2" x-cloak>
            <div class="border-b border-gray-100 px-5 py-4 md:px-6 dark:border-gray-800">
                <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">商品圖片規格更新通知</h3>
                <p class="mt-1 text-theme-xs text-gray-500 dark:text-gray-400">林小姐 · 2026-11-23 09:12</p>
            </div>
            <div class="space-y-3 px-5 py-5 text-theme-sm leading-6 text-gray-600 md:px-6 dark:text-gray-400">
                <p>新版主圖需要 1200×1200，請協助替換目前 800×800 的商品圖。</p>
                <p>本次更新涉及 36 個 SKU，建議使用批次上傳工具處理。</p>
            </div>
        </div>
        <div x-show="active === 3" x-cloak>
            <div class="border-b border-gray-100 px-5 py-4 md:px-6 dark:border-gray-800">
                <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">本週營運週報已生成</h3>
                <p class="mt-1 text-theme-xs text-gray-500 dark:text-gray-400">系統通知 · 昨天 18:00</p>
            </div>
            <div class="space-y-3 px-5 py-5 text-theme-sm leading-6 text-gray-600 md:px-6 dark:text-gray-400">
                <p>本週銷售額環比增長 8.6%，退貨率下降 1.2 個百分點，客單價保持穩定。</p>
                <p>詳細報表可在「圖表」模組查看。</p>
            </div>
        </div>
        <div x-show="active === 4" x-cloak>
            <div class="border-b border-gray-100 px-5 py-4 md:px-6 dark:border-gray-800">
                <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">供應商合約續簽事宜</h3>
                <p class="mt-1 text-theme-xs text-gray-500 dark:text-gray-400">王先生 · 昨天 15:40</p>
            </div>
            <div class="space-y-3 px-5 py-5 text-theme-sm leading-6 text-gray-600 md:px-6 dark:text-gray-400">
                <p>合約將於下月到期，請安排時間溝通續簽條款，主要涉及帳期與返點比例。</p>
            </div>
        </div>
        <div x-show="active === 5" x-cloak>
            <div class="border-b border-gray-100 px-5 py-4 md:px-6 dark:border-gray-800">
                <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">高優先級工單提醒</h3>
                <p class="mt-1 text-theme-xs text-gray-500 dark:text-gray-400">客服中心 · 週一 11:05</p>
            </div>
            <div class="space-y-3 px-5 py-5 text-theme-sm leading-6 text-gray-600 md:px-6 dark:text-gray-400">
                <p>有 3 張高優先級工單等待處理，請前往「客服 → 支援工單」查看。</p>
            </div>
        </div>
    </section>
</div>
