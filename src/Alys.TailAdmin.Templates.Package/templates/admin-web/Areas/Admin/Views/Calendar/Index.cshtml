@{
    var year = (int)(ViewData["Year"] ?? DateTime.Today.Year);
    var month = (int)(ViewData["Month"] ?? DateTime.Today.Month);
    var first = new DateTime(year, month, 1);
    var offset = ((int)first.DayOfWeek + 6) % 7;
    var start = first.AddDays(-offset);
    var today = DateTime.Today;
    var prevMonth = first.AddMonths(-1);
    var nextMonth = first.AddMonths(1);
    var weekdays = new[] { "一", "二", "三", "四", "五", "六", "日" };
    var events = new Dictionary<int, List<(string Title, string Tone)>>
    {
        [3] = new() { ("產品評審", "brand") },
        [7] = new() { ("月度例會", "green") },
        [11] = new() { ("供應商洽談", "amber") },
        [15] = new() { ("版本發佈", "brand"), ("客戶回訪", "green") },
        [19] = new() { ("團隊建設", "brand") },
        [23] = new() { ("季度總結", "red") },
        [27] = new() { ("庫存盤點", "amber") }
    };
    string ToneClass(string tone) => tone switch
    {
        "green" => "bg-green-50 text-green-600 dark:bg-green-500/15 dark:text-green-400",
        "amber" => "bg-amber-50 text-amber-600 dark:bg-amber-500/15 dark:text-amber-400",
        "red" => "bg-red-50 text-red-600 dark:bg-red-500/15 dark:text-red-400",
        _ => "bg-brand-50 text-brand-600 dark:bg-brand-500/15 dark:text-brand-400"
    };
}
<div class="grid grid-cols-1 gap-4 md:gap-6 xl:grid-cols-12">
    <section class="overflow-hidden rounded-2xl border border-gray-200 bg-white xl:col-span-9 dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-100 px-5 py-4 md:px-6 dark:border-gray-800">
            <div class="flex items-center gap-3">
                <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">@($"{year} 年 {month} 月")</h3>
                <a asp-area="Admin" asp-controller="Calendar" asp-action="Index"
                   class="rounded-lg border border-gray-300 bg-white px-2.5 py-1 text-theme-xs font-medium text-gray-700 shadow-theme-xs transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400">今天</a>
            </div>
            <div class="flex items-center gap-2">
                <a asp-area="Admin" asp-controller="Calendar" asp-action="Index" asp-route-year="@prevMonth.Year" asp-route-month="@prevMonth.Month"
                   class="inline-flex size-9 items-center justify-center rounded-lg border border-gray-300 bg-white text-gray-700 shadow-theme-xs transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400" aria-label="上個月">
                    <partial name="_Icon" model="@("chevron-left")" />
                </a>
                <a asp-area="Admin" asp-controller="Calendar" asp-action="Index" asp-route-year="@nextMonth.Year" asp-route-month="@nextMonth.Month"
                   class="inline-flex size-9 items-center justify-center rounded-lg border border-gray-300 bg-white text-gray-700 shadow-theme-xs transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400" aria-label="下個月">
                    <partial name="_Icon" model="@("chevron-right")" />
                </a>
            </div>
        </div>

        <div class="grid grid-cols-7 border-b border-gray-100 bg-gray-50/60 dark:border-gray-800 dark:bg-white/[0.02]">
            @foreach (var weekday in weekdays)
            {
                <div class="px-2 py-2.5 text-center text-theme-xs font-medium text-gray-500 dark:text-gray-400">@weekday</div>
            }
        </div>

        <div class="grid grid-cols-7">
            @for (var index = 0; index < 42; index++)
            {
                var date = start.AddDays(index);
                var inMonth = date.Month == month;
                var isToday = date.Date == today;
                var dayEvents = inMonth && events.TryGetValue(date.Day, out var list)
                    ? list
                    : new List<(string Title, string Tone)>();
                <div class="min-h-24 border-r border-b border-gray-100 p-2 last:border-r-0 md:min-h-28 dark:border-gray-800 @(inMonth ? null : "bg-gray-50/40 dark:bg-white/[0.01]")">
                    <span class="inline-flex size-6 items-center justify-center rounded-full text-theme-xs font-medium @(isToday ? "bg-brand-500 text-white" : inMonth ? "text-gray-700 dark:text-gray-300" : "text-gray-400 dark:text-gray-600")">@date.Day</span>
                    <div class="mt-1 space-y-1">
                        @foreach (var item in dayEvents)
                        {
                            <p class="truncate rounded px-1.5 py-0.5 text-[10px] font-medium @ToneClass(item.Tone)">@item.Title</p>
                        }
                    </div>
                </div>
            }
        </div>
    </section>

    <aside class="space-y-4 md:space-y-6 xl:col-span-3">
        <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
            <div class="flex items-center justify-between">
                <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">即將到來</h3>
                <button type="button"
                        class="inline-flex size-8 items-center justify-center rounded-lg bg-brand-50 text-brand-500 transition-colors hover:bg-brand-100 dark:bg-brand-500/15 dark:text-brand-400"
                        onclick="Ta.toast.info('新增日程（演示）')" aria-label="新增日程">
                    <partial name="_Icon" model="@("plus")" />
                </button>
            </div>
            <ul class="mt-4 space-y-3">
                <li class="flex items-start gap-3">
                    <span class="mt-0.5 size-2 shrink-0 rounded-full bg-brand-500"></span>
                    <div>
                        <p class="text-theme-sm font-medium text-gray-800 dark:text-white/90">產品評審</p>
                        <p class="text-theme-xs text-gray-500 dark:text-gray-400">@($"{month} 月 3 日 · 10:00")</p>
                    </div>
                </li>
                <li class="flex items-start gap-3">
                    <span class="mt-0.5 size-2 shrink-0 rounded-full bg-green-500"></span>
                    <div>
                        <p class="text-theme-sm font-medium text-gray-800 dark:text-white/90">月度例會</p>
                        <p class="text-theme-xs text-gray-500 dark:text-gray-400">@($"{month} 月 7 日 · 14:00")</p>
                    </div>
                </li>
                <li class="flex items-start gap-3">
                    <span class="mt-0.5 size-2 shrink-0 rounded-full bg-amber-500"></span>
                    <div>
                        <p class="text-theme-sm font-medium text-gray-800 dark:text-white/90">供應商洽談</p>
                        <p class="text-theme-xs text-gray-500 dark:text-gray-400">@($"{month} 月 11 日 · 09:30")</p>
                    </div>
                </li>
                <li class="flex items-start gap-3">
                    <span class="mt-0.5 size-2 shrink-0 rounded-full bg-red-500"></span>
                    <div>
                        <p class="text-theme-sm font-medium text-gray-800 dark:text-white/90">季度總結</p>
                        <p class="text-theme-xs text-gray-500 dark:text-gray-400">@($"{month} 月 23 日 · 16:00")</p>
                    </div>
                </li>
            </ul>
        </section>

        <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
            <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">圖例</h3>
            <div class="mt-3 space-y-2 text-theme-sm text-gray-600 dark:text-gray-400">
                <p class="flex items-center gap-2"><span class="size-2 rounded-full bg-brand-500"></span>產品與版本</p>
                <p class="flex items-center gap-2"><span class="size-2 rounded-full bg-green-500"></span>會議與回訪</p>
                <p class="flex items-center gap-2"><span class="size-2 rounded-full bg-amber-500"></span>營運與庫存</p>
                <p class="flex items-center gap-2"><span class="size-2 rounded-full bg-red-500"></span>重要節點</p>
            </div>
        </section>
    </aside>
</div>
