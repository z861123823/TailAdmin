@{
    var keys = new[]
    {
        new { Name = "生產環境", Key = "sk-live-••••••••3f9a", Scopes = new[] { "chat", "embeddings" }, Created = "2026-06-12", LastUsed = "2 分鐘前", Active = true },
        new { Name = "測試環境", Key = "sk-test-••••••••7b21", Scopes = new[] { "chat" }, Created = "2026-08-03", LastUsed = "昨天", Active = true },
        new { Name = "數據分析", Key = "sk-live-••••••••c4d8", Scopes = new[] { "read" }, Created = "2026-09-18", LastUsed = "3 天前", Active = true },
        new { Name = "臨時腳本", Key = "sk-test-••••••••0e6f", Scopes = new[] { "chat", "read" }, Created = "2026-05-01", LastUsed = "2026-10-30", Active = false }
    };
}
<div class="flex flex-wrap items-center justify-between gap-3">
    <div>
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">API 金鑰</h3>
        <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">金鑰僅在建立時完整顯示一次，請妥善保管。</p>
    </div>
    <button type="button" class="inline-flex items-center gap-2 rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white shadow-theme-xs hover:bg-brand-600"
            onclick="document.getElementById('createKeyDialog').showModal()">
        <partial name="_Icon" model="@("plus")" />
        建立金鑰
    </button>
</div>

<section class="mt-4 overflow-hidden rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
    <div class="max-w-full overflow-x-auto custom-scrollbar">
        <table class="min-w-full">
            <thead class="border-b border-gray-100 dark:border-gray-800">
                <tr>
                    <th class="px-5 py-3 text-start text-theme-xs font-medium whitespace-nowrap text-gray-500 dark:text-gray-400">名稱</th>
                    <th class="px-5 py-3 text-start text-theme-xs font-medium whitespace-nowrap text-gray-500 dark:text-gray-400">金鑰</th>
                    <th class="px-5 py-3 text-start text-theme-xs font-medium whitespace-nowrap text-gray-500 dark:text-gray-400">權限範圍</th>
                    <th class="px-5 py-3 text-start text-theme-xs font-medium whitespace-nowrap text-gray-500 dark:text-gray-400">建立時間</th>
                    <th class="px-5 py-3 text-start text-theme-xs font-medium whitespace-nowrap text-gray-500 dark:text-gray-400">最近使用</th>
                    <th class="px-5 py-3 text-start text-theme-xs font-medium whitespace-nowrap text-gray-500 dark:text-gray-400">狀態</th>
                    <th class="px-5 py-3 text-end text-theme-xs font-medium whitespace-nowrap text-gray-500 dark:text-gray-400">操作</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                @foreach (var key in keys)
                {
                    var badge = key.Active
                        ? new TaBadgeModel { Text = "啟用中", Variant = "success", Dot = true }
                        : new TaBadgeModel { Text = "已撤銷", Variant = "light", Dot = true };
                    <tr class="transition-colors hover:bg-gray-50 dark:hover:bg-white/[0.02]">
                        <td class="px-5 py-4 text-theme-sm font-medium whitespace-nowrap text-gray-800 dark:text-white/90">@key.Name</td>
                        <td class="px-5 py-4 text-theme-sm whitespace-nowrap font-mono text-gray-600 dark:text-gray-400">@key.Key</td>
                        <td class="px-5 py-4">
                            <div class="flex flex-wrap gap-1.5">
                                @foreach (var scope in key.Scopes)
                                {
                                    <span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-0.5 font-mono text-[11px] text-gray-600 dark:bg-white/10 dark:text-gray-300">@scope</span>
                                }
                            </div>
                        </td>
                        <td class="px-5 py-4 text-theme-sm whitespace-nowrap text-gray-500 dark:text-gray-400">@key.Created</td>
                        <td class="px-5 py-4 text-theme-sm whitespace-nowrap text-gray-500 dark:text-gray-400">@key.LastUsed</td>
                        <td class="px-5 py-4"><partial name="_TaBadge" model="badge" /></td>
                        <td class="px-5 py-4">
                            <div class="flex justify-end gap-2">
                                <button type="button" class="rounded-lg border border-gray-300 px-3 py-1.5 text-theme-xs font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-white/5"
                                        onclick="Ta.toast.success('已複製（演示）')">複製</button>
                                @if (key.Active)
                                {
                                    <button type="button" class="rounded-lg border border-red-200 px-3 py-1.5 text-theme-xs font-medium text-red-600 hover:bg-red-50 dark:border-red-500/30 dark:text-red-400 dark:hover:bg-red-500/10"
                                            onclick="Ta.confirm({ title: '撤銷金鑰', text: '撤銷後使用該金鑰的服務將立即失效。', confirmText: '撤銷', danger: true }).then(function(ok){ if (ok) Ta.toast.success('已撤銷（演示）'); })">撤銷</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<p class="mt-3 text-theme-xs text-gray-500 dark:text-gray-400">提示：生產環境請使用獨立金鑰並僅授予必要權限，便於按用途審計與撤銷。</p>

<dialog id="createKeyDialog" class="w-[calc(100%-2rem)] max-w-lg rounded-2xl border border-gray-200 bg-white p-0 backdrop:bg-gray-900/50 dark:border-gray-800 dark:bg-gray-900">
    <form method="dialog" class="p-5 md:p-6"
          x-data="{ scopes: ['chat'] }"
          onsubmit="Ta.toast.success('金鑰已建立，請立即複製（演示）')">
        <div class="flex items-start justify-between gap-4">
            <div>
                <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">建立 API 金鑰</h3>
                <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">為不同用途分配獨立金鑰，方便審計。</p>
            </div>
            <button type="button" class="rounded-lg p-1.5 text-gray-400 hover:bg-gray-100 hover:text-gray-600 dark:hover:bg-white/5 dark:hover:text-gray-300"
                    onclick="document.getElementById('createKeyDialog').close()" aria-label="關閉">
                    <partial name="_Icon" model="@("close")" />
            </button>
        </div>
        <div class="mt-5 space-y-4">
            <div>
                <label class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400" for="key-name">金鑰名稱</label>
                <input id="key-name" type="text" required placeholder="例如：生產環境後端"
                       class="h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-theme-sm text-gray-800 shadow-theme-xs placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30" />
            </div>
            <div>
                <span class="mb-2 block text-theme-sm font-medium text-gray-700 dark:text-gray-400">權限範圍</span>
                <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                    <label class="flex items-center gap-2 rounded-lg border border-gray-200 px-3 py-2 text-theme-sm text-gray-700 dark:border-gray-700 dark:text-gray-300">
                        <input type="checkbox" value="chat" x-model="scopes" class="size-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500/30" />
                        chat
                    </label>
                    <label class="flex items-center gap-2 rounded-lg border border-gray-200 px-3 py-2 text-theme-sm text-gray-700 dark:border-gray-700 dark:text-gray-300">
                        <input type="checkbox" value="embeddings" x-model="scopes" class="size-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500/30" />
                        embeddings
                    </label>
                    <label class="flex items-center gap-2 rounded-lg border border-gray-200 px-3 py-2 text-theme-sm text-gray-700 dark:border-gray-700 dark:text-gray-300">
                        <input type="checkbox" value="read" x-model="scopes" class="size-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500/30" />
                        read
                    </label>
                    <label class="flex items-center gap-2 rounded-lg border border-gray-200 px-3 py-2 text-theme-sm text-gray-700 dark:border-gray-700 dark:text-gray-300">
                        <input type="checkbox" value="admin" x-model="scopes" class="size-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500/30" />
                        admin
                    </label>
                </div>
                <p class="mt-2 text-theme-xs text-gray-500 dark:text-gray-400">已選 <span class="font-medium text-gray-700 dark:text-gray-300" x-text="scopes.length"></span> 項權限</p>
            </div>
            <div>
                <label class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400" for="key-expire">有效期</label>
                <select id="key-expire" class="h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-theme-sm text-gray-800 shadow-theme-xs focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">
                    <option>30 天</option>
                    <option>90 天</option>
                    <option>永不過期</option>
                </select>
            </div>
        </div>
        <div class="mt-6 flex justify-end gap-3">
            <button type="button" class="rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-white/5"
                    onclick="document.getElementById('createKeyDialog').close()">取消</button>
            <button type="submit" class="rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white hover:bg-brand-600">建立</button>
        </div>
    </form>
</dialog>
