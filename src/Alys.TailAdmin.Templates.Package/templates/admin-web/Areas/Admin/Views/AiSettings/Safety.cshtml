@{
    const string labelClass = "mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400";
    const string inputClass = "h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-theme-sm text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800";
    const string cardClass = "rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]";
}
<div class="grid grid-cols-1 gap-4 md:gap-6 xl:grid-cols-12">
    <div class="space-y-4 md:space-y-6 xl:col-span-8">
        <section class="@cardClass">
            <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">內容過濾</h3>
            <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">在請求與回應兩端攔截不當內容。</p>
            <div class="mt-4 space-y-3">
                <label class="flex items-center justify-between gap-4 rounded-xl border border-gray-100 p-4 dark:border-gray-800">
                    <span>
                        <span class="block text-theme-sm font-medium text-gray-800 dark:text-white/90">暴力與血腥</span>
                        <span class="mt-0.5 block text-theme-xs text-gray-500 dark:text-gray-400">攔截描述暴力行為的內容</span>
                    </span>
                    <input type="checkbox" class="peer sr-only" checked />
                    <span class="relative h-6 w-11 shrink-0 rounded-full bg-gray-200 transition-colors after:absolute after:top-0.5 after:left-0.5 after:size-5 after:rounded-full after:bg-white after:transition-transform after:content-[''] peer-checked:bg-brand-500 peer-checked:after:translate-x-5 dark:bg-gray-700"></span>
                </label>
                <label class="flex items-center justify-between gap-4 rounded-xl border border-gray-100 p-4 dark:border-gray-800">
                    <span>
                        <span class="block text-theme-sm font-medium text-gray-800 dark:text-white/90">仇恨與歧視</span>
                        <span class="mt-0.5 block text-theme-xs text-gray-500 dark:text-gray-400">攔截針對特定群體的攻擊性內容</span>
                    </span>
                    <input type="checkbox" class="peer sr-only" checked />
                    <span class="relative h-6 w-11 shrink-0 rounded-full bg-gray-200 transition-colors after:absolute after:top-0.5 after:left-0.5 after:size-5 after:rounded-full after:bg-white after:transition-transform after:content-[''] peer-checked:bg-brand-500 peer-checked:after:translate-x-5 dark:bg-gray-700"></span>
                </label>
                <label class="flex items-center justify-between gap-4 rounded-xl border border-gray-100 p-4 dark:border-gray-800">
                    <span>
                        <span class="block text-theme-sm font-medium text-gray-800 dark:text-white/90">個人隱私資訊</span>
                        <span class="mt-0.5 block text-theme-xs text-gray-500 dark:text-gray-400">自動遮罩身分證號、手機號等敏感資訊</span>
                    </span>
                    <input type="checkbox" class="peer sr-only" />
                    <span class="relative h-6 w-11 shrink-0 rounded-full bg-gray-200 transition-colors after:absolute after:top-0.5 after:left-0.5 after:size-5 after:rounded-full after:bg-white after:transition-transform after:content-[''] peer-checked:bg-brand-500 peer-checked:after:translate-x-5 dark:bg-gray-700"></span>
                </label>
            </div>
        </section>

        <section class="@cardClass">
            <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">敏感詞</h3>
            <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">每行一個，命中後將直接拒絕請求。</p>
            <textarea rows="5"
                      class="mt-4 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-3 text-theme-sm text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800"
                      placeholder="例如：內部代碼、未公開價格">內部代碼
未公開價格</textarea>
        </section>
    </div>

    <aside class="space-y-4 md:space-y-6 xl:col-span-4">
        <section class="@cardClass">
            <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">速率限制</h3>
            <div class="mt-4 space-y-4">
                <div>
                    <label class="@labelClass" for="rate-rpm">每分鐘請求數</label>
                    <input id="rate-rpm" type="number" class="@inputClass" value="60" min="1" />
                </div>
                <div>
                    <label class="@labelClass" for="rate-tokens">單次最大 Token</label>
                    <input id="rate-tokens" type="number" class="@inputClass" value="4096" min="256" step="256" />
                </div>
                <div>
                    <label class="@labelClass" for="rate-daily">每日上限（USD）</label>
                    <input id="rate-daily" type="number" class="@inputClass" value="20" min="0" step="1" />
                </div>
            </div>
        </section>

        <button type="button"
                class="flex w-full items-center justify-center gap-2 rounded-lg bg-brand-500 px-4 py-3 text-theme-sm font-medium text-white shadow-theme-xs hover:bg-brand-600"
                onclick="Ta.toast.success('安全設定已保存（演示）')">
            <partial name="_Icon" model="@("check")" />
            保存設定
        </button>
    </aside>
</div>
