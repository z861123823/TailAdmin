<div x-data="{
        dragging: null,
        query: '',
        open: false,
        newTitle: '',
        newCol: 0,
        newDue: '2026-12-01',
        columns: [
            { title: '待處理', tone: 'bg-gray-400', tasks: [
                { id: 1, title: '整理雙十一活動排期', desc: '確認素材與上線時間', tags: ['運營', '活動'], priority: '高', priorityClass: 'bg-red-50 text-red-600 dark:bg-red-500/15 dark:text-red-400', due: '11-25', initials: '林', done: 3, total: 5, comments: 4, attachments: 2 },
                { id: 2, title: '更新商品主圖規格', desc: '36 個 SKU 批次替換', tags: ['商品'], priority: '中', priorityClass: 'bg-amber-50 text-amber-600 dark:bg-amber-500/15 dark:text-amber-400', due: '11-27', initials: '陳', done: 1, total: 4, comments: 1, attachments: 1 },
                { id: 3, title: '供應商合約續簽', desc: '確認帳期與返點', tags: ['採購'], priority: '低', priorityClass: 'bg-gray-100 text-gray-600 dark:bg-white/10 dark:text-gray-400', due: '12-02', initials: '王', done: 0, total: 3, comments: 0, attachments: 1 }
            ] },
            { title: '進行中', tone: 'bg-brand-500', tasks: [
                { id: 4, title: '客服話術優化', desc: '整理高頻問題與標準回覆', tags: ['客服'], priority: '高', priorityClass: 'bg-red-50 text-red-600 dark:bg-red-500/15 dark:text-red-400', due: '11-24', initials: '李', done: 4, total: 6, comments: 6, attachments: 0 },
                { id: 5, title: '月度數據複盤', desc: '轉化漏斗與渠道對比', tags: ['數據'], priority: '中', priorityClass: 'bg-amber-50 text-amber-600 dark:bg-amber-500/15 dark:text-amber-400', due: '11-28', initials: '陳', done: 2, total: 5, comments: 3, attachments: 2 }
            ] },
            { title: '待審核', tone: 'bg-amber-500', tasks: [
                { id: 6, title: '新版首頁視覺', desc: '等待品牌組確認', tags: ['設計'], priority: '中', priorityClass: 'bg-amber-50 text-amber-600 dark:bg-amber-500/15 dark:text-amber-400', due: '11-26', initials: '林', done: 5, total: 5, comments: 2, attachments: 3 }
            ] },
            { title: '已完成', tone: 'bg-green-500', tasks: [
                { id: 7, title: '雙十一預熱海報', desc: '已上線', tags: ['設計', '活動'], priority: '低', priorityClass: 'bg-gray-100 text-gray-600 dark:bg-white/10 dark:text-gray-400', due: '11-20', initials: '林', done: 4, total: 4, comments: 5, attachments: 2 }
            ] }
        ],
        start(t) {
            this.dragging = t;
        },
        drop(colIndex) {
            if (!this.dragging) return;
            const id = this.dragging.id;
            this.columns.forEach(c => { c.tasks = c.tasks.filter(t => t.id !== id); });
            this.columns[colIndex].tasks.push(this.dragging);
            this.dragging = null;
            Ta.toast.success('已移到「' + this.columns[colIndex].title + '」（演示）');
        },
        addTask() {
            if (!this.newTitle.trim()) return;
            const nextId = this.columns.reduce((max, c) => Math.max(max, ...c.tasks.map(t => t.id)), 0) + 1;
            this.columns[this.newCol].tasks.unshift({
                id: nextId,
                title: this.newTitle,
                desc: '新建任務',
                tags: ['新任務'],
                priority: '中',
                priorityClass: 'bg-amber-50 text-amber-600 dark:bg-amber-500/15 dark:text-amber-400',
                due: this.newDue.slice(5),
                initials: '林',
                done: 0,
                total: 3,
                comments: 0,
                attachments: 0
            });
            this.newTitle = '';
            this.open = false;
            Ta.toast.success('任務已建立（演示）');
        }
     }">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
            <div class="flex -space-x-2">
                <span class="flex size-8 items-center justify-center rounded-full border-2 border-white bg-brand-50 text-theme-xs font-semibold text-brand-600 dark:border-gray-900 dark:bg-brand-500/15 dark:text-brand-400">林</span>
                <span class="flex size-8 items-center justify-center rounded-full border-2 border-white bg-green-50 text-theme-xs font-semibold text-green-600 dark:border-gray-900 dark:bg-green-500/15 dark:text-green-400">陳</span>
                <span class="flex size-8 items-center justify-center rounded-full border-2 border-white bg-amber-50 text-theme-xs font-semibold text-amber-600 dark:border-gray-900 dark:bg-amber-500/15 dark:text-amber-400">王</span>
                <span class="flex size-8 items-center justify-center rounded-full border-2 border-white bg-gray-100 text-theme-xs font-semibold text-gray-600 dark:border-gray-900 dark:bg-white/10 dark:text-gray-400">+3</span>
            </div>
            <span class="text-theme-sm text-gray-500 dark:text-gray-400">7 個任務 · 本週 3 個到期</span>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <input type="text" placeholder="搜索任務" x-model="query"
                   class="h-10 w-44 rounded-lg border border-gray-300 bg-transparent px-3 py-2 text-theme-sm text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800" />
            <button type="button" class="inline-flex items-center gap-2 rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white shadow-theme-xs hover:bg-brand-600"
                    x-on:click="newCol = 0; open = true">
                <partial name="_Icon" model="@("plus")" />
                新增任務
            </button>
        </div>
    </div>

    <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4 md:gap-6">
        <template x-for="(col, ci) in columns" :key="ci">
            <section class="flex flex-col rounded-2xl border border-gray-200 bg-gray-50/60 p-3 dark:border-gray-800 dark:bg-white/[0.02]"
                     x-on:dragover.prevent x-on:drop.prevent="drop(ci)">
                <div class="flex items-center justify-between px-1 pb-3">
                    <h3 class="flex items-center gap-2 text-theme-sm font-semibold text-gray-800 dark:text-white/90">
                        <span class="size-2 rounded-full" x-bind:class="col.tone"></span>
                        <span x-text="col.title"></span>
                        <span class="rounded-full bg-white px-2 py-0.5 text-theme-xs font-medium text-gray-500 shadow-theme-xs dark:bg-gray-800 dark:text-gray-400" x-text="col.tasks.length"></span>
                    </h3>
                    <button type="button" class="inline-flex size-7 items-center justify-center rounded-lg text-gray-400 hover:bg-white hover:text-gray-700 dark:hover:bg-white/5 dark:hover:text-gray-300"
                            x-on:click="newCol = ci; open = true" aria-label="新增任務">
                        <partial name="_Icon" model="@("plus")" />
                    </button>
                </div>
                <div class="space-y-3">
                    <template x-for="t in col.tasks" :key="t.id">
                        <article class="cursor-grab rounded-xl border border-gray-200 bg-white p-4 shadow-theme-xs transition-shadow hover:shadow-theme-sm dark:border-gray-800 dark:bg-gray-900"
                                 draggable="true" x-show="!query || t.title.includes(query)"
                                 x-on:dragstart="start(t)" x-on:dragend="dragging = null"
                                 x-bind:class="dragging && dragging.id === t.id ? 'opacity-50' : ''">
                            <div class="flex flex-wrap gap-1.5">
                                <template x-for="(tag, ti) in t.tags" :key="ti">
                                    <span class="rounded-full bg-brand-50 px-2 py-0.5 text-[10px] font-medium text-brand-600 dark:bg-brand-500/15 dark:text-brand-400" x-text="tag"></span>
                                </template>
                            </div>
                            <h4 class="mt-2 text-theme-sm font-semibold text-gray-800 dark:text-white/90" x-text="t.title"></h4>
                            <p class="mt-1 text-theme-xs text-gray-500 dark:text-gray-400" x-text="t.desc"></p>
                            <div class="mt-3 flex items-center justify-between gap-2">
                                <span class="rounded-full px-2 py-0.5 text-[10px] font-medium" x-bind:class="t.priorityClass" x-text="t.priority + '優先'"></span>
                                <span class="text-theme-xs text-gray-500 dark:text-gray-400" x-text="t.due"></span>
                            </div>
                            <div class="mt-3">
                                <div class="flex items-center justify-between text-[10px] text-gray-500 dark:text-gray-400">
                                    <span x-text="'檢查項 ' + t.done + '/' + t.total"></span>
                                    <span x-text="Math.round(t.done / t.total * 100) + '%'"></span>
                                </div>
                                <div class="mt-1 h-1.5 rounded-full bg-gray-100 dark:bg-white/10">
                                    <div class="h-1.5 rounded-full bg-brand-500" x-bind:style="'width:' + (t.done / t.total * 100) + '%'"></div>
                                </div>
                            </div>
                            <div class="mt-3 flex items-center justify-between border-t border-gray-100 pt-3 dark:border-gray-800">
                                <span class="flex items-center gap-3 text-[10px] text-gray-500 dark:text-gray-400">
                                    <span class="inline-flex items-center gap-1"><partial name="_Icon" model="@("chat")" /><span x-text="t.comments"></span></span>
                                    <span class="inline-flex items-center gap-1"><partial name="_Icon" model="@("upload")" /><span x-text="t.attachments"></span></span>
                                </span>
                                <span class="flex size-7 items-center justify-center rounded-full bg-gray-100 text-[10px] font-semibold text-gray-600 dark:bg-white/10 dark:text-gray-400" x-text="t.initials"></span>
                            </div>
                        </article>
                    </template>
                </div>
            </section>
        </template>
    </div>

    <div x-show="open" x-cloak class="fixed inset-0 z-[999999] flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-label="新增任務">
        <div class="absolute inset-0 bg-gray-900/50" x-on:click="open = false" x-transition.opacity></div>
        <div class="relative w-full max-w-md rounded-2xl border border-gray-200 bg-white p-5 shadow-xl md:p-6 dark:border-gray-800 dark:bg-gray-900" x-transition>
            <div class="flex items-center justify-between">
                <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">新增任務</h3>
                <button type="button" class="inline-flex size-8 items-center justify-center rounded-lg text-gray-400 hover:bg-gray-100 hover:text-gray-700 dark:hover:bg-white/5 dark:hover:text-gray-300" x-on:click="open = false" aria-label="關閉">
                    <partial name="_Icon" model="@("close")" />
                </button>
            </div>
            <div class="mt-4 space-y-4">
                <div>
                    <label class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400" for="task-title">任務名稱</label>
                    <input id="task-title" type="text" x-model="newTitle" placeholder="例如：整理本週數據複盤"
                           class="h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-theme-sm text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800" />
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400" for="task-col">所在列</label>
                        <select id="task-col" x-model.number="newCol"
                                class="h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-theme-sm text-gray-800 shadow-theme-xs focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:focus:border-brand-800">
                            <template x-for="(col, ci) in columns" :key="ci">
                                <option x-bind:value="ci" x-text="col.title"></option>
                            </template>
                        </select>
                    </div>
                    <div>
                        <label class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400" for="task-due">截止日期</label>
                        <input id="task-due" type="date" x-model="newDue"
                               class="h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-theme-sm text-gray-800 shadow-theme-xs focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:focus:border-brand-800" />
                    </div>
                </div>
            </div>
            <div class="mt-5 flex justify-end gap-3">
                <button type="button" class="rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-theme-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400" x-on:click="open = false">取消</button>
                <button type="button" class="rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white hover:bg-brand-600 disabled:opacity-50"
                        x-bind:disabled="!newTitle.trim()" x-on:click="addTask()">建立任務</button>
            </div>
        </div>
    </div>
</div>
