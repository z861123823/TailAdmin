@{
    var links = new List<TaLinkModel>
    {
        new() { Text = "主要連結", Href = "#" },
        new() { Text = "次要連結", Href = "#", Variant = "muted" },
        new() { Text = "下劃線連結", Href = "#", Variant = "underline" },
        new() { Text = "帶圖標連結", Href = "#", Icon = "external-link" },
        new() { Text = "外部連結", Href = "https://tailadmin.com", External = true }
    };
    var terms = new TaLinkModel { Text = "使用條款", Href = "#", Variant = "underline" };
    var privacy = new TaLinkModel { Text = "隱私政策", Href = "#", Variant = "underline" };
    var footerLinks = new List<TaLinkModel>
    {
        new() { Text = "幫助中心", Href = "#", Variant = "muted" },
        new() { Text = "服務狀態", Href = "#", Variant = "muted" },
        new() { Text = "聯絡我們", Href = "#", Variant = "muted" },
        new() { Text = "更新日誌", Href = "#", Variant = "muted" }
    };
    var resourceLinks = new List<TaLinkModel>
    {
        new() { Text = "快速開始", Href = "#", Icon = "components" },
        new() { Text = "組件文檔", Href = "#", Icon = "order" },
        new() { Text = "圖表範例", Href = "#", Icon = "chart" },
        new() { Text = "問題回饋", Href = "#", Icon = "chat" }
    };
}
<div class="grid grid-cols-1 gap-4 md:gap-6 xl:grid-cols-2">
    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">連結樣式</h3>
        <div class="mt-4 flex flex-col items-start gap-3">
            @foreach (var link in links)
            {
                <partial name="_TaLink" model="link" />
            }
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">正文中的連結</h3>
        <p class="mt-3 text-theme-sm leading-6 text-gray-600 dark:text-gray-400">
            閱讀
            <partial name="_TaLink" model="terms" />
            與
            <partial name="_TaLink" model="privacy" />
            以了解資料的處理方式。
        </p>
        <p class="mt-3 text-theme-sm leading-6 text-gray-600 dark:text-gray-400">
            如需更多說明，請前往
            <a href="#" class="font-medium text-brand-500 hover:text-brand-600 dark:text-brand-400">幫助中心</a>
            ，或直接
            <a href="#" class="font-medium text-brand-500 hover:text-brand-600 dark:text-brand-400">提交工單</a>
            。
        </p>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">資源連結（圖標 + 文字）</h3>
        <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
            @foreach (var link in resourceLinks)
            {
                <a href="@link.Href"
                   class="group flex items-center justify-between gap-3 rounded-xl border border-gray-200 px-4 py-3 text-theme-sm font-medium text-gray-700 transition-colors hover:border-brand-300 hover:bg-brand-50/50 dark:border-gray-700 dark:text-gray-300 dark:hover:border-brand-800 dark:hover:bg-brand-500/10">
                    <span class="flex items-center gap-2">
                        <span class="text-gray-400 group-hover:text-brand-500 dark:text-gray-500">
                            <partial name="_Icon" model="@(link.Icon ?? string.Empty)" />
                        </span>
                        @link.Text
                    </span>
                    <partial name="_Icon" model="@("chevron-right")" />
                </a>
            }
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">頁腳連結組</h3>
        <p class="mt-3 text-theme-sm text-gray-500 dark:text-gray-400">以圓點分隔的緊湊連結列，常用於頁腳或卡片底部。</p>
        <nav class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2">
            @for (var index = 0; index < footerLinks.Count; index++)
            {
                <partial name="_TaLink" model="footerLinks[index]" />
                @if (index < footerLinks.Count - 1)
                {
                    <span class="text-gray-300 dark:text-gray-600" aria-hidden="true">·</span>
                }
            }
        </nav>
        <div class="mt-5 border-t border-gray-100 pt-4 text-theme-xs text-gray-500 dark:border-gray-800 dark:text-gray-400">
            © 2026 Alys Admin · 由
            <a href="https://tailadmin.com" target="_blank" rel="noopener" class="font-medium text-brand-500 hover:text-brand-600 dark:text-brand-400">TailAdmin</a>
            啟發
        </div>
    </section>
</div>
