<div class="grid grid-cols-1 gap-4 md:gap-6 xl:grid-cols-2">
    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">方向</h3>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-4">
            <span class="group relative inline-block">
                <button type="button" class="rounded-lg border border-gray-300 px-4 py-2 text-theme-sm text-gray-700 dark:border-gray-700 dark:text-gray-300">上方提示</button>
                <span class="pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 rounded-lg bg-gray-900 px-2.5 py-1.5 text-theme-xs whitespace-nowrap text-white opacity-0 transition-opacity group-hover:opacity-100">顯示在按鈕上方</span>
            </span>
            <span class="group relative inline-block">
                <button type="button" class="rounded-lg border border-gray-300 px-4 py-2 text-theme-sm text-gray-700 dark:border-gray-700 dark:text-gray-300">下方提示</button>
                <span class="pointer-events-none absolute top-full left-1/2 mt-2 -translate-x-1/2 rounded-lg bg-gray-900 px-2.5 py-1.5 text-theme-xs whitespace-nowrap text-white opacity-0 transition-opacity group-hover:opacity-100">顯示在按鈕下方</span>
            </span>
            <span class="group relative inline-block">
                <button type="button" class="rounded-lg border border-gray-300 px-4 py-2 text-theme-sm text-gray-700 dark:border-gray-700 dark:text-gray-300">左側提示</button>
                <span class="pointer-events-none absolute top-1/2 right-full mr-2 -translate-y-1/2 rounded-lg bg-gray-900 px-2.5 py-1.5 text-theme-xs whitespace-nowrap text-white opacity-0 transition-opacity group-hover:opacity-100">左側說明</span>
            </span>
            <span class="group relative inline-block">
                <button type="button" class="rounded-lg border border-gray-300 px-4 py-2 text-theme-sm text-gray-700 dark:border-gray-700 dark:text-gray-300">右側提示</button>
                <span class="pointer-events-none absolute top-1/2 left-full ml-2 -translate-y-1/2 rounded-lg bg-gray-900 px-2.5 py-1.5 text-theme-xs whitespace-nowrap text-white opacity-0 transition-opacity group-hover:opacity-100">右側說明</span>
            </span>
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">色彩變體</h3>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-4">
            <span class="group relative inline-block">
                <button type="button" class="rounded-lg bg-brand-500 px-4 py-2 text-theme-sm font-medium text-white">品牌</button>
                <span class="pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 rounded-lg bg-brand-500 px-2.5 py-1.5 text-theme-xs whitespace-nowrap text-white opacity-0 transition-opacity group-hover:opacity-100">品牌色提示</span>
            </span>
            <span class="group relative inline-block">
                <button type="button" class="rounded-lg bg-green-500 px-4 py-2 text-theme-sm font-medium text-white">成功</button>
                <span class="pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 rounded-lg bg-green-600 px-2.5 py-1.5 text-theme-xs whitespace-nowrap text-white opacity-0 transition-opacity group-hover:opacity-100">操作成功</span>
            </span>
            <span class="group relative inline-block">
                <button type="button" class="rounded-lg bg-red-500 px-4 py-2 text-theme-sm font-medium text-white">危險</button>
                <span class="pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 rounded-lg bg-red-600 px-2.5 py-1.5 text-theme-xs whitespace-nowrap text-white opacity-0 transition-opacity group-hover:opacity-100">不可撤銷</span>
            </span>
            <span class="group relative inline-block">
                <button type="button" class="rounded-lg border border-gray-300 px-4 py-2 text-theme-sm text-gray-700 dark:border-gray-700 dark:text-gray-300">帶箭頭</button>
                <span class="pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 rounded-lg bg-gray-900 px-2.5 py-1.5 text-theme-xs whitespace-nowrap text-white opacity-0 transition-opacity group-hover:opacity-100">
                    帶箭頭提示
                    <span class="absolute top-full left-1/2 -mt-1 size-2 -translate-x-1/2 rotate-45 bg-gray-900"></span>
                </span>
            </span>
        </div>
    </section>
</div>
