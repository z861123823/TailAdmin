@{
    var square = new TaImagesModel
    {
        Columns = 3,
        Ratio = "square",
        Items = new List<TaImageItemModel>
        {
            new() { Src = Swatch("#465fff", "#b1bcff", 0), Alt = "示例一", Caption = "正方形 · 1:1" },
            new() { Src = Swatch("#12b76a", "#a6f4c5", 1), Alt = "示例二", Caption = "正方形 · 1:1" },
            new() { Src = Swatch("#f04438", "#fda29b", 0), Alt = "示例三", Caption = "正方形 · 1:1" }
        }
    };
    var wide = new TaImagesModel
    {
        Columns = 2,
        Ratio = "video",
        Items = new List<TaImageItemModel>
        {
            new() { Src = Swatch("#0ba5ec", "#b9e6fe", 0), Alt = "示例四", Caption = "視頻比例 · 16:9" },
            new() { Src = Swatch("#7a5af8", "#c3b5fd", 1), Alt = "示例五", Caption = "視頻比例 · 16:9" }
        }
    };
    var portrait = new TaImagesModel
    {
        Columns = 4,
        Ratio = "portrait",
        Rounded = false,
        Items = new List<TaImageItemModel>
        {
            new() { Src = Swatch("#f79009", "#fdb022", 0), Alt = "示例六" },
            new() { Src = Swatch("#12b76a", "#6ce9a6", 1), Alt = "示例七" },
            new() { Src = Swatch("#465fff", "#8192ff", 0), Alt = "示例八" },
            new() { Src = Swatch("#f04438", "#fda29b", 1), Alt = "示例九" }
        }
    };
    var gallery = new[]
    {
        new { Src = Swatch("#465fff", "#8192ff", 0), Alt = "畫廊圖一", Caption = "春季新品" },
        new { Src = Swatch("#12b76a", "#6ce9a6", 1), Alt = "畫廊圖二", Caption = "會員專享" },
        new { Src = Swatch("#f79009", "#fdb022", 0), Alt = "畫廊圖三", Caption = "店慶活動" },
        new { Src = Swatch("#0ba5ec", "#b9e6fe", 1), Alt = "畫廊圖四", Caption = "限定禮盒" },
        new { Src = Swatch("#7a5af8", "#c3b5fd", 0), Alt = "畫廊圖五", Caption = "聯名系列" },
        new { Src = Swatch("#f04438", "#fda29b", 1), Alt = "畫廊圖六", Caption = "清倉特惠" }
    };
}
<div class="flex flex-col gap-4 md:gap-6">
    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">三列正方形</h3>
        <div class="mt-4">
            <partial name="_TaImages" model="square" />
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">兩列視頻比例</h3>
        <div class="mt-4">
            <partial name="_TaImages" model="wide" />
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">四列豎版（無圓角）</h3>
        <div class="mt-4">
            <partial name="_TaImages" model="portrait" />
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]"
             x-data="{ open: false, src: '', alt: '' }" x-on:keydown.escape.window="open = false">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
                <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">可點擊放大</h3>
                <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">點擊任意圖片開啟燈箱，按 Esc 或點擊遮罩關閉。</p>
            </div>
            <span class="rounded-full bg-gray-100 px-3 py-1 text-theme-xs text-gray-600 dark:bg-white/10 dark:text-gray-300">共 @gallery.Length 張</span>
        </div>
        <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
            @foreach (var image in gallery)
            {
                <figure class="group overflow-hidden rounded-xl border border-gray-100 dark:border-gray-800">
                    <button type="button" class="relative block w-full overflow-hidden"
                            x-on:click="open = true; src = '@image.Src'; alt = '@image.Alt'"
                            aria-label="放大檢視 @image.Caption">
                        <img src="@image.Src" alt="@image.Alt" class="aspect-square w-full object-cover transition-transform duration-300 group-hover:scale-105" />
                        <span class="absolute inset-0 flex items-center justify-center bg-gray-900/0 text-white opacity-0 transition-all group-hover:bg-gray-900/40 group-hover:opacity-100">
                            <partial name="_Icon" model="@("eye")" />
                        </span>
                    </button>
                    <figcaption class="px-3 py-2 text-theme-xs text-gray-500 dark:text-gray-400">@image.Caption</figcaption>
                </figure>
            }
        </div>

        <div class="fixed inset-0 z-[99999] flex items-center justify-center bg-gray-900/80 p-6"
             x-show="open" x-cloak x-on:click="open = false" x-transition.opacity>
            <figure class="max-w-3xl" x-on:click.stop>
                <img x-bind:src="src" x-bind:alt="alt" class="max-h-[75vh] w-full rounded-xl object-contain" />
                <figcaption class="mt-3 flex items-center justify-between gap-3 text-theme-sm text-white">
                    <span x-text="alt"></span>
                    <button type="button" class="rounded-lg bg-white/10 px-3 py-1.5 text-theme-xs font-medium text-white hover:bg-white/20"
                            x-on:click="open = false">關閉</button>
                </figcaption>
            </figure>
        </div>
    </section>
</div>

@functions {
    /// <summary>生成自包含的漸變 SVG 圖片，避免示例頁依賴外部圖床。</summary>
    /// <param name="from">起始顏色。</param>
    /// <param name="to">結束顏色。</param>
    /// <param name="variant">圖形變體。</param>
    /// <returns>可直接用於 img src 的 Data URI。</returns>
    private static string Swatch(string from, string to, int variant)
    {
        var shape = variant % 2 == 0
            ? "<circle cx='620' cy='180' r='210' fill='white' fill-opacity='0.14'/>"
            : "<rect x='420' y='360' width='520' height='520' fill='white' fill-opacity='0.12' transform='rotate(18 680 620)'/>";
        var svg = "<svg xmlns='http://www.w3.org/2000/svg' width='800' height='800'>"
            + "<defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'>"
            + $"<stop offset='0' stop-color='{from}'/><stop offset='1' stop-color='{to}'/>"
            + "</linearGradient></defs>"
            + "<rect width='800' height='800' fill='url(#g)'/>"
            + shape
            + "</svg>";
        return "data:image/svg+xml;utf8," + Uri.EscapeDataString(svg);
    }
}
