@{
    var groups = new List<(string Title, string Variant)>
    {
        ("Default Alert", "default"),
        ("Success Alert", "success"),
        ("Warning Alert", "warning"),
        ("Error Alert", "danger"),
        ("Info Alert", "info")
    };
}
<div class="grid grid-cols-1 gap-4 md:gap-6 xl:grid-cols-2">
    @foreach (var group in groups)
    {
        var withIcon = new TaAlertModel
        {
            Variant = group.Variant,
            Title = "Default Message",
            Message = "請謹慎執行此操作。",
            LinkText = "了解詳情",
            LinkUrl = "#"
        };
        var plain = new TaAlertModel
        {
            Variant = group.Variant,
            Title = "Default Message",
            Message = "請謹慎執行此操作。",
            ShowIcon = false,
            Dismissible = true
        };
        <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
            <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">@group.Title</h3>
            <div class="mt-4 flex flex-col gap-3">
                <partial name="_TaAlert" model="withIcon" />
                <partial name="_TaAlert" model="plain" />
            </div>
        </section>
    }
</div>

<div class="mt-4 grid grid-cols-1 gap-4 md:mt-6 md:gap-6 xl:grid-cols-2">
    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">帶標題與關閉</h3>
        <div class="mt-4 space-y-3" x-data="{ show: true }">
            <div x-show="show" class="flex items-start gap-3 rounded-xl border border-amber-200 bg-amber-50 p-4 dark:border-amber-500/30 dark:bg-amber-500/10">
                <span class="mt-0.5 text-amber-600 dark:text-amber-400"><partial name="_Icon" model="@("alert")" /></span>
                <div class="min-w-0 flex-1">
                    <p class="text-theme-sm font-semibold text-amber-800 dark:text-amber-300">庫存不足提醒</p>
                    <p class="mt-1 text-theme-sm text-amber-700 dark:text-amber-400">3 個商品庫存低於安全值，請及時補貨以免影響銷售。</p>
                </div>
                <button type="button" class="rounded p-1 text-amber-500 hover:bg-amber-100 dark:hover:bg-amber-500/10" x-on:click="show = false" aria-label="關閉">
                    <partial name="_Icon" model="@("close")" />
                </button>
            </div>
            <div class="flex items-start gap-3 rounded-xl border border-brand-200 bg-brand-50 p-4 dark:border-brand-500/30 dark:bg-brand-500/10">
                <span class="mt-0.5 text-brand-500 dark:text-brand-400"><partial name="_Icon" model="@("bell")" /></span>
                <div class="min-w-0 flex-1">
                    <p class="text-theme-sm font-semibold text-brand-800 dark:text-brand-300">新版本可用</p>
                    <p class="mt-1 text-theme-sm text-brand-700 dark:text-brand-400">Alys.TailAdmin 1.5.0 已發佈，包含 22 個 UI 元件示例。</p>
                    <a href="#" class="mt-2 inline-flex text-theme-xs font-medium text-brand-600 underline underline-offset-2 dark:text-brand-400">查看更新內容</a>
                </div>
            </div>
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">橫幅樣式</h3>
        <div class="mt-4 space-y-3">
            <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl bg-brand-500 px-4 py-3 text-white">
                <p class="text-theme-sm font-medium">雙十一活動配置已開啟，記得檢查優惠庫存。</p>
                <button type="button" class="rounded-lg bg-white/20 px-3 py-1.5 text-theme-xs font-medium hover:bg-white/30" onclick="Ta.toast.info('前往活動設定（演示）')">去設定</button>
            </div>
            <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl bg-gray-900 px-4 py-3 text-white dark:bg-gray-800">
                <p class="text-theme-sm font-medium">系統將於今晚 02:00 進行維護，預計 30 分鐘。</p>
                <button type="button" class="rounded-lg border border-white/30 px-3 py-1.5 text-theme-xs font-medium hover:bg-white/10" onclick="Ta.toast.info('維護公告（演示）')">了解詳情</button>
            </div>
        </div>
    </section>
</div>
