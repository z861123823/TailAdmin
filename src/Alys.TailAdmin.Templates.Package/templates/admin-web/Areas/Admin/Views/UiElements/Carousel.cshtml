@{
    var withAll = new TaCarouselModel
    {
        Height = "md",
        Items = new List<TaCarouselItemModel>
        {
            new() { Src = Swatch("#465fff", "#8192ff", 0), Alt = "幻燈片一", Caption = "春季新品", Description = "全場商品限時折扣" },
            new() { Src = Swatch("#12b76a", "#6ce9a6", 1), Alt = "幻燈片二", Caption = "會員專享", Description = "積分兌換與專屬優惠" },
            new() { Src = Swatch("#f79009", "#fdb022", 0), Alt = "幻燈片三", Caption = "店慶活動", Description = "滿 300 減 50" }
        }
    };
    var indicatorsOnly = new TaCarouselModel
    {
        Height = "sm",
        ShowArrows = false,
        Items = new List<TaCarouselItemModel>
        {
            new() { Src = Swatch("#0ba5ec", "#b9e6fe", 0), Alt = "幻燈片一", Caption = "僅指示點" },
            new() { Src = Swatch("#f04438", "#fda29b", 1), Alt = "幻燈片二", Caption = "拖動或點擊切換" }
        }
    };
    var bare = new TaCarouselModel
    {
        Height = "sm",
        ShowArrows = false,
        ShowIndicators = false,
        Items = new List<TaCarouselItemModel>
        {
            new() { Src = Swatch("#7a5af8", "#c3b5fd", 0), Alt = "單張圖片" }
        }
    };
    var large = new TaCarouselModel
    {
        Height = "lg",
        Items = new List<TaCarouselItemModel>
        {
            new() { Src = Swatch("#f04438", "#fda29b", 0), Alt = "幻燈片一", Caption = "限時秒殺", Description = "點擊圖片進入活動會場", Href = "#" },
            new() { Src = Swatch("#0ba5ec", "#b9e6fe", 1), Alt = "幻燈片二", Caption = "新品首發", Description = "預約即享早鳥價", Href = "#" }
        }
    };
    var thumbs = new[]
    {
        Swatch("#465fff", "#8192ff", 0),
        Swatch("#12b76a", "#6ce9a6", 1),
        Swatch("#f79009", "#fdb022", 0),
        Swatch("#0ba5ec", "#b9e6fe", 1)
    };
}
<div class="flex flex-col gap-4 md:gap-6">
    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">左右切換 + 指示點</h3>
        <div class="mt-4">
            <partial name="_TaCarousel" model="withAll" />
        </div>
    </section>

    <div class="grid grid-cols-1 gap-4 md:gap-6 xl:grid-cols-2">
        <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
            <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">僅指示點</h3>
            <div class="mt-4">
                <partial name="_TaCarousel" model="indicatorsOnly" />
            </div>
        </section>

        <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
            <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">純圖片</h3>
            <div class="mt-4">
                <partial name="_TaCarousel" model="bare" />
            </div>
        </section>
    </div>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">大尺寸（可點擊跳轉）</h3>
        <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">圖片與文案浮層均可作為跳轉入口。</p>
        <div class="mt-4">
            <partial name="_TaCarousel" model="large" />
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]" x-data="{ active: 0 }">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">縮略圖切換</h3>
        <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">點擊下方縮略圖即時切換主圖，適合商品圖集。</p>
        <div class="mt-4 overflow-hidden rounded-xl">
            @for (var index = 0; index < thumbs.Length; index++)
            {
                var i = index;
                <img src="@thumbs[i]" alt="商品圖 @(i + 1)" x-show="active === @i" x-cloak
                     class="h-64 w-full object-cover md:h-80" />
            }
        </div>
        <div class="mt-3 grid grid-cols-4 gap-2 md:gap-3">
            @for (var index = 0; index < thumbs.Length; index++)
            {
                var i = index;
                <button type="button" x-on:click="active = @i"
                        x-bind:class="active === @i ? 'ring-2 ring-brand-500 ring-offset-2 dark:ring-offset-gray-900' : 'opacity-60 hover:opacity-100'"
                        class="overflow-hidden rounded-lg transition-opacity" aria-label="切換到第 @(i + 1) 張">
                    <img src="@thumbs[i]" alt="縮略圖 @(i + 1)" class="h-16 w-full object-cover md:h-20" />
                </button>
            }
        </div>
    </section>
</div>

@functions {
    /// <summary>生成自包含的漸變 SVG 圖片，避免示例頁依賴外部圖床。</summary>
    /// <param name="from">起始顏色。</param>
    /// <param name="to">結束顏色。</param>
    /// <param name="variant">圖形變體。</param>
    /// <returns>可直接用於 img src 的 Data URI。</returns>
    private static string Swatch(string from, string to, int variant)
    {
        var shape = variant % 2 == 0
            ? "<circle cx='620' cy='180' r='210' fill='white' fill-opacity='0.14'/>"
            : "<rect x='420' y='360' width='520' height='520' fill='white' fill-opacity='0.12' transform='rotate(18 680 620)'/>";
        var svg = "<svg xmlns='http://www.w3.org/2000/svg' width='800' height='500'>"
            + "<defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'>"
            + $"<stop offset='0' stop-color='{from}'/><stop offset='1' stop-color='{to}'/>"
            + "</linearGradient></defs>"
            + "<rect width='800' height='500' fill='url(#g)'/>"
            + shape
            + "</svg>";
        return "data:image/svg+xml;utf8," + Uri.EscapeDataString(svg);
    }
}
