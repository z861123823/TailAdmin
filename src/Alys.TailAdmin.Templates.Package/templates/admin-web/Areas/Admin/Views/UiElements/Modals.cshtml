@{
    var openBasic = "document.getElementById('demo-modal-basic').showModal()";
    var openConfirm = "document.getElementById('demo-modal-confirm').showModal()";
    var openScroll = "document.getElementById('demo-modal-scroll').showModal()";
}
<div class="grid grid-cols-1 gap-4 md:gap-6 xl:grid-cols-2">
    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">基礎彈窗</h3>
        <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">標題 + 關閉按鈕 + 底部操作。</p>
        <button type="button" class="mt-4 inline-flex items-center justify-center rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white shadow-theme-xs transition-colors hover:bg-brand-600"
                onclick="@openBasic">打開彈窗</button>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">確認彈窗</h3>
        <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">用於刪除等不可恢復操作。</p>
        <button type="button" class="mt-4 inline-flex items-center justify-center rounded-lg bg-red-500 px-4 py-2.5 text-theme-sm font-medium text-white shadow-theme-xs transition-colors hover:bg-red-600"
                onclick="@openConfirm">打開確認彈窗</button>
        <button type="button" class="mt-4 ml-2 inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-theme-sm font-medium text-gray-700 shadow-theme-xs transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400"
                onclick="Ta.confirm({ title: '刪除確認', text: '刪除後不可恢復，確定繼續？', confirmText: '刪除', danger: true })">Ta.confirm 示例</button>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 xl:col-span-2 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">長內容彈窗</h3>
        <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">內容超出高度時使用內部滾動，適用條款、日誌等。</p>
        <button type="button" class="mt-4 inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-theme-sm font-medium text-gray-700 shadow-theme-xs transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400"
                onclick="@openScroll">打開長內容彈窗</button>
    </section>
</div>

<dialog id="demo-modal-basic" class="ta-dialog">
    <div class="ta-dialog-card max-w-lg">
        <div class="flex items-start justify-between gap-4">
            <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">彈窗標題</h3>
            <button type="button" class="inline-flex size-9 items-center justify-center rounded-lg text-gray-400 transition-colors hover:bg-gray-100 hover:text-gray-700 dark:hover:bg-white/5 dark:hover:text-gray-300"
                    data-dialog-close aria-label="關閉">
                <partial name="_Icon" model="@("close")" />
            </button>
        </div>
        <p class="mt-4 text-theme-sm leading-6 text-gray-600 dark:text-gray-400">
            這是彈窗內容區域，可放置表單、說明或與當前頁面相關的補充資訊。
        </p>
        <div class="mt-6 flex flex-col-reverse justify-end gap-3 sm:flex-row">
            <button type="button" class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-theme-sm font-medium text-gray-700 shadow-theme-xs transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400" data-dialog-close>取消</button>
            <button type="button" class="inline-flex items-center justify-center rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white shadow-theme-xs transition-colors hover:bg-brand-600" data-dialog-close>確認</button>
        </div>
    </div>
</dialog>

<dialog id="demo-modal-confirm" class="ta-dialog">
    <div class="ta-dialog-card max-w-md">
        <div class="flex items-start gap-4">
            <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-red-50 text-red-500 dark:bg-red-500/15 dark:text-red-400">
                <partial name="_Icon" model="@("alert")" />
            </span>
            <div class="min-w-0">
                <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">刪除確認</h3>
                <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">刪除後不可恢復，確定繼續？</p>
            </div>
        </div>
        <div class="mt-6 flex flex-col-reverse justify-end gap-3 sm:flex-row">
            <button type="button" class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-theme-sm font-medium text-gray-700 shadow-theme-xs transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400" data-dialog-close>取消</button>
            <button type="button" class="inline-flex items-center justify-center rounded-lg bg-red-500 px-4 py-2.5 text-theme-sm font-medium text-white shadow-theme-xs transition-colors hover:bg-red-600" data-dialog-close>刪除</button>
        </div>
    </div>
</dialog>

<dialog id="demo-modal-scroll" class="ta-dialog">
    <div class="ta-dialog-card max-w-2xl">
        <div class="flex items-start justify-between gap-4">
            <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">服務條款</h3>
            <button type="button" class="inline-flex size-9 items-center justify-center rounded-lg text-gray-400 transition-colors hover:bg-gray-100 hover:text-gray-700 dark:hover:bg-white/5 dark:hover:text-gray-300"
                    data-dialog-close aria-label="關閉">
                <partial name="_Icon" model="@("close")" />
            </button>
        </div>
        <div class="mt-4 space-y-4 text-theme-sm leading-6 text-gray-600 dark:text-gray-400">
            @for (var index = 1; index <= 8; index++)
            {
                <p>第 @index 條：這是用於演示長內容滾動的示例條款文字，實際使用時請替換為真實的服務條款內容。</p>
            }
        </div>
        <div class="mt-6 flex justify-end">
            <button type="button" class="inline-flex items-center justify-center rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white shadow-theme-xs transition-colors hover:bg-brand-600" data-dialog-close>我已閱讀</button>
        </div>
    </div>
</dialog>

<div class="mt-4 grid grid-cols-1 gap-4 md:mt-6 md:gap-6 xl:grid-cols-2">
    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">尺寸</h3>
        <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">同一結構切換 sm / md / lg 寬度</p>
        <div class="mt-4 flex flex-wrap gap-2">
            <button type="button" class="rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-theme-sm font-medium text-gray-700 shadow-theme-xs hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400"
                    onclick="document.getElementById('modalSizeSm').showModal()">小彈窗</button>
            <button type="button" class="rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-theme-sm font-medium text-gray-700 shadow-theme-xs hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400"
                    onclick="document.getElementById('modalSizeMd').showModal()">標準彈窗</button>
            <button type="button" class="rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white shadow-theme-xs hover:bg-brand-600"
                    onclick="document.getElementById('modalSizeLg').showModal()">大彈窗</button>
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">狀態與表單</h3>
        <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">表單彈窗與危險確認</p>
        <div class="mt-4 flex flex-wrap gap-2">
            <button type="button" class="rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white shadow-theme-xs hover:bg-brand-600"
                    onclick="document.getElementById('modalForm').showModal()">表單彈窗</button>
            <button type="button" class="rounded-lg bg-red-500 px-4 py-2.5 text-theme-sm font-medium text-white shadow-theme-xs hover:bg-red-600"
                    onclick="document.getElementById('modalDanger').showModal()">危險確認</button>
        </div>
    </section>
</div>

<dialog id="modalSizeSm" class="m-auto w-[92vw] max-w-sm rounded-2xl border border-gray-200 bg-white p-5 shadow-xl backdrop:bg-gray-900/50 dark:border-gray-800 dark:bg-gray-900">
    <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">小彈窗</h3>
    <p class="mt-2 text-theme-sm text-gray-500 dark:text-gray-400">適合簡單提示或單一操作確認。</p>
    <form method="dialog" class="mt-5 flex justify-end">
        <button class="rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white hover:bg-brand-600">知道了</button>
    </form>
</dialog>

<dialog id="modalSizeMd" class="m-auto w-[92vw] max-w-md rounded-2xl border border-gray-200 bg-white p-6 shadow-xl backdrop:bg-gray-900/50 dark:border-gray-800 dark:bg-gray-900">
    <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">標準彈窗</h3>
    <p class="mt-2 text-theme-sm leading-6 text-gray-500 dark:text-gray-400">適合常規表單、詳情與二次確認，標題與操作區保持固定間距。</p>
    <form method="dialog" class="mt-5 flex justify-end gap-3">
        <button class="rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-white/5">取消</button>
        <button class="rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white hover:bg-brand-600">確認</button>
    </form>
</dialog>

<dialog id="modalSizeLg" class="m-auto w-[94vw] max-w-2xl rounded-2xl border border-gray-200 bg-white p-6 shadow-xl backdrop:bg-gray-900/50 dark:border-gray-800 dark:bg-gray-900">
    <div class="flex items-start justify-between gap-4">
        <div>
            <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">大彈窗</h3>
            <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">適合較多欄位或需要分欄展示的內容</p>
        </div>
        <form method="dialog">
            <button class="rounded-lg p-1.5 text-gray-400 hover:bg-gray-100 hover:text-gray-700 dark:hover:bg-white/5 dark:hover:text-gray-300" aria-label="關閉">
                <partial name="_Icon" model="@("close")" />
            </button>
        </form>
    </div>
    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
            <label class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400" for="modal-lg-title">商品名稱</label>
            <input id="modal-lg-title" type="text" placeholder="輸入名稱"
                   class="h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 text-theme-sm text-gray-800 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
        </div>
        <div>
            <label class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400" for="modal-lg-price">售價</label>
            <input id="modal-lg-price" type="number" placeholder="0.00"
                   class="h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 text-theme-sm text-gray-800 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
        </div>
        <div class="sm:col-span-2">
            <label class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400" for="modal-lg-desc">描述</label>
            <textarea id="modal-lg-desc" rows="3" placeholder="簡要描述"
                      class="w-full rounded-lg border border-gray-300 bg-transparent px-4 py-3 text-theme-sm text-gray-800 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90"></textarea>
        </div>
    </div>
    <form method="dialog" class="mt-5 flex justify-end gap-3">
        <button class="rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-white/5">取消</button>
        <button class="rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white hover:bg-brand-600">保存</button>
    </form>
</dialog>

<dialog id="modalForm" class="m-auto w-[92vw] max-w-md rounded-2xl border border-gray-200 bg-white p-6 shadow-xl backdrop:bg-gray-900/50 dark:border-gray-800 dark:bg-gray-900">
    <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">新增標籤</h3>
    <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">提交後會寫入目前商品</p>
    <form method="dialog" class="mt-4 space-y-4">
        <div>
            <label class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400" for="modal-tag">標籤名稱</label>
            <input id="modal-tag" type="text" placeholder="例如：限量"
                   class="h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 text-theme-sm text-gray-800 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
        </div>
        <div class="flex justify-end gap-3">
            <button class="rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400">取消</button>
            <button class="rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white hover:bg-brand-600">新增</button>
        </div>
    </form>
</dialog>

<dialog id="modalDanger" class="m-auto w-[92vw] max-w-sm rounded-2xl border border-gray-200 bg-white p-6 text-center shadow-xl backdrop:bg-gray-900/50 dark:border-gray-800 dark:bg-gray-900">
    <span class="mx-auto flex size-12 items-center justify-center rounded-full bg-red-50 text-red-500 dark:bg-red-500/15 dark:text-red-400">
        <partial name="_Icon" model="@("trash")" />
    </span>
    <h3 class="mt-3 text-base font-semibold text-gray-800 dark:text-white/90">刪除這個商品？</h3>
    <p class="mt-1 text-theme-sm leading-6 text-gray-500 dark:text-gray-400">刪除後無法恢復，相關圖片與規格也會一併移除。</p>
    <form method="dialog" class="mt-5 flex justify-center gap-3">
        <button class="rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-white/5">取消</button>
        <button class="rounded-lg bg-red-500 px-4 py-2.5 text-theme-sm font-medium text-white hover:bg-red-600">確認刪除</button>
    </form>
</dialog>
