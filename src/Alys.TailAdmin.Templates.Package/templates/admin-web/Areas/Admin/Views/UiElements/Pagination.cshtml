@{
    var buttonBase = "inline-flex h-9 min-w-9 items-center justify-center rounded-lg border px-2 text-theme-sm font-medium shadow-theme-xs transition-colors";
    var activeClass = "border-brand-500 bg-brand-500 text-white";
    var idleClass = "border-gray-300 bg-white text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-white/5";
    var arrowClass = "inline-flex size-9 items-center justify-center rounded-lg border border-gray-300 bg-white text-gray-700 shadow-theme-xs transition-colors hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-40 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-white/5";
}
<div class="flex flex-col gap-4 md:gap-6">
    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">完整分頁</h3>
        <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">上一頁 / 頁碼 / 下一頁，頁碼超出範圍時自動禁用。</p>
        <div class="mt-4 flex flex-wrap items-center gap-2" x-data="{ page: 3, total: 8 }">
            <button type="button" class="@arrowClass" x-bind:disabled="page <= 1" x-on:click="page = Math.max(1, page - 1)" aria-label="上一頁">
                <partial name="_Icon" model="@("chevron-left")" />
            </button>
            <template x-for="i in total" :key="i">
                <button type="button" class="@buttonBase"
                        x-bind:class="page === i ? '@activeClass' : '@idleClass'"
                        x-on:click="page = i" x-text="i"></button>
            </template>
            <button type="button" class="@arrowClass" x-bind:disabled="page >= total" x-on:click="page = Math.min(total, page + 1)" aria-label="下一頁">
                <partial name="_Icon" model="@("chevron-right")" />
            </button>
            <span class="ml-2 text-theme-sm text-gray-500 dark:text-gray-400">第 <span x-text="page"></span> / <span x-text="total"></span> 頁</span>
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">純頁碼</h3>
        <div class="mt-4 flex flex-wrap items-center gap-2">
            <button type="button" class="@buttonBase @activeClass">1</button>
            <button type="button" class="@buttonBase @idleClass">2</button>
            <button type="button" class="@buttonBase @idleClass">3</button>
            <span class="px-1 text-theme-sm text-gray-400">…</span>
            <button type="button" class="@buttonBase @idleClass">12</button>
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">簡潔模式</h3>
        <div class="mt-4 flex items-center gap-3">
            <button type="button" class="inline-flex items-center gap-1 rounded-lg border border-gray-300 bg-white px-3 py-2 text-theme-sm font-medium text-gray-700 shadow-theme-xs transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400">
                <partial name="_Icon" model="@("chevron-left")" />
                上一頁
            </button>
            <span class="text-theme-sm text-gray-500 dark:text-gray-400">第 3 頁，共 8 頁</span>
            <button type="button" class="inline-flex items-center gap-1 rounded-lg border border-gray-300 bg-white px-3 py-2 text-theme-sm font-medium text-gray-700 shadow-theme-xs transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400">
                下一頁
                <partial name="_Icon" model="@("chevron-right")" />
            </button>
        </div>
    </section>

    <section class="rounded-2xl border border-dashed border-gray-300 p-5 text-theme-sm leading-6 text-gray-500 md:p-6 dark:border-gray-700 dark:text-gray-400">
        `_TaTable` 已内置分页（`_Pagination`），支持每页条数切换、页码省略与总数展示；本页仅演示独立分页样式。
    </section>
</div>

<div class="mt-4 grid grid-cols-1 gap-4 md:mt-6 md:gap-6 xl:grid-cols-2">
    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">帶省略號</h3>
        <div class="mt-4 flex items-center gap-1">
            <button type="button" class="rounded-lg border border-gray-300 px-3 py-2 text-theme-sm text-gray-600 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-white/5">上一頁</button>
            <span class="rounded-lg bg-brand-500 px-3.5 py-2 text-theme-sm font-medium text-white">1</span>
            <button type="button" class="rounded-lg px-3.5 py-2 text-theme-sm text-gray-600 hover:bg-gray-50 dark:text-gray-400 dark:hover:bg-white/5">2</button>
            <button type="button" class="rounded-lg px-3.5 py-2 text-theme-sm text-gray-600 hover:bg-gray-50 dark:text-gray-400 dark:hover:bg-white/5">3</button>
            <span class="px-2 text-gray-400">…</span>
            <button type="button" class="rounded-lg px-3.5 py-2 text-theme-sm text-gray-600 hover:bg-gray-50 dark:text-gray-400 dark:hover:bg-white/5">12</button>
            <button type="button" class="rounded-lg border border-gray-300 px-3 py-2 text-theme-sm text-gray-600 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-white/5">下一頁</button>
        </div>
        <h4 class="mt-6 text-sm font-medium text-gray-700 dark:text-gray-300">小尺寸</h4>
        <div class="mt-3 flex items-center gap-1">
            <button type="button" class="rounded-md border border-gray-300 px-2.5 py-1.5 text-theme-xs text-gray-600 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400">‹</button>
            <span class="rounded-md bg-brand-500 px-2.5 py-1.5 text-theme-xs font-medium text-white">1</span>
            <button type="button" class="rounded-md px-2.5 py-1.5 text-theme-xs text-gray-600 hover:bg-gray-50 dark:text-gray-400">2</button>
            <button type="button" class="rounded-md px-2.5 py-1.5 text-theme-xs text-gray-600 hover:bg-gray-50 dark:text-gray-400">3</button>
            <button type="button" class="rounded-md border border-gray-300 px-2.5 py-1.5 text-theme-xs text-gray-600 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400">›</button>
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">簡潔與資訊</h3>
        <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
            <p class="text-theme-sm text-gray-500 dark:text-gray-400">第 2 頁，共 12 頁</p>
            <div class="flex items-center gap-2">
                <button type="button" class="rounded-lg border border-gray-300 px-3 py-2 text-theme-xs text-gray-600 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400">上一頁</button>
                <button type="button" class="rounded-lg border border-gray-300 px-3 py-2 text-theme-xs text-gray-600 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400">下一頁</button>
            </div>
        </div>
        <div class="mt-6 flex flex-wrap items-center justify-between gap-3 rounded-xl bg-gray-50 px-4 py-3 dark:bg-white/5">
            <p class="text-theme-xs text-gray-500 dark:text-gray-400">共 128 條，每頁 10 條</p>
            <select class="h-9 rounded-lg border border-gray-300 bg-transparent px-2 text-theme-xs text-gray-700 focus:border-brand-300 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-gray-300">
                <option>10 條 / 頁</option>
                <option>20 條 / 頁</option>
                <option>50 條 / 頁</option>
            </select>
        </div>
    </section>
</div>
