            <p class="text-theme-sm font-semibold text-gray-800 dark:text-white/90">無線藍牙耳機 Pro</p>
            <div class="mt-1 flex items-center gap-2">
                <span class="text-theme-sm font-semibold text-brand-600 dark:text-brand-400">$89</span>
                <span class="text-theme-xs text-gray-400 line-through">$129</span>
            </div>
            <button type="button" class="mt-3 w-full rounded-lg bg-brand-500 py-2 text-theme-xs font-medium text-white hover:bg-brand-600"
                    onclick="Ta.toast.success('已加入購物車（演示）')">加入購物車</button>
        </div>
