<div class="grid grid-cols-1 gap-4 md:gap-6 xl:grid-cols-12">
    <section class="overflow-hidden rounded-2xl border border-gray-200 bg-white xl:col-span-7 dark:border-gray-800 dark:bg-white/[0.03]"
             x-data="{ items: [ { id: 1, title: '雙十一活動已上線', desc: '主視覺與商品長圖已同步到首頁', time: '5 分鐘前', unread: true, tone: 'brand' }, { id: 2, title: '3 張高優先級工單待處理', desc: '客服小組需要你的分配', time: '20 分鐘前', unread: true, tone: 'red' }, { id: 3, title: '本週營運週報已生成', desc: '銷售額環比增長 8.6%', time: '昨天', unread: false, tone: 'green' }, { id: 4, title: '庫存預警：藍牙耳機剩 6 件', desc: '建議今日安排補貨', time: '昨天', unread: false, tone: 'amber' } ] }">
        <div class="flex items-center justify-between border-b border-gray-100 px-5 py-4 dark:border-gray-800">
            <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">通知列表</h3>
            <button type="button" class="text-theme-xs font-medium text-brand-500 hover:text-brand-600 dark:text-brand-400"
                    x-on:click="items.forEach(i => i.unread = false); Ta.toast.success('已全部標為已讀（演示）')">全部標為已讀</button>
        </div>
        <ul class="divide-y divide-gray-100 dark:divide-gray-800">
            <template x-for="item in items" :key="item.id">
                <li class="flex gap-3 px-5 py-4 transition-colors hover:bg-gray-50 dark:hover:bg-white/[0.02]"
                    x-bind:class="item.unread ? 'bg-brand-50/30 dark:bg-brand-500/5' : ''">
                    <span class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-lg"
                          x-bind:class="item.tone === 'red' ? 'bg-red-50 text-red-500 dark:bg-red-500/15 dark:text-red-400' : item.tone === 'green' ? 'bg-green-50 text-green-600 dark:bg-green-500/15 dark:text-green-400' : item.tone === 'amber' ? 'bg-amber-50 text-amber-600 dark:bg-amber-500/15 dark:text-amber-400' : 'bg-brand-50 text-brand-500 dark:bg-brand-500/15 dark:text-brand-400'">
                        <partial name="_Icon" model="@("bell")" />
                    </span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-start justify-between gap-2">
                            <p class="text-theme-sm font-medium text-gray-800 dark:text-white/90" x-text="item.title"></p>
                            <span class="size-2 shrink-0 rounded-full bg-brand-500" x-show="item.unread"></span>
                        </div>
                        <p class="mt-0.5 text-theme-xs text-gray-500 dark:text-gray-400" x-text="item.desc"></p>
                        <p class="mt-1 text-[10px] text-gray-400 dark:text-gray-500" x-text="item.time"></p>
                    </div>
                    <button type="button" class="self-start rounded p-1 text-gray-400 hover:bg-gray-100 hover:text-gray-700 dark:hover:bg-white/5 dark:hover:text-gray-300"
                            x-on:click="items = items.filter(i => i.id !== item.id)" aria-label="移除通知">
                        <partial name="_Icon" model="@("close")" />
                    </button>
                </li>
            </template>
        </ul>
    </section>

    <aside class="space-y-4 md:space-y-6 xl:col-span-5">
        <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
            <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">浮層提示</h3>
            <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">點擊按鈕觸發右上角 Toast</p>
            <div class="mt-4 flex flex-wrap gap-2">
                <button type="button" class="rounded-lg bg-green-500 px-3 py-2 text-theme-xs font-medium text-white hover:bg-green-600"
                        onclick="Ta.toast.success('操作成功（演示）')">成功</button>
                <button type="button" class="rounded-lg bg-red-500 px-3 py-2 text-theme-xs font-medium text-white hover:bg-red-600"
                        onclick="Ta.toast.error('操作失敗（演示）')">錯誤</button>
                <button type="button" class="rounded-lg bg-brand-500 px-3 py-2 text-theme-xs font-medium text-white hover:bg-brand-600"
                        onclick="Ta.toast.info('提示訊息（演示）')">提示</button>
            </div>
        </section>

        <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
            <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">通知樣式</h3>
            <div class="mt-4 space-y-3">
                <div class="flex items-start gap-3 rounded-xl border border-green-200 bg-green-50 p-3 dark:border-green-500/30 dark:bg-green-500/10">
                    <span class="text-green-600 dark:text-green-400"><partial name="_Icon" model="@("check")" /></span>
                    <p class="text-theme-sm text-green-700 dark:text-green-400">商品已成功發佈。</p>
                </div>
                <div class="flex items-start gap-3 rounded-xl border border-amber-200 bg-amber-50 p-3 dark:border-amber-500/30 dark:bg-amber-500/10">
                    <span class="text-amber-600 dark:text-amber-400"><partial name="_Icon" model="@("alert")" /></span>
                    <p class="text-theme-sm text-amber-700 dark:text-amber-400">有 3 張工單即將超時。</p>
                </div>
                <div class="flex items-start gap-3 rounded-xl border border-red-200 bg-red-50 p-3 dark:border-red-500/30 dark:bg-red-500/10">
                    <span class="text-red-600 dark:text-red-400"><partial name="_Icon" model="@("close")" /></span>
                    <p class="text-theme-sm text-red-700 dark:text-red-400">付款失敗，請更新付款方式。</p>
                </div>
            </div>
        </section>
    </aside>
</div>
