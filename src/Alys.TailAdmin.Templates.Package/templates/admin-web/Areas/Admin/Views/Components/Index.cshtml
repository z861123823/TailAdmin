<div class="grid grid-cols-1 gap-4 xl:grid-cols-2 md:gap-6">
    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">按鈕</h3>
        <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">Button / ButtonGroup，支持圖標、尺寸與禁用態。</p>
        <div class="mt-4 flex flex-wrap items-center gap-3">
            @foreach (var button in buttons)
            {
                <partial name="_TaButton" model="button" />
            }
        </div>
        <div class="mt-5">
            <partial name="_TaButtonGroup" model="buttonGroup" />
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">徽章</h3>
        <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">Badge，支持圓點、圖標與多種色彩。</p>
        <div class="mt-4 flex flex-wrap items-center gap-2">
            @foreach (var badge in badges)
            {
                <partial name="_TaBadge" model="badge" />
            }
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">提示</h3>
        <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">Alert，支持關閉與狀態圖標。</p>
        <div class="mt-4 flex flex-col gap-3">
            @foreach (var alert in alerts)
            {
                <partial name="_TaAlert" model="alert" />
            }
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">頭像</h3>
        <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">Avatar / AvatarGroup，支持尺寸、狀態與重疊分組。</p>
        <div class="mt-4 flex flex-wrap items-end gap-4">
            @foreach (var avatar in avatars)
            {
                <partial name="_TaAvatar" model="avatar" />
            }
        </div>
        <div class="mt-6">
            <partial name="_TaAvatarGroup" model="avatarGroup" />
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">麵包屑</h3>
        <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">Breadcrumb，最後一項自動作為當前頁。</p>
        <div class="mt-4">
            <partial name="_TaBreadcrumb" model="breadcrumb" />
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">下拉選單</h3>
        <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">Dropdown，支持分隔線、危險項與點擊外部關閉。</p>
        <div class="mt-4">
            <partial name="_TaDropdown" model="dropdown" />
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 xl:col-span-2 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">卡片</h3>
        <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">Card，統一圓角、邊框、內邊距與深色模式。</p>
        <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
            @foreach (var card in cards)
            {
                <partial name="_TaCard" model="card" />
            }
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">輪播</h3>
        <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">Carousel，鍵盤可聚焦的左右切換與指示點。</p>
        <div class="mt-4">
            <partial name="_TaCarousel" model="carousel" />
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">圖片</h3>
        <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">Images，自適應列數與比例。</p>
        <div class="mt-4">
            <partial name="_TaImages" model="images" />
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">連結</h3>
        <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">Link，統一連結色彩與外鏈標識。</p>
        <div class="mt-4 flex flex-col items-start gap-3">
            @foreach (var link in links)
            {
                <partial name="_TaLink" model="link" />
            }
        </div>
    </section>

    <section class="overflow-hidden rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="p-5 md:p-6">
            <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">列表</h3>
            <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">List，支持圖標、描述、徽章與當前項高亮。</p>
        </div>
        <partial name="_TaList" model="list" />
    </section>
</div>

@functions {
    /// <summary>生成自包含的漸變 SVG 圖片，避免示例頁依賴外部圖床。</summary>
    /// <param name="from">起始顏色。</param>
    /// <param name="to">結束顏色。</param>
    /// <param name="variant">圖形變體。</param>
    /// <returns>可直接用於 img src 的 Data URI。</returns>
    private static string Swatch(string from, string to, int variant)
    {
        var shape = variant % 2 == 0
            ? "<circle cx='620' cy='180' r='210' fill='white' fill-opacity='0.14'/>"
            : "<rect x='420' y='360' width='520' height='520' fill='white' fill-opacity='0.12' transform='rotate(18 680 620)'/>";
        var svg = "<svg xmlns='http://www.w3.org/2000/svg' width='800' height='800'>"
            + "<defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'>"
            + $"<stop offset='0' stop-color='{from}'/><stop offset='1' stop-color='{to}'/>"
            + "</linearGradient></defs>"
            + "<rect width='800' height='800' fill='url(#g)'/>"
            + shape
            + "</svg>";
        return "data:image/svg+xml;utf8," + Uri.EscapeDataString(svg);
    }
}
