@{
    var table = new TaTableModel
    {
        Id = "demoDataTable",
        Url = Url.Action("List", "Goods", new { area = "Admin" }) ?? string.Empty,
        RowKey = "Id",
        PageSize = 10,
        EmptyText = "暫無數據",
        StickyHeader = true,
        ScrollHeight = "520px",
        Columns = new List<TaColumnModel>
        {
            new() { Key = "GoodsName", Label = "商品名稱", Fixed = "left", Width = 200 },
            new() { Key = "TypeName", Label = "分類", Sortable = false },
            new() { Key = "Price", Label = "價格", Type = "money", Align = "right" },
            new() { Key = "SalesVolume", Label = "銷量", Type = "number", Align = "right" },
            new() { Key = "IsHot", Label = "熱銷", Type = "bool", Align = "center", Sortable = false },
            new() { Key = "AddTime", Label = "上架時間", Type = "date" }
        }
    };
    var toolbar = new TableToolbarModel
    {
        TableId = "demoDataTable",
        Description = "數據來自示例宿主商品接口，支持分頁、排序與關鍵字查詢",
        Placeholder = "搜索商品名稱"
    };
}
<div class="mb-4 grid grid-cols-1 gap-3 sm:grid-cols-3 md:mb-6">
    <div class="flex items-center justify-between rounded-xl border border-gray-200 bg-white px-4 py-3 dark:border-gray-800 dark:bg-white/[0.03]">
        <span class="text-theme-sm text-gray-500 dark:text-gray-400">總記錄</span>
        <span class="text-theme-sm font-semibold text-gray-800 dark:text-white/90">36</span>
    </div>
    <div class="flex items-center justify-between rounded-xl border border-gray-200 bg-white px-4 py-3 dark:border-gray-800 dark:bg-white/[0.03]">
        <span class="text-theme-sm text-gray-500 dark:text-gray-400">当前页</span>
        <span class="text-theme-sm font-semibold text-gray-800 dark:text-white/90">10 条</span>
    </div>
    <div class="flex items-center justify-between rounded-xl border border-gray-200 bg-white px-4 py-3 dark:border-gray-800 dark:bg-white/[0.03]">
        <span class="text-theme-sm text-gray-500 dark:text-gray-400">排序</span>
        <span class="text-theme-sm font-semibold text-gray-800 dark:text-white/90">預設</span>
    </div>
</div>

<partial name="_TableToolbar" model="toolbar" />

<partial name="_TaTable" model="table" />
