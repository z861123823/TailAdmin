{
  "$schema": "http://json.schemastore.org/template",
  "author": "Alys",
  "classifications": [ "Web", "Admin", "Alys.TailAdmin" ],
  "identity": "Alys.TailAdmin.Templates.AdminWeb",
  "name": "Alys.TailAdmin 通用后台模板",
  "shortName": "alys-admin",
  "sourceName": "AlysAdminHost",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "theme": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "als",
      "replaces": "__THEME__",
      "description": "品牌主题名，需与 RCL 的 brand.json 一致"
    },
    "auth": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "cookie", "description": "生成 Cookie 登录与登出示例" },
        { "choice": "none", "description": "不生成鉴权代码" }
      ],
      "defaultValue": "cookie",
      "description": "鉴权方式"
    },
    "sample": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "是否生成示例列表页"
    },
    "authCookie": {
      "type": "computed",
      "value": "(auth == \"cookie\")"
    },
    "sampleEnabled": {
      "type": "computed",
      "value": "(sample)"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!authCookie)",
          "exclude": [
            "Areas/Admin/Controllers/AccountController.cs",
            "Areas/Admin/Views/Account/**",
            "Infrastructure/TemplateCurrentAdmin.cs"
          ]
        },
        {
          "condition": "(!sampleEnabled)",
          "exclude": [
            "Areas/Admin/Controllers/GoodsController.cs",
            "Areas/Admin/Controllers/UiElementsController.cs",
            "Areas/Admin/Controllers/PagesController.cs",
            "Areas/Admin/Controllers/FormsController.cs",
            "Areas/Admin/Controllers/TablesController.cs",
            "Areas/Admin/Controllers/ChartsController.cs",
            "Areas/Admin/Controllers/CalendarController.cs",
            "Areas/Admin/Controllers/ProfileController.cs",
            "Areas/Admin/Controllers/EmptyStateController.cs",
            "Areas/Admin/Controllers/OnboardingController.cs",
            "Areas/Admin/Controllers/EcommerceController.cs",
            "Areas/Admin/Controllers/SupportController.cs",
            "Areas/Admin/Controllers/EmailController.cs",
            "Areas/Admin/Controllers/ChatController.cs",
            "Areas/Admin/Controllers/TasksController.cs",
            "Areas/Admin/Controllers/LayoutsController.cs",
            "Areas/Admin/Views/Goods/**",
            "Areas/Admin/Views/UiElements/**",
            "Areas/Admin/Views/Pages/**",
            "Areas/Admin/Views/Forms/**",
            "Areas/Admin/Views/Tables/**",
            "Areas/Admin/Views/Charts/**",
            "Areas/Admin/Views/Calendar/**",
            "Areas/Admin/Views/Profile/**",
            "Areas/Admin/Views/EmptyState/**",
            "Areas/Admin/Views/Onboarding/**",
            "Areas/Admin/Views/Ecommerce/**",
            "Areas/Admin/Views/Support/**",
            "Areas/Admin/Views/Email/**",
            "Areas/Admin/Views/Chat/**",
            "Areas/Admin/Views/Tasks/**",
            "Areas/Admin/Views/Layouts/**"
          ]
        }
      ]
    }
  ]
}
