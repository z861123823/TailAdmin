@model TaDropdownModel
@{
    var triggerClass = TaUiStyle.Button(Model.Variant, Model.Size);
    var width = (Model.Width ?? "md").ToLowerInvariant() switch
    {
        "sm" => "w-40",
        "lg" => "w-60",
        _ => "w-48"
    };
    var align = string.Equals(Model.Align, "right", StringComparison.OrdinalIgnoreCase) ? "right-0" : "left-0";
}
<div class="relative inline-block text-left @Model.CssClass"
     x-data="{ open: false }"
     x-on:click.outside="open = false"
     x-on:keydown.escape.window="open = false">
    <button type="button" class="@triggerClass" x-on:click="open = !open"
            x-bind:aria-expanded="open" aria-haspopup="menu">
        @if (!string.IsNullOrWhiteSpace(Model.TriggerIcon))
        {
            <partial name="_Icon" model="@(Model.TriggerIcon ?? string.Empty)" />
        }
        @Model.TriggerText
        <partial name="_Icon" model="@("chevron-down")" />
    </button>

    <div class="absolute z-50 mt-2 @width @align rounded-xl border border-gray-200 bg-white p-2 shadow-theme-lg dark:border-gray-800 dark:bg-gray-900"
         x-show="open" x-transition.opacity.duration.150ms x-cloak role="menu">
        @foreach (var item in Model.Items)
        {
            if (item.DividerBefore)
            {
                <div class="my-1 border-t border-gray-100 dark:border-gray-800"></div>
            }

            var itemClass = "flex w-full items-center gap-2 rounded-lg px-3 py-2 text-theme-sm font-medium transition-colors "
                + (item.Danger
                    ? "text-red-600 hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-500/10"
                    : "text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5")
                + (item.Disabled ? " pointer-events-none opacity-50" : string.Empty);

            if (!string.IsNullOrWhiteSpace(item.Url))
            {
                <a href="@item.Url" class="@itemClass" role="menuitem">
                    @if (!string.IsNullOrWhiteSpace(item.Icon))
                    {
                        <span class="inline-flex [&_svg]:size-4">
                            <partial name="_Icon" model="@(item.Icon ?? string.Empty)" />
                        </span>
                    }
                    @item.Text
                </a>
            }
            else
            {
                <button type="button" class="@itemClass" role="menuitem" disabled="@item.Disabled"
                        x-on:click="open = false; @item.OnClick">
                    @if (!string.IsNullOrWhiteSpace(item.Icon))
                    {
                        <span class="inline-flex [&_svg]:size-4">
                            <partial name="_Icon" model="@(item.Icon ?? string.Empty)" />
                        </span>
                    }
                    @item.Text
                </button>
            }
        }
    </div>
</div>
