@model TaBreadcrumbModel
@{
    var items = Model.Items ?? new List<TaBreadcrumbItemModel>();
}
<nav aria-label="麵包屑" class="@Model.CssClass">
    <ol class="flex flex-wrap items-center gap-1.5">
        @if (Model.ShowHome)
        {
            <li>
                <a class="inline-flex items-center gap-1.5 text-theme-sm text-gray-500 transition-colors hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300"
                   href="@Model.HomeUrl">
                    @Model.HomeText
                    <partial name="_Icon" model="@("chevron-right")" />
                </a>
            </li>
        }
        @for (var index = 0; index < items.Count; index++)
        {
            var item = items[index];
            var isLast = index == items.Count - 1;
            <li class="inline-flex items-center gap-1.5">
                @if (!isLast && !string.IsNullOrWhiteSpace(item.Url))
                {
                    <a class="text-theme-sm text-gray-500 transition-colors hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300"
                       href="@item.Url">@item.Text</a>
                    <partial name="_Icon" model="@("chevron-right")" />
                }
                else
                {
                    <span class="text-theme-sm font-medium text-gray-800 dark:text-white/90" aria-current="page">@item.Text</span>
                }
            </li>
        }
    </ol>
</nav>
