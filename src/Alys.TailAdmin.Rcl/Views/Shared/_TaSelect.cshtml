@model TaSelectModel
@using System.Text.Json
@{
    var selectId = string.IsNullOrWhiteSpace(Model.Id) ? Model.Name : Model.Id;
    var current = Model.Options.FirstOrDefault(o => string.Equals(o.Value, Model.Value, StringComparison.OrdinalIgnoreCase));
    var state = new Dictionary<string, object?>
    {
        ["open"] = false,
        ["value"] = Model.Value ?? string.Empty,
        ["label"] = current?.Text ?? string.Empty,
        ["placeholder"] = Model.Placeholder,
        ["options"] = Model.Options.Select(o => new { v = o.Value, t = o.Text }).ToList()
    };
    var stateJson = JsonSerializer.Serialize(state).Replace("'", "\\u0027");

    var triggerClass = "flex h-11 w-full cursor-pointer items-center justify-between gap-3 rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-left text-theme-sm shadow-theme-xs transition-colors focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden disabled:cursor-not-allowed disabled:opacity-60 dark:border-gray-700 dark:bg-gray-900 dark:focus:border-brand-800";
    var valueClass = string.IsNullOrEmpty(current?.Text)
        ? "truncate text-gray-400 dark:text-gray-500"
        : "truncate text-gray-800 dark:text-white/90";
}
<div class="relative @Model.CssClass" x-data='@stateJson' x-on:keydown.escape="open = false">
    <input type="hidden" id="@selectId" name="@Model.Name" value="@Model.Value" x-bind:value="value" />
    <button type="button"
            class="@triggerClass"
            x-on:click="open = !open"
            x-bind:aria-expanded="open"
            aria-haspopup="listbox"
            disabled="@Model.Disabled">
        <span class="@valueClass" x-text="label || placeholder" x-bind:class="value ? 'text-gray-800 dark:text-white/90' : 'text-gray-400 dark:text-gray-500'">@(current?.Text ?? Model.Placeholder)</span>
        <span class="shrink-0 text-gray-400 transition-transform duration-150 [&_svg]:size-5 dark:text-gray-500"
              x-bind:class="open && 'rotate-180'">
            <partial name="_Icon" model="@("chevron-down")" />
        </span>
    </button>

    <div class="absolute right-0 left-0 z-50 mt-1.5 max-h-60 overflow-auto rounded-lg border border-gray-200 bg-white p-1.5 shadow-theme-lg dark:border-gray-700 dark:bg-gray-900"
         x-show="open"
         x-cloak
         x-transition.opacity.duration.150ms
         role="listbox">
        <template x-for="option in options" :key="option.v">
            <button type="button"
                    class="flex w-full items-center justify-between gap-3 rounded-md px-3 py-2 text-left text-theme-sm transition-colors"
                    x-bind:class="value === option.v ? 'bg-brand-50 font-medium text-brand-600 dark:bg-brand-500/15 dark:text-brand-400' : 'text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5'"
                    x-bind:aria-selected="value === option.v"
                    x-on:click="value = option.v; label = option.t; open = false"
                    role="option">
                <span class="truncate" x-text="option.t"></span>
                <span class="shrink-0 text-brand-500 [&_svg]:size-4 dark:text-brand-400" x-show="value === option.v">
                    <partial name="_Icon" model="@("check")" />
                </span>
            </button>
        </template>
    </div>
</div>
