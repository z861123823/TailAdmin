@model TaCardModel
@{
    var padding = Model.Padding ? "p-5 md:p-6" : string.Empty;
    var hasHeader = !string.IsNullOrWhiteSpace(Model.Title)
        || !string.IsNullOrWhiteSpace(Model.Subtitle)
        || !string.IsNullOrWhiteSpace(Model.Icon)
        || (!string.IsNullOrWhiteSpace(Model.Href) && !string.IsNullOrWhiteSpace(Model.LinkText));
}
<div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] @(Model.Hoverable ? "transition-shadow hover:shadow-theme-md" : null) @Model.CssClass">
    <div class="@padding">
        @if (hasHeader)
        {
            <div class="flex items-start justify-between gap-4">
                <div class="flex min-w-0 items-start gap-3">
                    @if (!string.IsNullOrWhiteSpace(Model.Icon))
                    {
                        <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-500 dark:bg-brand-500/15 dark:text-brand-400">
                            <partial name="_Icon" model="@(Model.Icon ?? string.Empty)" />
                        </span>
                    }
                    <div class="min-w-0">
                        @if (!string.IsNullOrWhiteSpace(Model.Title))
                        {
                            <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">@Model.Title</h3>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
                        {
                            <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">@Model.Subtitle</p>
                        }
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Href))
                {
                    <a href="@Model.Href"
                       class="inline-flex shrink-0 items-center gap-1 rounded-lg border border-gray-300 bg-white px-3 py-2 text-theme-xs font-medium text-gray-700 shadow-theme-xs transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-white/5">
                        @Model.LinkText
                        <partial name="_Icon" model="@("chevron-right")" />
                    </a>
                }
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Text))
        {
            <p class="text-theme-sm leading-6 text-gray-600 dark:text-gray-400 @(hasHeader ? "mt-4" : null)">@Model.Text</p>
        }
        @if (Model.Body is not null)
        {
            <div class="text-theme-sm leading-6 text-gray-600 dark:text-gray-400 @(hasHeader ? "mt-4" : null)">@Model.Body</div>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.FooterText))
    {
        <div class="border-t border-gray-100 px-5 py-4 text-theme-sm text-gray-500 md:px-6 dark:border-gray-800 dark:text-gray-400">
            @Model.FooterText
        </div>
    }
</div>
