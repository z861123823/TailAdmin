{
  "name": "tailadmin-admin-web",
  "private": true,
  "version": "1.2.0",
  "description": "TailAdmin 通用后台模板前端构建清单（仅构建期使用，运行时不依赖 Node）",
  "scripts": {
    "build:brand": "node scripts/gen-brand-css.mjs",
    "build:css": "npm run build:brand && tailwindcss -i src/css/tailwind.css -o ../src/TailAdmin.Templates.Rcl/wwwroot/css/tailadmin.css --minify",
    "build:js": "esbuild src/js/index.js --bundle --minify --format=iife --target=es2019 --legal-comments=none --outfile=../src/TailAdmin.Templates.Rcl/wwwroot/js/tailadmin.js",
    "build": "npm run build:css && npm run build:js"
  },
  "devDependencies": {
    "@alpinejs/collapse": "3.17.5",
    "@alpinejs/persist": "3.17.2",
    "@fontsource/outfit": "^5.2.8",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/forms": "0.5.9",
    "@tanstack/table-core": "8.21.3",
    "alpinejs": "3.17.2",
    "apexcharts": "7.3.0",
    "esbuild": "0.28.2",
    "flatpickr": "4.6.13",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  }
}
