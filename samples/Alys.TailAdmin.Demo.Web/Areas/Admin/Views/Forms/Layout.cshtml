@{
    const string labelClass = "mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400";
    const string inputClass = "h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-theme-sm text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800";
    const string cardClass = "rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]";

    var countrySelect = new TaSelectModel
    {
        Name = "layout-country",
        Id = "layout-country",
        Value = "台灣",
        Options = new()
        {
            new() { Value = "台灣", Text = "台灣" },
            new() { Value = "香港", Text = "香港" },
            new() { Value = "新加坡", Text = "新加坡" }
        }
    };
    var statusSelect = new TaSelectModel
    {
        Name = "layout-status",
        Id = "layout-status",
        Value = "已發佈",
        Options = new()
        {
            new() { Value = "已發佈", Text = "已發佈" },
            new() { Value = "草稿", Text = "草稿" },
            new() { Value = "已下架", Text = "已下架" }
        }
    };
    var inlineStatusSelect = new TaSelectModel
    {
        Name = "inline-status",
        Id = "inline-status",
        Value = "全部",
        Options = new()
        {
            new() { Value = "全部", Text = "全部" },
            new() { Value = "已付款", Text = "已付款" },
            new() { Value = "待付款", Text = "待付款" }
        }
    };
}
<form class="grid grid-cols-12 gap-4 md:gap-6"
      onsubmit="event.preventDefault(); Ta.toast.success('已保存（演示）')">
    <div class="col-span-12 space-y-4 md:space-y-6 xl:col-span-8">
        <section class="@cardClass">
            <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">基本資訊</h3>
            <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div>
                    <label class="@labelClass" for="layout-name">姓名</label>
                    <input id="layout-name" type="text" class="@inputClass" placeholder="請輸入姓名" />
                </div>
                <div>
                    <label class="@labelClass" for="layout-email">郵箱</label>
                    <input id="layout-email" type="email" class="@inputClass" placeholder="you@example.com" />
                </div>
                <div>
                    <label class="@labelClass" for="layout-phone">電話</label>
                    <input id="layout-phone" type="tel" class="@inputClass" placeholder="+886 912 345 678" />
                </div>
                <div>
                    <label class="@labelClass" for="layout-company">公司</label>
                    <input id="layout-company" type="text" class="@inputClass" placeholder="公司名稱" />
                </div>
            </div>
        </section>

        <section class="@cardClass">
            <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">配送地址</h3>
            <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-6">
                <div class="sm:col-span-2">
                    <label class="@labelClass" for="layout-country">國家 / 地區</label>
                    <partial name="_TaSelect" model="countrySelect" />
                </div>
                <div class="sm:col-span-2">
                    <label class="@labelClass" for="layout-city">城市</label>
                    <input id="layout-city" type="text" class="@inputClass" placeholder="台北市" />
                </div>
                <div class="sm:col-span-2">
                    <label class="@labelClass" for="layout-zip">郵遞區號</label>
                    <input id="layout-zip" type="text" class="@inputClass" placeholder="100" />
                </div>
                <div class="sm:col-span-6">
                    <label class="@labelClass" for="layout-address">詳細地址</label>
                    <input id="layout-address" type="text" class="@inputClass" placeholder="街道、門牌號" />
                </div>
            </div>
        </section>
    </div>

    <div class="col-span-12 space-y-4 md:space-y-6 xl:col-span-4">
        <section class="@cardClass">
            <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">發佈設定</h3>
            <div class="mt-4 space-y-4">
                <div>
                    <label class="@labelClass" for="layout-status">狀態</label>
                    <partial name="_TaSelect" model="statusSelect" />
                </div>
                <label class="flex items-center justify-between gap-3 text-theme-sm text-gray-700 dark:text-gray-300">
                    首頁置頂
                    <input type="checkbox" class="peer sr-only" checked />
                    <span class="relative h-6 w-11 rounded-full bg-gray-200 transition-colors after:absolute after:top-0.5 after:left-0.5 after:size-5 after:rounded-full after:bg-white after:transition-transform after:content-[''] peer-checked:bg-brand-500 peer-checked:after:translate-x-5 dark:bg-gray-700"></span>
                </label>
                <div>
                    <label class="@labelClass" for="layout-note">備註</label>
                    <textarea id="layout-note" rows="4"
                              class="w-full rounded-lg border border-gray-300 bg-transparent px-4 py-3 text-theme-sm text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800"
                              placeholder="僅內部可見"></textarea>
                </div>
            </div>
        </section>

        <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
            <button type="reset"
                    class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-theme-sm font-medium text-gray-700 shadow-theme-xs transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400">
                重設
            </button>
            <button type="submit"
                    class="inline-flex items-center justify-center gap-2 rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white shadow-theme-xs transition-colors hover:bg-brand-600">
                <partial name="_Icon" model="@("check")" />
                保存
            </button>
        </div>
    </div>
</form>

<div class="mt-4 space-y-4 md:mt-6 md:space-y-6">
    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">行內表單</h3>
        <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">適合篩選列或後台工具條</p>
        <form class="mt-4 flex flex-wrap items-end gap-3" onsubmit="event.preventDefault(); Ta.toast.success('已套用篩選（演示）')">
            <div class="min-w-[180px] flex-1">
                <label class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400" for="inline-keyword">關鍵字</label>
                <input id="inline-keyword" type="text" placeholder="訂單號 / 客戶名"
                       class="h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-theme-sm text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800" />
            </div>
            <div class="min-w-[140px]">
                <label class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400" for="inline-status">狀態</label>
                <partial name="_TaSelect" model="inlineStatusSelect" />
            </div>
            <div class="min-w-[140px]">
                <label class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400" for="inline-date">日期</label>
                <input id="inline-date" type="text" autocomplete="off" placeholder="選擇日期"
                       class="h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-theme-sm text-gray-800 shadow-theme-xs focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:focus:border-brand-800"
                       x-datepicker />
            </div>
            <button type="submit" class="h-11 rounded-lg bg-brand-500 px-4 text-theme-sm font-medium text-white shadow-theme-xs hover:bg-brand-600">查詢</button>
            <button type="reset" class="h-11 rounded-lg border border-gray-300 bg-white px-4 text-theme-sm font-medium text-gray-700 shadow-theme-xs hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400">重設</button>
        </form>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">三欄表單</h3>
        <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">欄位較多時使用 12 欄網格拆分</p>
        <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-3">
            <div>
                <label class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400" for="grid-name">收件人</label>
                <input id="grid-name" type="text" placeholder="姓名"
                       class="h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-theme-sm text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800" />
            </div>
            <div>
                <label class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400" for="grid-phone">電話</label>
                <input id="grid-phone" type="tel" placeholder="0912 345 678"
                       class="h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-theme-sm text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800" />
            </div>
            <div>
                <label class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400" for="grid-city">城市</label>
                <select id="grid-city"
                        class="h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-theme-sm text-gray-800 shadow-theme-xs focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:focus:border-brand-800">
                    <option>台北市</option>
                    <option>新北市</option>
                    <option>台中市</option>
                    <option>高雄市</option>
                </select>
            </div>
            <div class="md:col-span-2">
                <label class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400" for="grid-address">地址</label>
                <input id="grid-address" type="text" placeholder="街道、門牌、樓層"
                       class="h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-theme-sm text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800" />
            </div>
            <div>
                <label class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400" for="grid-zip">郵遞區號</label>
                <input id="grid-zip" type="text" placeholder="110"
                       class="h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-theme-sm text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800" />
            </div>
            <div class="md:col-span-3">
                <label class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400" for="grid-note">備註</label>
                <textarea id="grid-note" rows="3"
                          class="w-full rounded-lg border border-gray-300 bg-transparent px-4 py-3 text-theme-sm text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800"
                          placeholder="配送時間或其他說明"></textarea>
            </div>
        </div>
    </section>
</div>
