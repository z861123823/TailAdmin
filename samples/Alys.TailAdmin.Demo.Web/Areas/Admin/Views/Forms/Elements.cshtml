@{
    const string labelClass = "mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400";
    const string inputClass = "h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-theme-sm text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800";
    const string hintClass = "mt-1.5 text-theme-xs text-gray-500 dark:text-gray-400";
}
<div class="grid grid-cols-1 gap-4 md:gap-6 xl:grid-cols-2">
    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">文字輸入</h3>
        <div class="mt-4 space-y-4">
            <div>
                <label class="@labelClass" for="demo-text">姓名</label>
                <input id="demo-text" type="text" class="@inputClass" placeholder="請輸入姓名" />
            </div>
            <div>
                <label class="@labelClass" for="demo-email">郵箱</label>
                <input id="demo-email" type="email" class="@inputClass" placeholder="you@example.com" />
                <p class="@hintClass">我們不會向第三方分享你的郵箱。</p>
            </div>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div>
                    <label class="@labelClass" for="demo-password">密碼</label>
                    <input id="demo-password" type="password" class="@inputClass" placeholder="至少 6 位字元" />
                </div>
                <div>
                    <label class="@labelClass" for="demo-number">數量</label>
                    <input id="demo-number" type="number" class="@inputClass" value="10" min="1" />
                </div>
            </div>
            <div>
                <label class="@labelClass" for="demo-disabled">禁用狀態</label>
                <input id="demo-disabled" type="text" class="@inputClass cursor-not-allowed opacity-60" value="不可編輯" disabled />
            </div>
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">下拉與日期</h3>
        <div class="mt-4 space-y-4">
            <div>
                <label class="@labelClass" for="demo-select">所屬分類</label>
                <select id="demo-select" class="@inputClass">
                    <option value="">請選擇分類</option>
                    <option value="1">數碼</option>
                    <option value="2">服飾</option>
                    <option value="3">家居</option>
                </select>
            </div>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div>
                    <label class="@labelClass" for="demo-date">日期</label>
                    <input id="demo-date" type="date" class="@inputClass" />
                </div>
                <div>
                    <label class="@labelClass" for="demo-time">時間</label>
                    <input id="demo-time" type="time" class="@inputClass" />
                </div>
            </div>
            <div>
                <label class="@labelClass" for="demo-file">附件</label>
                <input id="demo-file" type="file"
                       class="block w-full cursor-pointer rounded-lg border border-gray-300 bg-transparent text-theme-sm text-gray-500 shadow-theme-xs file:mr-4 file:border-0 file:bg-gray-50 file:px-4 file:py-2.5 file:text-theme-sm file:font-medium file:text-gray-700 hover:file:bg-gray-100 dark:border-gray-700 dark:text-gray-400 dark:file:bg-white/5 dark:file:text-gray-300" />
                <p class="@hintClass">支援 PNG、JPG，單檔不超過 5MB。</p>
            </div>
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">文字域</h3>
        <div class="mt-4">
            <label class="@labelClass" for="demo-textarea">備註</label>
            <textarea id="demo-textarea" rows="5"
                      class="w-full rounded-lg border border-gray-300 bg-transparent px-4 py-3 text-theme-sm text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800"
                      placeholder="請輸入備註內容"></textarea>
            <p class="@hintClass">最多 500 字。</p>
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">複選框與單選框</h3>
        <div class="mt-4 space-y-4">
            <label class="flex items-center gap-3 text-theme-sm text-gray-700 dark:text-gray-300">
                <input type="checkbox" checked
                       class="size-4 rounded border-gray-300 text-brand-500 focus:ring-3 focus:ring-brand-500/20 dark:border-gray-700 dark:bg-gray-900" />
                接收訂單通知
            </label>
            <label class="flex items-center gap-3 text-theme-sm text-gray-700 dark:text-gray-300">
                <input type="checkbox"
                       class="size-4 rounded border-gray-300 text-brand-500 focus:ring-3 focus:ring-brand-500/20 dark:border-gray-700 dark:bg-gray-900" />
                接收行銷郵件
            </label>
            <div class="border-t border-gray-100 pt-4 dark:border-gray-800">
                <p class="@labelClass">配送方式</p>
                <div class="flex flex-wrap items-center gap-5">
                    <label class="flex items-center gap-2 text-theme-sm text-gray-700 dark:text-gray-300">
                        <input type="radio" name="demo-shipping" checked
                               class="size-4 border-gray-300 text-brand-500 focus:ring-3 focus:ring-brand-500/20 dark:border-gray-700 dark:bg-gray-900" />
                        標準配送
                    </label>
                    <label class="flex items-center gap-2 text-theme-sm text-gray-700 dark:text-gray-300">
                        <input type="radio" name="demo-shipping"
                               class="size-4 border-gray-300 text-brand-500 focus:ring-3 focus:ring-brand-500/20 dark:border-gray-700 dark:bg-gray-900" />
                        次日達
                    </label>
                </div>
            </div>
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 xl:col-span-2 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">開關</h3>
        <div class="mt-4 flex flex-wrap items-center gap-8">
            <label class="inline-flex cursor-pointer items-center gap-3">
                <input type="checkbox" class="peer sr-only" checked />
                <span class="relative h-6 w-11 rounded-full bg-gray-200 transition-colors after:absolute after:top-0.5 after:left-0.5 after:size-5 after:rounded-full after:bg-white after:transition-transform after:content-[''] peer-checked:bg-brand-500 peer-checked:after:translate-x-5 dark:bg-gray-700"></span>
                <span class="text-theme-sm text-gray-700 dark:text-gray-300">啟用通知</span>
            </label>
            <label class="inline-flex cursor-pointer items-center gap-3">
                <input type="checkbox" class="peer sr-only" />
                <span class="relative h-6 w-11 rounded-full bg-gray-200 transition-colors after:absolute after:top-0.5 after:left-0.5 after:size-5 after:rounded-full after:bg-white after:transition-transform after:content-[''] peer-checked:bg-brand-500 peer-checked:after:translate-x-5 dark:bg-gray-700"></span>
                <span class="text-theme-sm text-gray-700 dark:text-gray-300">自動續訂</span>
            </label>
            <label class="inline-flex cursor-not-allowed items-center gap-3 opacity-50">
                <input type="checkbox" class="peer sr-only" disabled />
                <span class="relative h-6 w-11 rounded-full bg-gray-200 transition-colors after:absolute after:top-0.5 after:left-0.5 after:size-5 after:rounded-full after:bg-white after:transition-transform after:content-[''] peer-checked:bg-brand-500 peer-checked:after:translate-x-5 dark:bg-gray-700"></span>
                <span class="text-theme-sm text-gray-700 dark:text-gray-300">禁用狀態</span>
            </label>
        </div>
    </section>
</div>
