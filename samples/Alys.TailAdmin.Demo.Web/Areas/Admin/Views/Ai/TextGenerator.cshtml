@{
    const string labelClass = "mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400";
    const string inputClass = "h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-theme-sm text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800";
    const string cardClass = "rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]";
}
<div class="grid grid-cols-1 gap-4 md:gap-6 xl:grid-cols-12">
    <section class="@cardClass xl:col-span-5">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">生成設定</h3>
        <div class="mt-4 space-y-4">
            <div>
                <label class="@labelClass" for="text-prompt">提示詞</label>
                <textarea id="text-prompt" rows="6"
                          class="w-full rounded-lg border border-gray-300 bg-transparent px-4 py-3 text-theme-sm text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800"
                          placeholder="例如：為一款無線藍牙耳機寫一段 80 字內的促銷文案，突出降噪與續航。"></textarea>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="@labelClass" for="text-tone">語氣</label>
                    <select id="text-tone" class="@inputClass">
                        <option>專業</option>
                        <option>親切</option>
                        <option>活潑</option>
                    </select>
                </div>
                <div>
                    <label class="@labelClass" for="text-length">長度</label>
                    <select id="text-length" class="@inputClass">
                        <option>短（80 字內）</option>
                        <option>中（200 字內）</option>
                        <option>長（500 字內）</option>
                    </select>
                </div>
            </div>
            <div>
                <label class="@labelClass" for="text-model">模型</label>
                <select id="text-model" class="@inputClass">
                    <option>GPT-4o</option>
                    <option>Claude 3.5 Sonnet</option>
                    <option>Gemini 1.5 Pro</option>
                </select>
            </div>
            <button type="button"
                    class="flex w-full items-center justify-center gap-2 rounded-lg bg-brand-500 px-4 py-3 text-theme-sm font-medium text-white shadow-theme-xs hover:bg-brand-600"
                    onclick="Ta.toast.success('已生成（演示）')">
                <partial name="_Icon" model="@("components")" />
                生成文本
            </button>
        </div>
    </section>

    <section class="@cardClass xl:col-span-7">
        <div class="flex items-center justify-between">
            <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">生成結果</h3>
            <div class="flex gap-2">
                <button type="button" class="rounded-lg border border-gray-300 px-3 py-1.5 text-theme-xs font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-white/5"
                        onclick="Ta.toast.success('已複製（演示）')">複製</button>
                <button type="button" class="rounded-lg border border-gray-300 px-3 py-1.5 text-theme-xs font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-white/5"
                        onclick="Ta.toast.info('已重新生成（演示）')">重新生成</button>
            </div>
        </div>
        <div class="mt-4 rounded-xl border border-gray-100 bg-gray-50/60 p-5 text-theme-sm leading-7 text-gray-700 dark:border-gray-800 dark:bg-white/[0.02] dark:text-gray-300">
            <p class="font-medium text-gray-800 dark:text-gray-200">靜下來，聽見純粹。</p>
            <p class="mt-2">全新無線藍牙耳機，搭載雙饋降噪與 36 小時續航，通勤、辦公、旅行一副搞定。輕盈入耳，久戴不累，現在下單享首發優惠。</p>
            <p class="mt-3 text-theme-xs text-gray-500 dark:text-gray-400">共 62 字 · 使用 GPT-4o · 用時 1.8s</p>
        </div>
        <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-3">
            <div class="rounded-xl border border-gray-100 p-4 dark:border-gray-800">
                <p class="text-theme-xs text-gray-500 dark:text-gray-400">Prompt Tokens</p>
                <p class="mt-1 text-lg font-semibold text-gray-800 dark:text-white/90">128</p>
            </div>
            <div class="rounded-xl border border-gray-100 p-4 dark:border-gray-800">
                <p class="text-theme-xs text-gray-500 dark:text-gray-400">Completion Tokens</p>
                <p class="mt-1 text-lg font-semibold text-gray-800 dark:text-white/90">96</p>
            </div>
            <div class="rounded-xl border border-gray-100 p-4 dark:border-gray-800">
                <p class="text-theme-xs text-gray-500 dark:text-gray-400">預估費用</p>
                <p class="mt-1 text-lg font-semibold text-gray-800 dark:text-white/90">$0.002</p>
            </div>
        </div>
    </section>
</div>
