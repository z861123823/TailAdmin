@{
    var campaigns = new[]
    {
        new { Name = "雙十一預熱", Channel = "社交媒體", Spend = "$4,200", Roi = "4.8x", Status = "進行中", Variant = "success" },
        new { Name = "新品首發", Channel = "搜尋廣告", Spend = "$2,860", Roi = "3.2x", Status = "進行中", Variant = "success" },
        new { Name = "會員召回", Channel = "EDM", Spend = "$680", Roi = "6.1x", Status = "已完成", Variant = "light" },
        new { Name = "夏季清倉", Channel = "信息流", Spend = "$1,940", Roi = "1.6x", Status = "已暫停", Variant = "warning" }
    };
}
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4 md:gap-6">
    <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
        <p class="text-theme-sm text-gray-500 dark:text-gray-400">廣告花費</p>
        <p class="mt-2 text-2xl font-semibold text-gray-800 dark:text-white/90">$9,680</p>
        <p class="mt-1 text-theme-xs text-gray-500 dark:text-gray-400">本月累計</p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
        <p class="text-theme-sm text-gray-500 dark:text-gray-400">平均 ROI</p>
        <p class="mt-2 text-2xl font-semibold text-green-600 dark:text-green-400">4.2x</p>
        <p class="mt-1 text-theme-xs text-green-600 dark:text-green-400">↑ 0.6x 較上月</p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
        <p class="text-theme-sm text-gray-500 dark:text-gray-400">點擊數</p>
        <p class="mt-2 text-2xl font-semibold text-gray-800 dark:text-white/90">48,210</p>
        <p class="mt-1 text-theme-xs text-gray-500 dark:text-gray-400">CTR 2.8%</p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
        <p class="text-theme-sm text-gray-500 dark:text-gray-400">帶來的訂單</p>
        <p class="mt-2 text-2xl font-semibold text-gray-800 dark:text-white/90">1,286</p>
        <p class="mt-1 text-theme-xs text-green-600 dark:text-green-400">↑ 9.2% 較上月</p>
    </div>
</div>

<section class="mt-4 rounded-2xl border border-gray-200 bg-white p-5 md:mt-6 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
    <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
            <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">渠道投放</h3>
            <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">線上與門店的月度投放對比</p>
        </div>
    </div>
    <div class="mt-4" id="demoBarChart"></div>
</section>

<section class="mt-4 overflow-hidden rounded-2xl border border-gray-200 bg-white md:mt-6 dark:border-gray-800 dark:bg-white/[0.03]">
    <div class="border-b border-gray-100 px-5 py-4 md:px-6 dark:border-gray-800">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">活動表現</h3>
    </div>
    <div class="max-w-full overflow-x-auto custom-scrollbar">
        <table class="min-w-full">
            <thead class="border-b border-gray-100 dark:border-gray-800">
                <tr>
                    <th class="px-5 py-3 text-start text-theme-xs font-medium whitespace-nowrap text-gray-500 dark:text-gray-400">活動</th>
                    <th class="px-5 py-3 text-start text-theme-xs font-medium whitespace-nowrap text-gray-500 dark:text-gray-400">渠道</th>
                    <th class="px-5 py-3 text-end text-theme-xs font-medium whitespace-nowrap text-gray-500 dark:text-gray-400">花費</th>
                    <th class="px-5 py-3 text-end text-theme-xs font-medium whitespace-nowrap text-gray-500 dark:text-gray-400">ROI</th>
                    <th class="px-5 py-3 text-start text-theme-xs font-medium whitespace-nowrap text-gray-500 dark:text-gray-400">狀態</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                @foreach (var campaign in campaigns)
                {
                    var badge = new TaBadgeModel { Text = campaign.Status, Variant = campaign.Variant, Dot = true };
                    <tr class="transition-colors hover:bg-gray-50 dark:hover:bg-white/[0.02]">
                        <td class="px-5 py-4 text-theme-sm font-medium whitespace-nowrap text-gray-800 dark:text-white/90">@campaign.Name</td>
                        <td class="px-5 py-4 text-theme-sm whitespace-nowrap text-gray-500 dark:text-gray-400">@campaign.Channel</td>
                        <td class="px-5 py-4 text-right text-theme-sm whitespace-nowrap text-gray-800 dark:text-gray-300">@campaign.Spend</td>
                        <td class="px-5 py-4 text-right text-theme-sm whitespace-nowrap text-green-600 dark:text-green-400">@campaign.Roi</td>
                        <td class="px-5 py-4"><partial name="_TaBadge" model="badge" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
