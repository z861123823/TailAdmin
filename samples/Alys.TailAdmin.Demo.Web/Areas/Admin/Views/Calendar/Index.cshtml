@{
    var year = (int)(ViewData["Year"] ?? DateTime.Today.Year);
    var month = (int)(ViewData["Month"] ?? DateTime.Today.Month);
    var first = new DateTime(year, month, 1);
    var offset = ((int)first.DayOfWeek + 6) % 7;
    var start = first.AddDays(-offset);
    var today = DateTime.Today;
    var prevMonth = first.AddMonths(-1);
    var nextMonth = first.AddMonths(1);
    var weekdays = new[] { "一", "二", "三", "四", "五", "六", "日" };
    var events = new Dictionary<int, List<(string Title, string Tone)>>
    {
        [3] = new() { ("產品評審", "brand") },
        [7] = new() { ("月度例會", "green") },
        [11] = new() { ("供應商洽談", "amber") },
        [15] = new() { ("版本發佈", "brand"), ("客戶回訪", "green") },
        [19] = new() { ("團隊建設", "brand") },
        [23] = new() { ("季度總結", "red") },
        [27] = new() { ("庫存盤點", "amber") }
    };
    string ToneClass(string tone) => tone switch
    {
        "green" => "bg-green-50 text-green-600 dark:bg-green-500/15 dark:text-green-400",
        "amber" => "bg-amber-50 text-amber-600 dark:bg-amber-500/15 dark:text-amber-400",
        "red" => "bg-red-50 text-red-600 dark:bg-red-500/15 dark:text-red-400",
        _ => "bg-brand-50 text-brand-600 dark:bg-brand-500/15 dark:text-brand-400"
    };
    string DotClass(string tone) => tone switch
    {
        "green" => "bg-green-500",
        "amber" => "bg-amber-500",
        "red" => "bg-red-500",
        _ => "bg-brand-500"
    };

    var toneSelect = new TaSelectModel
    {
        Name = "event-tone",
        Id = "event-tone",
        Value = "brand",
        Options = new()
        {
            new() { Value = "brand", Text = "產品與版本" },
            new() { Value = "green", Text = "會議與回訪" },
            new() { Value = "amber", Text = "營運與庫存" },
            new() { Value = "red", Text = "重要節點" }
        }
    };

    var upcoming = new (string Title, string Tone, int Day, string Time)[]
    {
        ("產品評審", "brand", 3, "10:00"),
        ("月度例會", "green", 7, "14:00"),
        ("供應商洽談", "amber", 11, "09:30"),
        ("季度總結", "red", 23, "16:00")
    };
    var inputClass = "h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-theme-sm text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800";
    var labelClass = "mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400";
}
<div x-data="{ open: false }">
    <div class="grid grid-cols-1 gap-4 md:gap-6 xl:grid-cols-12">
        <section class="overflow-hidden rounded-2xl border border-gray-200 bg-white xl:col-span-9 dark:border-gray-800 dark:bg-white/[0.03]">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-200 px-5 py-4 md:px-6 dark:border-gray-800">
                <div class="flex items-center gap-3">
                    <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">@($"{year} 年 {month} 月")</h3>
                    <a asp-area="Admin" asp-controller="Calendar" asp-action="Index"
                       class="rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-theme-xs font-medium text-gray-700 shadow-theme-xs transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-white/5">今天</a>
                </div>
                <div class="flex items-center gap-2">
                    <div class="flex items-center gap-1">
                        <a asp-area="Admin" asp-controller="Calendar" asp-action="Index" asp-route-year="@prevMonth.Year" asp-route-month="@prevMonth.Month"
                           class="inline-flex size-9 items-center justify-center rounded-lg border border-gray-300 bg-white text-gray-700 shadow-theme-xs transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-white/5" aria-label="上個月">
                            <partial name="_Icon" model="@("chevron-left")" />
                        </a>
                        <a asp-area="Admin" asp-controller="Calendar" asp-action="Index" asp-route-year="@nextMonth.Year" asp-route-month="@nextMonth.Month"
                           class="inline-flex size-9 items-center justify-center rounded-lg border border-gray-300 bg-white text-gray-700 shadow-theme-xs transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-white/5" aria-label="下個月">
                            <partial name="_Icon" model="@("chevron-right")" />
                        </a>
                    </div>
                    <button type="button"
                            class="inline-flex items-center gap-2 rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white shadow-theme-xs transition-colors hover:bg-brand-600"
                            x-on:click="open = true">
                        <partial name="_Icon" model="@("plus")" />
                        新增日程
                    </button>
                </div>
            </div>

            <div class="grid grid-cols-7 border-b border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-white/[0.02]">
                @foreach (var weekday in weekdays)
                {
                    <div class="border-r border-gray-200 px-2 py-3 text-center text-theme-xs font-medium text-gray-500 last:border-r-0 dark:border-gray-800 dark:text-gray-400">@weekday</div>
                }
            </div>

            <div class="grid grid-cols-7">
                @for (var index = 0; index < 42; index++)
                {
                    var date = start.AddDays(index);
                    var inMonth = date.Month == month;
                    var isToday = date.Date == today;
                    var dayEvents = inMonth && events.TryGetValue(date.Day, out var list)
                        ? list
                        : new List<(string Title, string Tone)>();
                    <div class="min-h-[120px] border-r border-b border-gray-100 p-2 last:border-r-0 dark:border-gray-800 @(inMonth ? "bg-white dark:bg-transparent" : "bg-gray-50/60 dark:bg-white/[0.01]")">
                        <div class="flex items-center justify-between">
                            <span class="inline-flex size-7 items-center justify-center rounded-full text-theme-xs font-medium @(isToday ? "bg-brand-500 text-white" : inMonth ? "text-gray-700 dark:text-gray-300" : "text-gray-400 dark:text-gray-600")">@date.Day</span>
                        </div>
                        <div class="mt-1 space-y-1">
                            @foreach (var item in dayEvents)
                            {
                                <p class="truncate rounded-md px-2 py-1 text-theme-xs font-medium @ToneClass(item.Tone)">@item.Title</p>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>

        <aside class="space-y-4 md:space-y-6 xl:col-span-3">
            <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
                <div class="flex items-center justify-between">
                    <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">即將到來</h3>
                    <button type="button"
                            class="inline-flex size-8 items-center justify-center rounded-lg bg-brand-50 text-brand-500 transition-colors hover:bg-brand-100 dark:bg-brand-500/15 dark:text-brand-400"
                            x-on:click="open = true" aria-label="新增日程">
                        <partial name="_Icon" model="@("plus")" />
                    </button>
                </div>
                <ul class="mt-4 space-y-4">
                    @foreach (var item in upcoming)
                    {
                        <li class="flex items-start gap-3">
                            <span class="inline-flex size-10 shrink-0 flex-col items-center justify-center rounded-lg bg-gray-50 text-gray-700 dark:bg-white/5 dark:text-gray-300">
                                <span class="text-[10px] leading-3">@($"{month}月")</span>
                                <span class="text-theme-sm leading-4 font-semibold">@item.Day</span>
                            </span>
                            <div class="min-w-0">
                                <p class="truncate text-theme-sm font-medium text-gray-800 dark:text-white/90">@item.Title</p>
                                <p class="mt-0.5 flex items-center gap-1.5 text-theme-xs text-gray-500 dark:text-gray-400">
                                    <span class="size-1.5 rounded-full @DotClass(item.Tone)"></span>
                                    @item.Time
                                </p>
                            </div>
                        </li>
                    }
                </ul>
            </section>

            <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
                <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">圖例</h3>
                <div class="mt-3 space-y-2.5 text-theme-sm text-gray-600 dark:text-gray-400">
                    <p class="flex items-center gap-2"><span class="size-2 rounded-full bg-brand-500"></span>產品與版本</p>
                    <p class="flex items-center gap-2"><span class="size-2 rounded-full bg-green-500"></span>會議與回訪</p>
                    <p class="flex items-center gap-2"><span class="size-2 rounded-full bg-amber-500"></span>營運與庫存</p>
                    <p class="flex items-center gap-2"><span class="size-2 rounded-full bg-red-500"></span>重要節點</p>
                </div>
            </section>
        </aside>
    </div>

    <div x-show="open" x-cloak class="fixed inset-0 z-[999999] flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-label="新增日程">
        <div class="absolute inset-0 bg-gray-900/50" x-on:click="open = false" x-transition.opacity></div>
        <div class="relative w-full max-w-md rounded-2xl border border-gray-200 bg-white p-5 shadow-theme-xl md:p-6 dark:border-gray-800 dark:bg-gray-900" x-transition>
            <div class="flex items-center justify-between">
                <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">新增日程</h3>
                <button type="button" class="inline-flex size-8 items-center justify-center rounded-lg text-gray-400 transition-colors hover:bg-gray-100 hover:text-gray-700 dark:hover:bg-white/5 dark:hover:text-gray-300" x-on:click="open = false" aria-label="關閉">
                    <partial name="_Icon" model="@("close")" />
                </button>
            </div>
            <div class="mt-4 space-y-4">
                <div>
                    <label class="@labelClass" for="event-title">日程標題</label>
                    <input id="event-title" type="text" class="@inputClass" placeholder="例如：新品評審會" />
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="@labelClass" for="event-date">日期</label>
                        <input id="event-date" type="text" class="@inputClass" autocomplete="off" placeholder="選擇日期" x-datepicker />
                    </div>
                    <div>
                        <label class="@labelClass" for="event-time">時間</label>
                        <input id="event-time" type="text" class="@inputClass" autocomplete="off" placeholder="選擇時間"
                               x-datepicker="{ enableTime: true, noCalendar: true, time_24hr: true, dateFormat: 'H:i' }" />
                    </div>
                </div>
                <div>
                    <label class="@labelClass" for="event-tone">類型</label>
                    <partial name="_TaSelect" model="toneSelect" />
                </div>
                <div>
                    <label class="@labelClass" for="event-note">備註</label>
                    <textarea id="event-note" rows="3" placeholder="參與人、地點或準備事項"
                              class="w-full rounded-lg border border-gray-300 bg-transparent px-4 py-3 text-theme-sm text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800"></textarea>
                </div>
            </div>
            <div class="mt-5 flex justify-end gap-3">
                <button type="button" class="rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-theme-sm font-medium text-gray-700 shadow-theme-xs transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400" x-on:click="open = false">取消</button>
                <button type="button" class="rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white shadow-theme-xs transition-colors hover:bg-brand-600"
                        x-on:click="open = false; Ta.toast.success('日程已建立（演示）')">保存日程</button>
            </div>
        </div>
    </div>
</div>
