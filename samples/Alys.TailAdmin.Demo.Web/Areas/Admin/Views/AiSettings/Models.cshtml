@{
    var models = new[]
    {
        new { Name = "GPT-4o", Provider = "OpenAI", Context = "128K", Price = "$5.00 / 1M", Latency = "0.82s", Throughput = "72 tok/s", IsDefault = true, Enabled = true },
        new { Name = "Claude 3.5 Sonnet", Provider = "Anthropic", Context = "200K", Price = "$3.00 / 1M", Latency = "1.05s", Throughput = "64 tok/s", IsDefault = false, Enabled = true },
        new { Name = "Gemini 1.5 Pro", Provider = "Google", Context = "1M", Price = "$3.50 / 1M", Latency = "1.32s", Throughput = "58 tok/s", IsDefault = false, Enabled = true },
        new { Name = "GPT-4o mini", Provider = "OpenAI", Context = "128K", Price = "$0.15 / 1M", Latency = "0.46s", Throughput = "110 tok/s", IsDefault = false, Enabled = true },
        new { Name = "Llama 3.1 70B", Provider = "Meta", Context = "128K", Price = "$0.90 / 1M", Latency = "1.68s", Throughput = "41 tok/s", IsDefault = false, Enabled = false },
        new { Name = "Mistral Large", Provider = "Mistral", Context = "32K", Price = "$2.00 / 1M", Latency = "1.14s", Throughput = "55 tok/s", IsDefault = false, Enabled = false }
    };
    var enabledCount = models.Count(m => m.Enabled);
}
<div class="mb-4 grid grid-cols-1 gap-3 sm:grid-cols-3 md:mb-6">
    <div class="flex items-center justify-between rounded-xl border border-gray-200 bg-white px-4 py-3 dark:border-gray-800 dark:bg-white/[0.03]">
        <span class="text-theme-sm text-gray-500 dark:text-gray-400">可用模型</span>
        <span class="text-theme-sm font-semibold text-gray-800 dark:text-white/90">@enabledCount / @models.Length</span>
    </div>
    <div class="flex items-center justify-between rounded-xl border border-gray-200 bg-white px-4 py-3 dark:border-gray-800 dark:bg-white/[0.03]">
        <span class="text-theme-sm text-gray-500 dark:text-gray-400">預設模型</span>
        <span class="text-theme-sm font-semibold text-gray-800 dark:text-white/90">GPT-4o</span>
    </div>
    <div class="flex items-center justify-between rounded-xl border border-gray-200 bg-white px-4 py-3 dark:border-gray-800 dark:bg-white/[0.03]">
        <span class="text-theme-sm text-gray-500 dark:text-gray-400">平均延遲</span>
        <span class="text-theme-sm font-semibold text-gray-800 dark:text-white/90">1.08s</span>
    </div>
</div>

<div class="grid grid-cols-1 gap-4 md:gap-6 xl:grid-cols-2">
    @foreach (var item in models)
    {
        var defaultBadge = new TaBadgeModel { Text = "預設", Variant = "primary", Dot = true };
        var stateBadge = item.Enabled
            ? new TaBadgeModel { Text = "已啟用", Variant = "success", Dot = true }
            : new TaBadgeModel { Text = "已停用", Variant = "light" };
        <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]"
                 x-data="{ testing: false, latency: null, test() { if (this.testing) return; this.testing = true; this.latency = null; setTimeout(() => { this.testing = false; this.latency = '@item.Latency'; }, 900); } }">
            <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                    <div class="flex items-center gap-2">
                        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">@item.Name</h3>
                        @if (item.IsDefault)
                        {
                            <partial name="_TaBadge" model="defaultBadge" />
                        }
                    </div>
                    <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">@item.Provider</p>
                </div>
                <partial name="_TaBadge" model="stateBadge" />
            </div>
            <dl class="mt-4 grid grid-cols-2 gap-3 border-t border-gray-100 pt-4 text-theme-sm dark:border-gray-800">
                <div>
                    <dt class="text-gray-500 dark:text-gray-400">上下文</dt>
                    <dd class="mt-0.5 font-medium text-gray-800 dark:text-gray-300">@item.Context</dd>
                </div>
                <div>
                    <dt class="text-gray-500 dark:text-gray-400">價格</dt>
                    <dd class="mt-0.5 font-medium text-gray-800 dark:text-gray-300">@item.Price</dd>
                </div>
                <div>
                    <dt class="text-gray-500 dark:text-gray-400">平均延遲</dt>
                    <dd class="mt-0.5 font-medium text-gray-800 dark:text-gray-300">@item.Latency</dd>
                </div>
                <div>
                    <dt class="text-gray-500 dark:text-gray-400">輸出速度</dt>
                    <dd class="mt-0.5 font-medium text-gray-800 dark:text-gray-300">@item.Throughput</dd>
                </div>
            </dl>
            <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-gray-100 pt-4 dark:border-gray-800">
                <label class="inline-flex cursor-pointer items-center gap-2 text-theme-sm text-gray-700 dark:text-gray-300">
                    <input type="checkbox" class="peer sr-only" checked="@item.Enabled" />
                    <span class="relative h-6 w-11 rounded-full bg-gray-200 transition-colors after:absolute after:top-0.5 after:left-0.5 after:size-5 after:rounded-full after:bg-white after:transition-transform after:content-[''] peer-checked:bg-brand-500 peer-checked:after:translate-x-5 dark:bg-gray-700"></span>
                    啟用
                </label>
                <div class="flex items-center gap-2">
                    <span class="text-theme-xs font-medium text-green-600 dark:text-green-400" x-show="latency" x-cloak>
                        連線正常 · <span x-text="latency"></span>
                    </span>
                    <button type="button"
                            class="inline-flex items-center gap-2 rounded-lg border border-gray-300 px-3 py-2 text-theme-xs font-medium text-gray-700 hover:bg-gray-50 disabled:opacity-60 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-white/5"
                            x-on:click="test()" x-bind:disabled="testing">
                        <span x-show="!testing">測試連線</span>
                        <span class="inline-flex items-center gap-2" x-show="testing" x-cloak>
                            <span class="size-3 animate-spin rounded-full border-2 border-gray-300 border-t-brand-500 dark:border-gray-600 dark:border-t-brand-400"></span>
                            測試中
                        </span>
                    </button>
                    @if (!item.IsDefault)
                    {
                        <button type="button" class="rounded-lg border border-gray-300 px-3 py-2 text-theme-xs font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-white/5"
                                onclick="Ta.toast.success('已設為預設（演示）')">設為預設</button>
                    }
                </div>
            </div>
        </section>
    }
</div>
