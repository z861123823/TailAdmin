@model GoodsTypeEditModel
<form method="post" asp-area="Admin" asp-controller="GoodsType" asp-action="Save"
      x-on:submit.prevent="Ta.modal.submit('typeEdit')">
    <input type="hidden" asp-for="Id" />

    <ta-input asp-for="Name" label="分類名稱" required placeholder="例如：數碼配件" />
    <ta-input asp-for="Sort" label="排序" type="number" min="0" required hint="數字越小越靠前" />
    <ta-toggle asp-for="Enabled" label="啟用" hint="停用後不再出現在商品分類下拉中" />
</form>
