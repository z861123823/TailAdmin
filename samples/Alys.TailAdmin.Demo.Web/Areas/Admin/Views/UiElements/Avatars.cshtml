@{
    var sizes = new (string Label, string Size)[]
    {
        ("XS", "xs"), ("SM", "sm"), ("MD", "md"), ("LG", "lg"), ("XL", "xl"), ("2XL", "2xl")
    };
    var statuses = new (string Label, string Status)[]
    {
        ("在線", "online"), ("離開", "offline"), ("忙碌", "busy")
    };
    var group = new TaAvatarGroupModel
    {
        Size = "md",
        Max = 4,
        Total = 12,
        Items = new List<TaAvatarModel>
        {
            new() { Initials = "林", Alt = "林小姐" },
            new() { Initials = "王", Alt = "王先生" },
            new() { Initials = "陳", Alt = "陳經理" },
            new() { Initials = "李", Alt = "李專員" }
        }
    };
    var roundedAvatars = new List<TaAvatarModel>
    {
        new() { Initials = "林", Size = "md", Shape = "rounded" },
        new() { Initials = "王", Size = "lg", Shape = "rounded" },
        new() { Initials = "陳", Size = "xl", Shape = "rounded", Status = "online" }
    };
}
<div class="grid grid-cols-1 gap-4 md:gap-6 xl:grid-cols-2">
    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">頭像尺寸</h3>
        <div class="mt-5 flex flex-wrap items-end gap-5">
            @foreach (var item in sizes)
            {
                var avatar = new TaAvatarModel { Initials = "林", Alt = item.Label, Size = item.Size };
                <div class="flex flex-col items-center gap-2">
                    <partial name="_TaAvatar" model="avatar" />
                    <span class="text-theme-xs text-gray-500 dark:text-gray-400">@item.Label</span>
                </div>
            }
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">在線狀態</h3>
        <div class="mt-5 flex flex-wrap items-center gap-5">
            @foreach (var item in statuses)
            {
                var avatar = new TaAvatarModel { Initials = "王", Alt = item.Label, Size = "lg", Status = item.Status };
                <div class="flex items-center gap-3">
                    <partial name="_TaAvatar" model="avatar" />
                    <span class="text-theme-sm text-gray-600 dark:text-gray-400">@item.Label</span>
                </div>
            }
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">重疊頭像組</h3>
        <div class="mt-5">
            <partial name="_TaAvatarGroup" model="group" />
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">圓角方形</h3>
        <div class="mt-5 flex flex-wrap items-center gap-4">
            @foreach (var avatar in roundedAvatars)
            {
                <partial name="_TaAvatar" model="avatar" />
            }
        </div>
    </section>
</div>

<div class="mt-4 grid grid-cols-1 gap-4 md:mt-6 md:gap-6 xl:grid-cols-2">
    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">尺寸</h3>
        <div class="mt-5 flex flex-wrap items-end gap-4">
            <span class="flex size-6 items-center justify-center rounded-full bg-brand-50 text-[10px] font-semibold text-brand-600 dark:bg-brand-500/15 dark:text-brand-400">林</span>
            <span class="flex size-8 items-center justify-center rounded-full bg-green-50 text-theme-xs font-semibold text-green-600 dark:bg-green-500/15 dark:text-green-400">陳</span>
            <span class="flex size-10 items-center justify-center rounded-full bg-amber-50 text-theme-sm font-semibold text-amber-600 dark:bg-amber-500/15 dark:text-amber-400">王</span>
            <span class="flex size-12 items-center justify-center rounded-full bg-red-50 text-theme-sm font-semibold text-red-600 dark:bg-red-500/15 dark:text-red-400">李</span>
            <span class="flex size-14 items-center justify-center rounded-full bg-gray-100 text-theme-sm font-semibold text-gray-600 dark:bg-white/10 dark:text-gray-300">張</span>
        </div>
        <h4 class="mt-6 text-sm font-medium text-gray-700 dark:text-gray-300">形狀</h4>
        <div class="mt-3 flex items-center gap-4">
            <span class="flex size-10 items-center justify-center rounded-full bg-brand-500 text-theme-sm font-semibold text-white">圓</span>
            <span class="flex size-10 items-center justify-center rounded-lg bg-brand-500 text-theme-sm font-semibold text-white">方</span>
            <span class="flex size-10 items-center justify-center rounded-xl bg-brand-500 text-theme-sm font-semibold text-white">圓角</span>
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">狀態與分組</h3>
        <div class="mt-5 flex flex-wrap items-center gap-5">
            <span class="relative inline-block">
                <span class="flex size-10 items-center justify-center rounded-full bg-brand-50 text-theme-sm font-semibold text-brand-600 dark:bg-brand-500/15 dark:text-brand-400">林</span>
                <span class="absolute right-0 bottom-0 size-3 rounded-full border-2 border-white bg-green-500 dark:border-gray-900"></span>
            </span>
            <span class="relative inline-block">
                <span class="flex size-10 items-center justify-center rounded-full bg-gray-100 text-theme-sm font-semibold text-gray-600 dark:bg-white/10 dark:text-gray-300">陳</span>
                <span class="absolute right-0 bottom-0 size-3 rounded-full border-2 border-white bg-amber-500 dark:border-gray-900"></span>
            </span>
            <span class="relative inline-block">
                <span class="flex size-10 items-center justify-center rounded-full bg-gray-100 text-theme-sm font-semibold text-gray-600 dark:bg-white/10 dark:text-gray-300">王</span>
                <span class="absolute right-0 bottom-0 size-3 rounded-full border-2 border-white bg-gray-400 dark:border-gray-900"></span>
            </span>
        </div>
        <div class="mt-6 flex -space-x-3">
            <span class="flex size-10 items-center justify-center rounded-full border-2 border-white bg-brand-50 text-theme-xs font-semibold text-brand-600 dark:border-gray-900 dark:bg-brand-500/15 dark:text-brand-400">林</span>
            <span class="flex size-10 items-center justify-center rounded-full border-2 border-white bg-green-50 text-theme-xs font-semibold text-green-600 dark:border-gray-900 dark:bg-green-500/15 dark:text-green-400">陳</span>
            <span class="flex size-10 items-center justify-center rounded-full border-2 border-white bg-amber-50 text-theme-xs font-semibold text-amber-600 dark:border-gray-900 dark:bg-amber-500/15 dark:text-amber-400">王</span>
            <span class="flex size-10 items-center justify-center rounded-full border-2 border-white bg-gray-100 text-theme-xs font-semibold text-gray-600 dark:border-gray-900 dark:bg-white/10 dark:text-gray-300">+8</span>
        </div>
        <p class="mt-3 text-theme-xs text-gray-500 dark:text-gray-400">狀態：在線 / 忙碌 / 離線；分組超出 3 人顯示 +N</p>
    </section>
</div>
