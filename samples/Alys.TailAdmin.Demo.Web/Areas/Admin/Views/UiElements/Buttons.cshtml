@{
    var variants = new List<TaButtonModel>
    {
        new() { Text = "主要按鈕" },
        new() { Text = "成功按鈕", Variant = "success" },
        new() { Text = "警告按鈕", Variant = "warning" },
        new() { Text = "危險按鈕", Variant = "danger" },
        new() { Text = "輪廓按鈕", Variant = "outline" },
        new() { Text = "幽靈按鈕", Variant = "ghost" },
        new() { Text = "淺色按鈕", Variant = "light" }
    };
    var sizes = new List<TaButtonModel>
    {
        new() { Text = "小按鈕", Size = "sm" },
        new() { Text = "中按鈕", Size = "md" },
        new() { Text = "大按鈕", Size = "lg" }
    };
    var withIcons = new List<TaButtonModel>
    {
        new() { Text = "新增", Icon = "plus" },
        new() { Text = "上傳", Icon = "upload", Variant = "outline" },
        new() { Text = "下一步", Icon = "chevron-right", IconPosition = "right", Variant = "light" }
    };
    var iconOnly = new TaButtonModel { Text = string.Empty, Icon = "plus", AriaLabel = "新增" };
    var disabled = new TaButtonModel { Text = "禁用按鈕", Disabled = true };
    var fullWidth = new TaButtonModel { Text = "佔滿寬度", FullWidth = true };
    var linkButton = new TaButtonModel { Text = "連結按鈕", Href = "#", Icon = "eye", Variant = "outline" };
}
<div class="grid grid-cols-1 gap-4 md:gap-6 xl:grid-cols-2">
    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 xl:col-span-2 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">樣式</h3>
        <div class="mt-4 flex flex-wrap items-center gap-3">
            @foreach (var button in variants)
            {
                <partial name="_TaButton" model="button" />
            }
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">尺寸</h3>
        <div class="mt-4 flex flex-wrap items-end gap-3">
            @foreach (var button in sizes)
            {
                <partial name="_TaButton" model="button" />
            }
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">圖標按鈕</h3>
        <div class="mt-4 flex flex-wrap items-center gap-3">
            @foreach (var button in withIcons)
            {
                <partial name="_TaButton" model="button" />
            }
            <partial name="_TaButton" model="iconOnly" />
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">狀態與連結</h3>
        <div class="mt-4 flex flex-wrap items-center gap-3">
            <partial name="_TaButton" model="disabled" />
            <partial name="_TaButton" model="linkButton" />
        </div>
        <div class="mt-4 max-w-sm">
            <partial name="_TaButton" model="fullWidth" />
        </div>
    </section>
</div>

<div class="mt-4 grid grid-cols-1 gap-4 md:mt-6 md:gap-6 xl:grid-cols-2">
    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">尺寸</h3>
        <div class="mt-5 flex flex-wrap items-center gap-3">
            <button type="button" class="rounded-lg bg-brand-500 px-3 py-1.5 text-theme-xs font-medium text-white hover:bg-brand-600">小按鈕</button>
            <button type="button" class="rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white hover:bg-brand-600">預設</button>
            <button type="button" class="rounded-lg bg-brand-500 px-5 py-3 text-theme-sm font-medium text-white hover:bg-brand-600">大按鈕</button>
            <button type="button" class="rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white hover:bg-brand-600">
                <span class="inline-flex items-center gap-2"><partial name="_Icon" model="@("plus")" />帶圖標</span>
            </button>
        </div>
        <h4 class="mt-6 text-sm font-medium text-gray-700 dark:text-gray-300">圖標按鈕</h4>
        <div class="mt-3 flex flex-wrap gap-2">
            <button type="button" class="inline-flex size-10 items-center justify-center rounded-lg bg-brand-500 text-white hover:bg-brand-600" aria-label="新增"><partial name="_Icon" model="@("plus")" /></button>
            <button type="button" class="inline-flex size-10 items-center justify-center rounded-lg border border-gray-300 text-gray-600 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-white/5" aria-label="編輯"><partial name="_Icon" model="@("pencil")" /></button>
            <button type="button" class="inline-flex size-10 items-center justify-center rounded-lg border border-red-200 text-red-600 hover:bg-red-50 dark:border-red-500/30 dark:text-red-400 dark:hover:bg-red-500/10" aria-label="刪除"><partial name="_Icon" model="@("trash")" /></button>
            <button type="button" class="inline-flex size-10 items-center justify-center rounded-lg text-gray-400 hover:bg-gray-100 hover:text-gray-700 dark:hover:bg-white/5 dark:hover:text-gray-300" aria-label="重新整理"><partial name="_Icon" model="@("refresh")" /></button>
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">狀態與危險操作</h3>
        <div class="mt-5 flex flex-wrap items-center gap-3">
            <button type="button" class="inline-flex cursor-wait items-center gap-2 rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white opacity-90" disabled>
                <span class="size-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span>
                保存中…
            </button>
            <button type="button" class="rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white opacity-50" disabled>已停用</button>
            <button type="button" class="rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm font-medium text-gray-400" disabled>不可用</button>
        </div>
        <div class="mt-5 flex flex-wrap gap-3">
            <button type="button" class="rounded-lg bg-red-500 px-4 py-2.5 text-theme-sm font-medium text-white hover:bg-red-600"
                    onclick="Ta.confirm({ title: '刪除商品', text: '刪除後無法恢復，確定繼續？', confirmText: '刪除', danger: true }).then(function(ok){ if (ok) Ta.toast.success('已刪除（演示）'); })">刪除商品</button>
            <button type="button" class="rounded-lg border border-red-300 px-4 py-2.5 text-theme-sm font-medium text-red-600 hover:bg-red-50 dark:border-red-500/30 dark:text-red-400 dark:hover:bg-red-500/10"
                    onclick="Ta.toast.success('已取消訂單（演示）')">取消訂單</button>
            <button type="button" class="rounded-lg bg-green-500 px-4 py-2.5 text-theme-sm font-medium text-white hover:bg-green-600">確認發貨</button>
        </div>
        <p class="mt-4 text-theme-xs text-gray-500 dark:text-gray-400">危險操作建議搭配 `Ta.confirm` 二次確認。</p>
    </section>
</div>
