@{
    var groups = new List<(string Title, string Variant)>
    {
        ("Default Alert", "default"),
        ("Success Alert", "success"),
        ("Warning Alert", "warning"),
        ("Error Alert", "danger"),
        ("Info Alert", "info")
    };
}
<div class="grid grid-cols-1 gap-4 md:gap-6 xl:grid-cols-2">
    @foreach (var group in groups)
    {
        var withIcon = new TaAlertModel
        {
            Variant = group.Variant,
            Title = "Default Message",
            Message = "請謹慎執行此操作。",
            LinkText = "了解詳情",
            LinkUrl = "#"
        };
        var plain = new TaAlertModel
        {
            Variant = group.Variant,
            Title = "Default Message",
            Message = "請謹慎執行此操作。",
            ShowIcon = false,
            Dismissible = true
        };
        <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
            <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">@group.Title</h3>
            <div class="mt-4 flex flex-col gap-3">
                <partial name="_TaAlert" model="withIcon" />
                <partial name="_TaAlert" model="plain" />
            </div>
        </section>
    }
</div>
