@{
    var variants = new List<TaBadgeModel>
    {
        new() { Text = "主要", Variant = "primary" },
        new() { Text = "成功", Variant = "success" },
        new() { Text = "警告", Variant = "warning" },
        new() { Text = "危險", Variant = "danger" },
        new() { Text = "資訊", Variant = "info" },
        new() { Text = "淺色", Variant = "light" },
        new() { Text = "深色", Variant = "dark" }
    };
    var decorated = new List<TaBadgeModel>
    {
        new() { Text = "進行中", Variant = "primary", Dot = true },
        new() { Text = "已完成", Variant = "success", Dot = true },
        new() { Text = "待處理", Variant = "warning", Icon = "alert" },
        new() { Text = "已取消", Variant = "danger", Icon = "close" },
        new() { Text = "已審核", Variant = "info", Icon = "check" }
    };
    var small = new TaBadgeModel { Text = "Small", Size = "sm", Variant = "primary" };
    var medium = new TaBadgeModel { Text = "Medium", Size = "md", Variant = "primary" };
    var shipped = new TaBadgeModel { Text = "已發貨", Variant = "success", Dot = true };
    var lowStock = new TaBadgeModel { Text = "低庫存", Variant = "warning" };
}
<div class="grid grid-cols-1 gap-4 md:gap-6 xl:grid-cols-2">
    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">色彩</h3>
        <div class="mt-4 flex flex-wrap items-center gap-2">
            @foreach (var badge in variants)
            {
                <partial name="_TaBadge" model="badge" />
            }
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">圓點與圖標</h3>
        <div class="mt-4 flex flex-wrap items-center gap-2">
            @foreach (var badge in decorated)
            {
                <partial name="_TaBadge" model="badge" />
            }
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">尺寸</h3>
        <div class="mt-4 flex flex-wrap items-center gap-3">
            <partial name="_TaBadge" model="small" />
            <partial name="_TaBadge" model="medium" />
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">表格內徽章</h3>
        <div class="mt-4 flex flex-wrap items-center gap-6">
            <div class="flex items-center gap-2 text-theme-sm text-gray-600 dark:text-gray-400">
                訂單狀態
                <partial name="_TaBadge" model="shipped" />
            </div>
            <div class="flex items-center gap-2 text-theme-sm text-gray-600 dark:text-gray-400">
                庫存
                <partial name="_TaBadge" model="lowStock" />
            </div>
        </div>
    </section>
</div>

<div class="mt-4 grid grid-cols-1 gap-4 md:mt-6 md:gap-6 xl:grid-cols-2">
    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">尺寸</h3>
        <div class="mt-5 flex flex-wrap items-center gap-3">
            <span class="rounded-full bg-brand-50 px-2 py-0.5 text-[10px] font-medium text-brand-600 dark:bg-brand-500/15 dark:text-brand-400">小尺寸</span>
            <span class="rounded-full bg-brand-50 px-2.5 py-1 text-theme-xs font-medium text-brand-600 dark:bg-brand-500/15 dark:text-brand-400">預設</span>
            <span class="rounded-full bg-brand-50 px-3 py-1.5 text-theme-sm font-medium text-brand-600 dark:bg-brand-500/15 dark:text-brand-400">大尺寸</span>
        </div>
        <h4 class="mt-6 text-sm font-medium text-gray-700 dark:text-gray-300">圓點與數字</h4>
        <div class="mt-3 flex flex-wrap items-center gap-4">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-green-50 px-2.5 py-1 text-theme-xs font-medium text-green-600 dark:bg-green-500/15 dark:text-green-400">
                <span class="size-1.5 rounded-full bg-green-500"></span>在線
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-2.5 py-1 text-theme-xs font-medium text-amber-600 dark:bg-amber-500/15 dark:text-amber-400">
                <span class="size-1.5 rounded-full bg-amber-500"></span>待審核
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-red-50 px-2.5 py-1 text-theme-xs font-medium text-red-600 dark:bg-red-500/15 dark:text-red-400">
                <span class="size-1.5 rounded-full bg-red-500"></span>已逾期
            </span>
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">可移除與計數</h3>
        <div class="mt-4 flex flex-wrap gap-2" x-data="{ tags: ['降噪', '長續航', '新品', '限量'] }">
            <template x-for="(tag, ti) in tags" :key="ti">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-gray-100 px-2.5 py-1 text-theme-xs font-medium text-gray-700 dark:bg-white/10 dark:text-gray-300">
                    <span x-text="tag"></span>
                    <button type="button" class="rounded-full text-gray-400 hover:text-gray-700 dark:hover:text-gray-200" x-on:click="tags.splice(ti, 1)" aria-label="移除標籤">×</button>
                </span>
            </template>
            <span class="text-theme-xs text-gray-400" x-show="tags.length === 0">已全部移除</span>
        </div>
        <div class="mt-5 flex items-center gap-4">
            <span class="rounded-lg bg-blue-600 px-2.5 py-1 text-theme-xs font-semibold text-white">12</span>
            <span class="rounded-lg bg-red-500 px-2.5 py-1 text-theme-xs font-semibold text-white">99+</span>
            <span class="relative inline-flex size-10 items-center justify-center rounded-xl bg-gray-100 text-gray-600 dark:bg-white/10 dark:text-gray-300">
                <partial name="_Icon" model="@("bell")" />
                <span class="absolute -top-1 -right-1 flex size-4 items-center justify-center rounded-full bg-red-500 text-[9px] font-semibold text-white">3</span>
            </span>
        </div>
    </section>
</div>
