<div class="grid grid-cols-1 gap-4 md:gap-6 xl:grid-cols-2">
    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">線性進度</h3>
        <div class="mt-5 space-y-5">
            <div>
                <div class="mb-1.5 flex justify-between text-theme-sm"><span class="text-gray-600 dark:text-gray-400">預設</span><span class="text-gray-800 dark:text-gray-300">45%</span></div>
                <div class="h-2.5 rounded-full bg-gray-100 dark:bg-white/10"><div class="h-2.5 rounded-full bg-brand-500" style="width:45%"></div></div>
            </div>
            <div>
                <div class="mb-1.5 flex justify-between text-theme-sm"><span class="text-gray-600 dark:text-gray-400">成功</span><span class="text-gray-800 dark:text-gray-300">78%</span></div>
                <div class="h-2.5 rounded-full bg-gray-100 dark:bg-white/10"><div class="h-2.5 rounded-full bg-green-500" style="width:78%"></div></div>
            </div>
            <div>
                <div class="mb-1.5 flex justify-between text-theme-sm"><span class="text-gray-600 dark:text-gray-400">警告</span><span class="text-gray-800 dark:text-gray-300">62%</span></div>
                <div class="h-2.5 rounded-full bg-gray-100 dark:bg-white/10"><div class="h-2.5 rounded-full bg-amber-500" style="width:62%"></div></div>
            </div>
            <div>
                <div class="mb-1.5 flex justify-between text-theme-sm"><span class="text-gray-600 dark:text-gray-400">危險</span><span class="text-gray-800 dark:text-gray-300">91%</span></div>
                <div class="h-2.5 rounded-full bg-gray-100 dark:bg-white/10"><div class="h-2.5 rounded-full bg-red-500" style="width:91%"></div></div>
            </div>
        </div>
        <h4 class="mt-6 text-sm font-medium text-gray-700 dark:text-gray-300">尺寸</h4>
        <div class="mt-3 space-y-3">
            <div class="h-1.5 rounded-full bg-gray-100 dark:bg-white/10"><div class="h-1.5 rounded-full bg-brand-500" style="width:30%"></div></div>
            <div class="h-2.5 rounded-full bg-gray-100 dark:bg-white/10"><div class="h-2.5 rounded-full bg-brand-500" style="width:55%"></div></div>
            <div class="h-4 rounded-full bg-gray-100 dark:bg-white/10"><div class="h-4 rounded-full bg-brand-500" style="width:80%"></div></div>
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">環形與堆疊</h3>
        <div class="mt-5 flex flex-wrap items-center justify-center gap-8">
            @foreach (var item in new[] { new { Label = "完成度", Percent = 75, Color = "#465fff" }, new { Label = "使用率", Percent = 48, Color = "#12b76a" }, new { Label = "風險", Percent = 92, Color = "#f04438" } })
            {
                <div class="text-center">
                    <svg viewBox="0 0 100 100" class="size-24">
                        <circle cx="50" cy="50" r="40" fill="none" stroke="currentColor" stroke-width="8" class="text-gray-100 dark:text-white/10"></circle>
                        <circle cx="50" cy="50" r="40" fill="none" stroke="@item.Color" stroke-width="8" stroke-linecap="round"
                                stroke-dasharray="@(item.Percent * 2.512) 251.2" transform="rotate(-90 50 50)"></circle>
                        <text x="50" y="55" text-anchor="middle" class="fill-gray-800 text-[16px] font-semibold dark:fill-white">@item.Percent%</text>
                    </svg>
                    <p class="mt-2 text-theme-xs text-gray-500 dark:text-gray-400">@item.Label</p>
                </div>
            }
        </div>
        <h4 class="mt-6 text-sm font-medium text-gray-700 dark:text-gray-300">堆疊進度</h4>
        <div class="mt-3 flex h-3 overflow-hidden rounded-full bg-gray-100 dark:bg-white/10">
            <div class="h-3 bg-brand-500" style="width:46%"></div>
            <div class="h-3 bg-green-500" style="width:28%"></div>
            <div class="h-3 bg-amber-500" style="width:16%"></div>
            <div class="h-3 bg-red-500" style="width:10%"></div>
        </div>
        <div class="mt-3 flex flex-wrap gap-4 text-theme-xs text-gray-500 dark:text-gray-400">
            <span class="flex items-center gap-1.5"><span class="size-2 rounded-full bg-brand-500"></span>商品 46%</span>
            <span class="flex items-center gap-1.5"><span class="size-2 rounded-full bg-green-500"></span>物流 28%</span>
            <span class="flex items-center gap-1.5"><span class="size-2 rounded-full bg-amber-500"></span>客服 16%</span>
            <span class="flex items-center gap-1.5"><span class="size-2 rounded-full bg-red-500"></span>其他 10%</span>
        </div>
    </section>
</div>
