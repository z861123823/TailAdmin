<div class="grid grid-cols-1 gap-4 md:gap-6 xl:grid-cols-2">
    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">圓環</h3>
        <div class="mt-6 flex flex-wrap items-end justify-center gap-8">
            <span class="size-5 animate-spin rounded-full border-2 border-brand-500 border-t-transparent"></span>
            <span class="size-8 animate-spin rounded-full border-[3px] border-brand-500 border-t-transparent"></span>
            <span class="size-11 animate-spin rounded-full border-4 border-gray-200 border-t-brand-500 dark:border-gray-700 dark:border-t-brand-500"></span>
            <span class="size-10 animate-spin rounded-full border-4 border-green-500/30 border-t-green-500"></span>
        </div>
        <h4 class="mt-7 text-sm font-medium text-gray-700 dark:text-gray-300">點狀</h4>
        <div class="mt-4 flex justify-center gap-2">
            <span class="size-2.5 animate-bounce rounded-full bg-brand-500"></span>
            <span class="size-2.5 animate-bounce rounded-full bg-brand-500 [animation-delay:120ms]"></span>
            <span class="size-2.5 animate-bounce rounded-full bg-brand-500 [animation-delay:240ms]"></span>
        </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">條狀與按鈕</h3>
        <div class="mt-5 space-y-4">
            <div class="h-1.5 overflow-hidden rounded-full bg-gray-100 dark:bg-white/10">
                <div class="h-1.5 w-1/2 animate-pulse rounded-full bg-brand-500"></div>
            </div>
            <div class="h-2.5 overflow-hidden rounded-full bg-gray-100 dark:bg-white/10">
                <div class="h-2.5 w-2/3 animate-pulse rounded-full bg-green-500"></div>
            </div>
            <div class="h-3.5 overflow-hidden rounded-full bg-gray-100 dark:bg-white/10">
                <div class="h-3.5 w-1/3 animate-pulse rounded-full bg-amber-500"></div>
            </div>
        </div>
        <div class="mt-6 flex flex-wrap gap-3">
            <button type="button" class="inline-flex cursor-wait items-center gap-2 rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white opacity-90" disabled>
                <span class="size-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span>
                保存中…
            </button>
            <button type="button" class="inline-flex cursor-wait items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-theme-sm font-medium text-gray-700 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400" disabled>
                <span class="size-4 animate-spin rounded-full border-2 border-gray-300 border-t-gray-600 dark:border-gray-600 dark:border-t-gray-300"></span>
                載入中…
            </button>
        </div>
        <div class="mt-6 space-y-2 rounded-xl border border-gray-100 p-4 dark:border-gray-800">
            <div class="h-3 w-1/3 animate-pulse rounded bg-gray-100 dark:bg-white/10"></div>
            <div class="h-3 w-full animate-pulse rounded bg-gray-100 dark:bg-white/10"></div>
            <div class="h-3 w-4/5 animate-pulse rounded bg-gray-100 dark:bg-white/10"></div>
        </div>
    </section>
</div>
