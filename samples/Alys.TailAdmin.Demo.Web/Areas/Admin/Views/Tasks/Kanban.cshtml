@{
    var columns = new[]
    {
        new
        {
            Title = "待處理", Tone = "bg-gray-400", Count = 3,
            Tasks = new[]
            {
                new { Title = "整理雙十一活動素材清單", Desc = "核對主視覺、商品長圖與短視頻", Priority = "高", Due = "11-25", Initials = "林" },
                new { Title = "更新供應商聯絡資料", Desc = "補全 12 家供應商的帳期資訊", Priority = "中", Due = "11-27", Initials = "陳" },
                new { Title = "整理客服常見問題", Desc = "沉澱本週新出現的 5 個問題", Priority = "低", Due = "11-30", Initials = "王" }
            }
        },
        new
        {
            Title = "進行中", Tone = "bg-brand-500", Count = 2,
            Tasks = new[]
            {
                new { Title = "開發庫存預警報表", Desc = "按分類與門店維度匯總", Priority = "高", Due = "11-26", Initials = "陳" },
                new { Title = "優化商品詳情頁轉化", Desc = "A/B 測試第二輪", Priority = "中", Due = "11-28", Initials = "李" }
            }
        },
        new
        {
            Title = "已完成", Tone = "bg-green-500", Count = 2,
            Tasks = new[]
            {
                new { Title = "上線會員積分規則", Desc = "已完成全量發佈與公告", Priority = "中", Due = "11-20", Initials = "林" },
                new { Title = "修復訂單狀態同步", Desc = "補償任務已跑完", Priority = "高", Due = "11-19", Initials = "王" }
            }
        }
    };
}
<div class="flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-2">
        <button type="button" class="rounded-lg bg-brand-50 px-3 py-2 text-theme-sm font-medium text-brand-600 dark:bg-brand-500/15 dark:text-brand-400">看板</button>
        <button type="button" class="rounded-lg px-3 py-2 text-theme-sm font-medium text-gray-500 transition-colors hover:bg-gray-50 dark:text-gray-400 dark:hover:bg-white/5">列表</button>
    </div>
    <button type="button" class="inline-flex items-center gap-2 rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white shadow-theme-xs transition-colors hover:bg-brand-600"
            onclick="Ta.toast.info('新增任務（演示）')">
        <partial name="_Icon" model="@("plus")" />
        新增任務
    </button>
</div>

<div class="mt-4 grid grid-cols-1 gap-4 md:mt-6 md:gap-6 xl:grid-cols-3">
    @foreach (var column in columns)
    {
        <section class="rounded-2xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-white/[0.03]">
            <div class="flex items-center justify-between px-1">
                <div class="flex items-center gap-2">
                    <span class="size-2 rounded-full @column.Tone"></span>
                    <h3 class="text-theme-sm font-semibold text-gray-800 dark:text-white/90">@column.Title</h3>
                    <span class="rounded-full bg-gray-100 px-2 py-0.5 text-theme-xs font-medium text-gray-600 dark:bg-white/10 dark:text-gray-400">@column.Count</span>
                </div>
                <button type="button" class="inline-flex size-8 items-center justify-center rounded-lg text-gray-400 transition-colors hover:bg-gray-100 hover:text-gray-700 dark:hover:bg-white/5 dark:hover:text-gray-300"
                        onclick="Ta.toast.info('新增任務（演示）')" aria-label="新增">
                    <partial name="_Icon" model="@("plus")" />
                </button>
            </div>

            <div class="mt-3 space-y-3">
                @foreach (var task in column.Tasks)
                {
                    var avatar = new TaAvatarModel { Initials = task.Initials, Size = "xs" };
                    var priority = task.Priority switch
                    {
                        "高" => new TaBadgeModel { Text = "高", Variant = "danger" },
                        "中" => new TaBadgeModel { Text = "中", Variant = "warning" },
                        _ => new TaBadgeModel { Text = "低", Variant = "light" }
                    };
                    <article class="rounded-xl border border-gray-200 p-4 transition-shadow hover:shadow-theme-sm dark:border-gray-800">
                        <div class="flex items-start justify-between gap-2">
                            <h4 class="text-theme-sm font-medium text-gray-800 dark:text-white/90">@task.Title</h4>
                            <partial name="_TaBadge" model="priority" />
                        </div>
                        <p class="mt-1.5 text-theme-xs leading-5 text-gray-500 dark:text-gray-400">@task.Desc</p>
                        <div class="mt-3 flex items-center justify-between">
                            <span class="inline-flex items-center gap-1.5 text-theme-xs text-gray-500 dark:text-gray-400">
                                <partial name="_Icon" model="@("calendar")" />
                                @task.Due
                            </span>
                            <partial name="_TaAvatar" model="avatar" />
                        </div>
                    </article>
                }
            </div>
        </section>
    }
</div>
