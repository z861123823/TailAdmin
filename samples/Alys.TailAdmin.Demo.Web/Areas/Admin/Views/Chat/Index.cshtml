@{
    var contacts = new[]
    {
        new { Name = "林經理", Initials = "林", Last = "明天的評審資料我來準備", Time = "10:32", Unread = 2, Online = true },
        new { Name = "陳小明", Initials = "陳", Last = "促銷排期已確認", Time = "09:48", Unread = 0, Online = true },
        new { Name = "王先生", Initials = "王", Last = "合約條款我再核對一下", Time = "昨天", Unread = 0, Online = false },
        new { Name = "客服小組", Initials = "客", Last = "有 3 張高優先級工單", Time = "昨天", Unread = 5, Online = false },
        new { Name = "李專員", Initials = "李", Last = "收到，謝謝！", Time = "週一", Unread = 0, Online = false }
    };
    var headerAvatar = new TaAvatarModel { Initials = "林", Size = "md", Status = "online" };
}
<div class="grid grid-cols-1 gap-4 md:gap-6 xl:grid-cols-12">
    <section class="overflow-hidden rounded-2xl border border-gray-200 bg-white xl:col-span-4 dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="border-b border-gray-100 p-4 dark:border-gray-800">
            <input type="text" placeholder="搜索聯絡人"
                   class="h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-theme-sm text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800" />
        </div>
        <ul class="divide-y divide-gray-100 dark:divide-gray-800">
            @for (var index = 0; index < contacts.Length; index++)
            {
                var contact = contacts[index];
                var avatar = new TaAvatarModel { Initials = contact.Initials, Size = "md", Status = contact.Online ? "online" : "offline" };
                <li>
                    <button type="button" class="flex w-full items-center gap-3 px-4 py-3.5 text-left transition-colors hover:bg-gray-50 @(index == 0 ? "bg-brand-50/60 dark:bg-brand-500/5" : null) dark:hover:bg-white/[0.02]">
                        <partial name="_TaAvatar" model="avatar" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center justify-between gap-2">
                                <span class="truncate text-theme-sm font-medium text-gray-800 dark:text-white/90">@contact.Name</span>
                                <span class="shrink-0 text-theme-xs text-gray-400 dark:text-gray-500">@contact.Time</span>
                            </div>
                            <p class="mt-0.5 truncate text-theme-xs text-gray-500 dark:text-gray-400">@contact.Last</p>
                        </div>
                        @if (contact.Unread > 0)
                        {
                            <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-brand-500 text-[10px] font-semibold text-white">@contact.Unread</span>
                        }
                    </button>
                </li>
            }
        </ul>
    </section>

    <section class="flex min-h-125 flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white xl:col-span-8 dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="flex items-center justify-between gap-3 border-b border-gray-100 px-5 py-4 dark:border-gray-800">
            <div class="flex items-center gap-3">
                <partial name="_TaAvatar" model="headerAvatar" />
                <div>
                    <p class="text-theme-sm font-semibold text-gray-800 dark:text-white/90">林經理</p>
                    <p class="text-theme-xs text-green-600 dark:text-green-400">在線</p>
                </div>
            </div>
            <button type="button" class="inline-flex size-9 items-center justify-center rounded-lg text-gray-400 transition-colors hover:bg-gray-100 hover:text-gray-700 dark:hover:bg-white/5 dark:hover:text-gray-300"
                    onclick="Ta.toast.info('通話（演示）')" aria-label="通話">
                <partial name="_Icon" model="@("bell")" />
            </button>
        </div>

        <div class="flex-1 space-y-4 overflow-y-auto px-5 py-5 custom-scrollbar">
            <div class="flex justify-start">
                <div class="max-w-[78%] rounded-2xl rounded-tl-md bg-gray-100 px-4 py-2.5 text-theme-sm text-gray-700 dark:bg-white/5 dark:text-gray-300">
                    明天的評審資料準備得怎麼樣了？
                    <span class="mt-1 block text-[10px] text-gray-400">10:20</span>
                </div>
            </div>
            <div class="flex justify-end">
                <div class="max-w-[78%] rounded-2xl rounded-tr-md bg-brand-500 px-4 py-2.5 text-theme-sm text-white">
                    數據部分已完成，還差競品分析。
                    <span class="mt-1 block text-[10px] text-white/70">10:26</span>
                </div>
            </div>
            <div class="flex justify-start">
                <div class="max-w-[78%] rounded-2xl rounded-tl-md bg-gray-100 px-4 py-2.5 text-theme-sm text-gray-700 dark:bg-white/5 dark:text-gray-300">
                    好的，我來補充競品部分，下午 3 點前發你。
                    <span class="mt-1 block text-[10px] text-gray-400">10:32</span>
                </div>
            </div>
            <div class="flex justify-end">
                <div class="max-w-[78%] rounded-2xl rounded-tr-md bg-brand-500 px-4 py-2.5 text-theme-sm text-white">
                    收到，辛苦！
                    <span class="mt-1 block text-[10px] text-white/70">10:33</span>
                </div>
            </div>
        </div>

        <div class="border-t border-gray-100 p-4 dark:border-gray-800">
            <div class="flex items-center gap-3">
                <input type="text" placeholder="輸入訊息…"
                       class="h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-theme-sm text-gray-800 shadow-theme-xs transition-colors placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800" />
                <button type="button" class="inline-flex size-11 shrink-0 items-center justify-center rounded-lg bg-brand-500 text-white shadow-theme-xs transition-colors hover:bg-brand-600"
                        onclick="Ta.toast.success('訊息已發送（演示）')" aria-label="發送">
                    <partial name="_Icon" model="@("chevron-right")" />
                </button>
            </div>
        </div>
    </section>
</div>
