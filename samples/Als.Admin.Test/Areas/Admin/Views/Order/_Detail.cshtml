@model OrderDetailModel
@{
    var order = Model.Order;
    var canRefund = order.PayStatus == 1 && order.PayType != 1;
    var orderNo = order.CartOrders?.Replace("'", "\\'") ?? string.Empty;
}
<div class="space-y-4 text-theme-sm">
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <div><span class="text-gray-500 dark:text-gray-400">訂單號：</span><span class="text-gray-800 dark:text-white/90">@order.CartOrders</span></div>
        <div><span class="text-gray-500 dark:text-gray-400">支付單號：</span><span class="text-gray-800 dark:text-white/90">@order.PayId</span></div>
        <div><span class="text-gray-500 dark:text-gray-400">下單時間：</span><span class="text-gray-800 dark:text-white/90">@order.BuyTimes</span></div>
        <div><span class="text-gray-500 dark:text-gray-400">付款狀態：</span><span class="text-gray-800 dark:text-white/90">@order.PayText</span></div>
        <div><span class="text-gray-500 dark:text-gray-400">購買者：</span><span class="text-gray-800 dark:text-white/90">@order.BuyerName</span></div>
        <div><span class="text-gray-500 dark:text-gray-400">聯絡電話：</span><span class="text-gray-800 dark:text-white/90">@order.BuyerPhone</span></div>
        <div class="sm:col-span-2"><span class="text-gray-500 dark:text-gray-400">收貨地址：</span><span class="text-gray-800 dark:text-white/90">@order.ReceiveAddress</span></div>
        <div><span class="text-gray-500 dark:text-gray-400">總金額：</span><span class="font-semibold text-gray-900 dark:text-white/90">@order.TotalText</span></div>
        <div><span class="text-gray-500 dark:text-gray-400">發貨狀態：</span><span class="text-gray-800 dark:text-white/90">@order.ShipmentState</span></div>
        <div><span class="text-gray-500 dark:text-gray-400">物流公司：</span><span class="text-gray-800 dark:text-white/90">@order.Logistic</span></div>
        <div><span class="text-gray-500 dark:text-gray-400">貨運單號：</span><span class="text-gray-800 dark:text-white/90">@order.LogisticsId</span></div>
        <div class="sm:col-span-2"><span class="text-gray-500 dark:text-gray-400">備註：</span><span class="text-gray-800 dark:text-white/90">@order.Remark</span></div>
    </div>

    <div class="rounded-xl border border-gray-200 dark:border-gray-800">
        <div class="border-b border-gray-100 px-4 py-3 text-theme-sm font-medium text-gray-800 dark:border-gray-800 dark:text-white/90">訂單商品</div>
        <div class="max-h-72 space-y-3 overflow-y-auto p-4">
            @if (Model.Goods.Count == 0)
            {
                <p class="text-gray-500 dark:text-gray-400">該訂單沒有商品明細</p>
            }
            @foreach (var item in Model.Goods)
            {
                <div class="flex items-center gap-3 rounded-lg border border-gray-100 p-2 dark:border-gray-800">
                    @if (!string.IsNullOrWhiteSpace(item.PicUrl))
                    {
                        <img src="@item.PicUrl" alt="@item.GoodsName" class="size-12 rounded-lg border border-gray-100 object-cover dark:border-gray-800" />
                    }
                    else
                    {
                        <span class="flex size-12 items-center justify-center rounded-lg bg-gray-100 text-theme-xs text-gray-400 dark:bg-white/5">無圖</span>
                    }
                    <div class="min-w-0 flex-1">
                        <p class="truncate text-theme-sm font-medium text-gray-800 dark:text-white/90">@item.GoodsName</p>
                        <p class="text-theme-xs text-gray-500 dark:text-gray-400">單價 @item.Price × @item.BuyQty</p>
                    </div>
                    <span class="text-theme-sm font-semibold text-gray-900 dark:text-white/90">@item.Total</span>
                </div>
            }
        </div>
    </div>

    <div class="flex flex-wrap justify-end gap-3">
        @if (canRefund)
        {
            <button type="button"
                    class="inline-flex items-center justify-center rounded-lg bg-red-500 px-4 py-2.5 text-theme-sm font-medium text-white shadow-theme-xs transition-colors hover:bg-red-600"
                    onclick="window.refundOrder('@orderNo')">退款</button>
        }
        <button type="button"
                class="inline-flex items-center justify-center rounded-lg border border-red-300 bg-white px-4 py-2.5 text-theme-sm font-medium text-red-600 shadow-theme-xs transition-colors hover:bg-red-50 dark:border-red-500/30 dark:bg-gray-800 dark:text-red-400 dark:hover:bg-red-500/10"
                onclick="window.deleteOrder(@order.Id)">刪除訂單</button>
    </div>
</div>
