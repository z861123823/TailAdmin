@model OrderListPageModel
@{
    var detailUrl = Url.Action("Detail", "Order", new { area = "Admin" }) ?? string.Empty;
    var editUrl = Url.Action("EditForm", "Order", new { area = "Admin" }) ?? string.Empty;

    var onAction = string.Join("\n", new[]
    {
        "view: function (row) { Ta.modal.load('orderView', '" + detailUrl + "', { id: row.Id }); },",
        "edit: function (row) { Ta.modal.load('orderEdit', '" + editUrl + "', { id: row.Id }); }"
    });

    var table = new TaTableModel
    {
        Id = "orderTable",
        Url = Url.Action("List", "Order", new { area = "Admin" }) ?? string.Empty,
        RowKey = "Id",
        PageSize = 15,
        EmptyText = "暫無訂單",
        ReloadOn = new List<string> { "orderEdit" },
        FixedActions = true,
        StickyHeader = true,
        ScrollHeight = "540px",
        OnAction = onAction,
        Columns = new List<TaColumnModel>
        {
            new() { Key = "Id", Label = "ID", Width = 64, Sortable = false, Fixed = "left" },
            new() { Key = "CartOrders", Label = "訂單號", Width = 200, Sortable = false, Fixed = "left" },
            new() { Key = "PayId", Label = "支付單號", Width = 200, Sortable = false },
            new() { Key = "BuyTimes", Label = "下單時間", Width = 170, Sortable = false },
            new() { Key = "BuyerName", Label = "購買者", Width = 110, Sortable = false },
            new() { Key = "BuyerPhone", Label = "聯絡電話", Width = 130, Sortable = false },
            new() { Key = "Total", Label = "總金額", Type = "number", Align = "right", Sortable = false },
            new() { Key = "ShipmentState", Label = "發貨狀態", Width = 100, Sortable = false },
            new() { Key = "PayStatusText", Label = "付款狀態", Width = 100, Sortable = false }
        },
        Actions = new List<TaActionModel>
        {
            new() { Label = "查看", Event = "view", Variant = "primary" },
            new() { Label = "編輯", Event = "edit" }
        }
    };
}
<div class="mb-4 rounded-2xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-white/[0.03]">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-theme-sm text-gray-500 dark:text-gray-400">已支付金額（@Model.Currency）：</p>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-theme-sm text-gray-700 dark:text-gray-300">
            <span>今天 <strong class="text-gray-900 dark:text-white/90" id="payToday">@Model.Today</strong></span>
            <span>昨天 <strong class="text-gray-900 dark:text-white/90" id="payYesterday">@Model.Yesterday</strong></span>
            <span>本月 <strong class="text-gray-900 dark:text-white/90" id="payMonth">@Model.Month</strong></span>
            <span>上月 <strong class="text-gray-900 dark:text-white/90" id="payLastMonth">@Model.LastMonth</strong></span>
            <span>今年 <strong class="text-gray-900 dark:text-white/90" id="payYear">@Model.Year</strong></span>
            <button type="button" id="btnRefreshOrder"
                    class="inline-flex items-center justify-center gap-2 rounded-lg border border-gray-300 bg-white px-3 py-2 text-theme-xs font-medium text-gray-700 shadow-theme-xs transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-white/5">
                <partial name="_Icon" model="@("refresh")" />
                重新整理
            </button>
        </div>
    </div>
</div>

<partial name="_TaTable" model="table" />

<dialog id="orderView" class="ta-dialog"
        x-data="taModal({ id: 'orderView', title: '訂單詳情', size: 'lg', destroyOnClose: true })">
    <div class="ta-dialog-card" x-bind:class="boxClass">
        <div class="flex items-start justify-between gap-4">
            <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90" x-text="title"></h3>
            <button type="button"
                    class="inline-flex size-9 items-center justify-center rounded-lg text-gray-400 transition-colors hover:bg-gray-100 hover:text-gray-700 dark:hover:bg-white/5 dark:hover:text-gray-300"
                    data-dialog-close aria-label="關閉">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 6L6 18M6 6l12 12" />
                </svg>
            </button>
        </div>
        <div x-ref="body" class="mt-4"></div>
        <div class="mt-6 flex justify-end">
            <button type="button"
                    class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-theme-sm font-medium text-gray-700 shadow-theme-xs transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-white/5"
                    data-dialog-close>關閉</button>
        </div>
    </div>
</dialog>

<dialog id="orderEdit" class="ta-dialog"
        x-data="taModal({ id: 'orderEdit', title: '編輯發貨資訊', size: 'lg', destroyOnClose: true })">
    <div class="ta-dialog-card" x-bind:class="boxClass">
        <div class="flex items-start justify-between gap-4">
            <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90" x-text="title"></h3>
            <button type="button"
                    class="inline-flex size-9 items-center justify-center rounded-lg text-gray-400 transition-colors hover:bg-gray-100 hover:text-gray-700 dark:hover:bg-white/5 dark:hover:text-gray-300"
                    data-dialog-close aria-label="關閉">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 6L6 18M6 6l12 12" />
                </svg>
            </button>
        </div>
        <div x-ref="body" class="mt-4"></div>
        <div class="mt-6 flex flex-col-reverse justify-end gap-3 sm:flex-row">
            <button type="button"
                    class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-theme-sm font-medium text-gray-700 shadow-theme-xs transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-white/5"
                    data-dialog-close>取消</button>
            <button type="button"
                    class="inline-flex items-center justify-center rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white shadow-theme-xs transition-colors hover:bg-brand-600 disabled:cursor-not-allowed disabled:opacity-60"
                    x-bind:disabled="submitting" x-on:click="submit()">保存</button>
        </div>
    </div>
</dialog>

<script>
    (function () {
        var payTotalUrl = '@Url.Action("PayTotal", "Order", new { area = "Admin" })';
        var refundUrl = '@Url.Action("Refund", "Order", new { area = "Admin" })';
        var deleteUrl = '@Url.Action("Delete", "Order", new { area = "Admin" })';

        window.reloadOrderSummary = async function () {
            try {
                var res = await Ta.http.get(payTotalUrl, {}, { silent: true });
                if (!res) return;
                var set = function (id, value) { var el = document.getElementById(id); if (el) el.textContent = value || '0.00'; };
                set('payToday', Ta.value(res, 'Today'));
                set('payYesterday', Ta.value(res, 'Yesterday'));
                set('payMonth', Ta.value(res, 'Month'));
                set('payLastMonth', Ta.value(res, 'LastMonth'));
                set('payYear', Ta.value(res, 'Year'));
            } catch (e) { }
        };

        window.refundOrder = function (orderNo) {
            if (!orderNo) return;
            Ta.confirm({ title: '退款確認', text: '確定為訂單 ' + orderNo + ' 發起退款？此操作會真實出賬。', confirmText: '退款', danger: true }).then(function (ok) {
                if (!ok) return;
                Ta.http.postForm(refundUrl, { id: orderNo }).then(function (res) {
                    if (Ta.isOk(res)) {
                        Ta.toast.success(Ta.value(res, 'Message') || '退款已提交');
                        Ta.modal.close('orderView');
                        var t = Ta.tables['orderTable'];
                        if (t) t.refresh();
                        window.reloadOrderSummary();
                    } else {
                        Ta.toast.error(Ta.value(res, 'Message') || '退款失敗');
                    }
                });
            });
        };

        window.deleteOrder = function (id) {
            Ta.confirm({ title: '刪除確認', text: '確定刪除訂單 ' + id + '？', confirmText: '刪除', danger: true }).then(function (ok) {
                if (!ok) return;
                Ta.http.postForm(deleteUrl, { id: id }).then(function (res) {
                    if (Ta.isOk(res)) {
                        Ta.toast.success(Ta.value(res, 'Message') || '刪除成功');
                        Ta.modal.close('orderView');
                        var t = Ta.tables['orderTable'];
                        if (t) t.refresh();
                        window.reloadOrderSummary();
                    } else {
                        Ta.toast.error(Ta.value(res, 'Message') || '刪除失敗');
                    }
                });
            });
        };

        document.addEventListener('DOMContentLoaded', function () {
            var button = document.getElementById('btnRefreshOrder');
            if (button) {
                button.addEventListener('click', function () {
                    var t = Ta.tables['orderTable'];
                    if (t) t.reload();
                    window.reloadOrderSummary();
                });
            }
        });
    })();
</script>
