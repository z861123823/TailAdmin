@model SlideFormModel
<form method="post" action="@Url.Action("Save", "Slides", new { area = "Admin" })"
      x-on:submit.prevent="Ta.modal.submit('slideEdit')"
      x-data="{ preview: '@Model.PreviewUrl', name: '@Model.PicName' }">
    <input type="hidden" name="id" value="@Model.Id" />
    <input type="hidden" name="picName" x-bind:value="name" />

    <div class="mb-5">
        <span class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400">輪播圖片</span>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start">
            <template x-if="preview">
                <img x-bind:src="preview" alt="輪播圖預覽" class="h-32 w-full max-w-80 rounded-lg border border-gray-200 object-cover dark:border-gray-800" />
            </template>
            <template x-if="!preview">
                <span class="flex h-32 w-64 items-center justify-center rounded-lg bg-gray-100 text-theme-xs text-gray-400 dark:bg-white/5">尚未選擇圖片</span>
            </template>
            <label class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-theme-sm font-medium text-gray-700 shadow-theme-xs transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-white/5">
                <input type="file" class="hidden" accept="image/*"
                       x-on:change="(event) => {
                           const file = event.target.files && event.target.files[0];
                           if (!file) return;
                           const reader = new FileReader();
                           reader.onload = (e) => { name = e.target.result; preview = e.target.result; };
                           reader.readAsDataURL(file);
                           event.target.value = '';
                       }($event)" />
                選擇圖片
            </label>
        </div>
        <p class="mt-1 text-theme-xs text-gray-500 dark:text-gray-400">新增必須選圖；編輯未換圖時沿用原文件名。</p>
    </div>

    <div class="mb-2">
        <label class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400" for="PicUrl">跳轉地址</label>
        <input id="PicUrl" name="picUrl" value="@Model.PicUrl" autocomplete="off" placeholder="/"
               class="h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-theme-sm text-gray-800 shadow-theme-xs focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
    </div>
</form>
