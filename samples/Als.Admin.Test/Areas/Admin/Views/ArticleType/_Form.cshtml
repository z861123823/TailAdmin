@model ArticleTypeFormModel
<form method="post" action="@Url.Action("Save", "ArticleType", new { area = "Admin" })"
      x-on:submit.prevent="Ta.modal.submit('articleTypeEdit')">
    <input type="hidden" name="id" value="@Model.Id" />
    <div class="mb-2">
        <label class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400" for="TypeName">分類名稱 <span class="text-red-500">*</span></label>
        <input id="TypeName" name="typeName" value="@Model.TypeName" required maxlength="50" autocomplete="off"
               class="h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-theme-sm text-gray-800 shadow-theme-xs focus:border-brand-300 focus:ring-3 focus:ring-brand-500/20 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
    </div>
</form>
