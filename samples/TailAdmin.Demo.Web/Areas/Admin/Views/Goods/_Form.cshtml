@model GoodsEditModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    var types = ViewBag.TypeList as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var initialImages = Model.PicUrl is null ? "[]" : "['" + Model.PicUrl.Replace("'", "\\'") + "']";
    var tagValues = "[" + string.Join(",", Model.Tags.Select(tag => "'" + tag.Replace("'", "\\'") + "'")) + "]";
}

<form method="post" asp-area="Admin" asp-controller="Goods" asp-action="Save"
      x-on:submit.prevent="Ta.modal.submit('goodsEdit')">
    <input type="hidden" asp-for="Id" />

    <ta-input asp-for="GoodsName" label="商品名稱" required placeholder="例如：無線藍牙耳機" />

    <div class="grid grid-cols-1 gap-x-4 md:grid-cols-2">
        <ta-input asp-for="Price" label="價格" type="number" step="0.01" min="0" required />
        <ta-select asp-for="TypeId" label="商品分類" items="types" required />
        <ta-input asp-for="SalesVolume" label="銷量" type="number" min="0" />
        <ta-input asp-for="AddTime" label="上架日期" type="date" />
    </div>

    <div class="mb-5">
        <span class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400">標籤（最多 3 個）</span>
        <div class="relative" x-data="taMultiSelect({
                    url: '@Url.Action("TagSearch", "Goods", new { area = "Admin" })',
                    name: 'Tags',
                    value: @tagValues,
                    max: 3,
                    placeholder: '選擇標籤'
                 })"
             x-init="init()" x-on:click.outside="open = false">
            <div class="flex min-h-11 flex-wrap items-center gap-1.5 rounded-lg border border-gray-300 bg-transparent px-2 py-1.5 shadow-theme-xs transition-colors focus-within:border-brand-300 focus-within:ring-3 focus-within:ring-brand-500/20 dark:border-gray-700 dark:bg-gray-900"
                 x-on:click="$refs.kw.focus()">
                <template x-for="selectedItem in selected" :key="selectedItem.value">
                    <span class="inline-flex items-center gap-1 rounded-full bg-brand-50 px-2.5 py-0.5 text-theme-xs font-medium text-brand-600 dark:bg-brand-500/15 dark:text-brand-400">
                        <span x-text="selectedItem.label"></span>
                        <button type="button" class="text-brand-400 transition-colors hover:text-red-500 dark:text-brand-300"
                                x-on:click.stop="remove(selectedItem.value)">×</button>
                    </span>
                </template>
                <input type="text" x-ref="kw" x-model="keyword"
                       x-on:input.debounce.250ms="search()" x-on:focus="onFocus()"
                       class="min-w-24 flex-1 border-0 bg-transparent px-1 py-1 text-theme-sm text-gray-800 outline-none placeholder:text-gray-400 dark:text-white/90 dark:placeholder:text-white/30"
                       placeholder="選擇標籤" />
            </div>
            <div class="absolute z-50 mt-2 max-h-52 w-full overflow-auto rounded-xl border border-gray-200 bg-white p-1 shadow-theme-lg dark:border-gray-800 dark:bg-gray-900"
                 x-show="open" x-cloak>
                <div class="px-3 py-2 text-theme-xs text-gray-500 dark:text-gray-400" x-show="loading">搜索中…</div>
                <template x-for="option in options" :key="option.Value">
                    <button type="button"
                            class="flex w-full items-center justify-between rounded-lg px-3 py-2 text-left text-theme-sm text-gray-700 transition-colors hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5"
                            x-on:click="select(option)">
                        <span x-text="option.Label"></span>
                        <span class="text-brand-500 dark:text-brand-400" x-show="isSelected(option.Value)">✓</span>
                    </button>
                </template>
                <div class="px-3 py-2 text-theme-xs text-gray-500 dark:text-gray-400" x-show="!loading && options.length === 0">無匹配項</div>
            </div>
            <template x-for="selectedItem in selected" :key="'hidden-' + selectedItem.value">
                <input type="hidden" name="Tags" x-bind:value="selectedItem.value" />
            </template>
        </div>
        <span class="ta-field-hint">輸入關鍵字遠程搜索，支持多選</span>
    </div>

    <div class="mb-5">
        <span class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400">商品圖片</span>
        <div x-data="taUploader({
                    url: '@Url.Action("UploadImage", "Goods", new { area = "Admin" })',
                    hiddenName: 'PicUrl',
                    accept: 'image/png,image/jpeg,image/webp',
                    maxSize: 2097152,
                    max: 1
                 })"
             x-init="init(@initialImages)">
            <input type="file" class="hidden" x-ref="file" x-on:change="onChange($event)" accept="image/png,image/jpeg,image/webp" />
            <div class="flex flex-wrap items-center gap-3">
                <button type="button"
                        class="inline-flex items-center justify-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-theme-sm font-medium text-gray-700 shadow-theme-xs transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-white/5"
                        x-on:click="choose()">
                    <partial name="_Icon" model="@("upload")" />
                    上傳圖片
                </button>
                <span class="text-theme-xs text-gray-500 dark:text-gray-400" x-show="uploading">上傳中…</span>
            </div>
            <p class="ta-field-error" x-text="error"></p>
            <div class="mt-3 flex flex-wrap gap-3">
                <template x-for="item in items" :key="item.uid">
                    <div class="relative">
                        <img x-show="preview && item.url" x-bind:src="item.url"
                             class="size-16 rounded-lg border border-gray-200 object-cover dark:border-gray-800" alt="" />
                        <button type="button"
                                class="absolute -top-1.5 -right-1.5 flex size-6 items-center justify-center rounded-full bg-red-500 text-xs text-white shadow-theme-xs transition-colors hover:bg-red-600"
                                x-on:click="remove(item.uid)">×</button>
                        <div class="mt-1 h-1.5 w-16 overflow-hidden rounded-full bg-gray-200 dark:bg-gray-700"
                             x-show="item.status === 'uploading'">
                            <div class="h-full rounded-full bg-brand-500 transition-all"
                                 x-bind:style="'width:' + (item.progress || 0) + '%'"></div>
                        </div>
                    </div>
                </template>
            </div>
            <template x-for="item in items" :key="'hidden-' + item.uid">
                <input type="hidden" x-bind:name="hiddenName" x-bind:value="item.url" />
            </template>
        </div>
        <span class="ta-field-hint">支援 png / jpeg / webp，單圖不超過 2MB</span>
    </div>

    <ta-toggle asp-for="IsHot" label="熱銷" hint="開啟後在列表中標記為熱銷" />
    <ta-textarea asp-for="Remark" label="備註" rows="3" placeholder="選填" />
</form>
