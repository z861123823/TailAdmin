@{
    Layout = "~/Views/Shared/_TailAdminAuthLayout.cshtml";
    var error = ViewData["Error"] as string;
    var returnUrl = ViewData["ReturnUrl"] as string;
    var userName = ViewData["UserName"] as string;
}
<div class="ta-auth-card">
    <div class="mb-6 flex items-center gap-3">
        <span class="ta-logo-mark">商</span>
        <div>
            <h1 class="text-lg font-semibold">商城運營後台</h1>
            <p class="text-xs text-base-content/60">TailAdmin 通用模板演示</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-error mb-4 text-sm">@error</div>
    }

    <form method="post" asp-area="Admin" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" class="space-y-3">
        @Html.AntiForgeryToken()
        <label class="form-control w-full">
            <span class="label py-1"><span class="label-text text-sm font-medium">帳號</span></span>
            <input type="text" name="userName" value="@userName" class="input input-bordered input-sm w-full" autocomplete="username" required autofocus />
        </label>
        <label class="form-control w-full">
            <span class="label py-1"><span class="label-text text-sm font-medium">密碼</span></span>
            <input type="password" name="password" class="input input-bordered input-sm w-full" autocomplete="current-password" required />
        </label>
        <button type="submit" class="btn btn-primary btn-sm mt-2 w-full">登入</button>
    </form>

    <div class="mt-5 rounded-box bg-base-200 p-3 text-xs leading-relaxed text-base-content/70">
        <p class="mb-1 font-medium text-base-content/80">演示帳號</p>
        <p>admin / 123456（全部菜單）</p>
        <p>operator / 123456（僅儀表盤與商品管理）</p>
    </div>
</div>
